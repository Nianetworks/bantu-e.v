{
  "name": "bantu-ev-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website of Bantu e.V. (Berlin) – static Astro site deployed with GitHub Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-base-path.mjs",
