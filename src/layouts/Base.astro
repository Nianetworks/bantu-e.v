---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import A11yPanel from '../components/A11yPanel.astro';
import { href, languages, r, ui, type Lang } from '../i18n';
import { alternatesFor } from '../lib/alternates';
import { org } from '../data/site';
import { organisationGraph } from '../lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** URL of the same page in the other language (already base-prefixed) */
  altHref?: string;
  image?: string;
  noindex?: boolean;
  /** Extra Schema.org nodes for this page (e.g. events), added to the site-wide JSON-LD graph. */
  schema?: Record<string, unknown>[];
}
const { lang, title, description, altHref, image, noindex, schema = [] } = Astro.props;
const t = ui[lang];
const fullTitle = title === org.shortName ? `${org.shortName} | ${org.tagline[lang]}` : `${title} | ${org.shortName}`;
const desc = description ?? t.footerAbout;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href(image ?? '/brand/og-default.jpg'), Astro.site);
// Same page in the other languages (computed centrally; altHref is only a fallback for the other of DE/EN).
const alts = await alternatesFor(Astro.url.pathname);
if (altHref && lang !== 'fr') alts[lang === 'de' ? 'en' : 'de'] ??= altHref;
const hreflangs = languages.filter((l) => alts[l]).map((l) => ({ l, url: new URL(alts[l]!, Astro.site) }));
const switchLinks = languages.map((l) => ({ lang: l, href: l === lang ? Astro.url.pathname : alts[l] ?? r('home', l), exact: !!alts[l] }));
// One JSON-LD graph per page: organisation + website (always) and page-specific nodes (events, …).
const jsonLd = { '@context': 'https://schema.org', '@graph': [...organisationGraph(lang, Astro.site), ...schema] };
// "</" inside JSON must not end the script element.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Applied before first paint so saved accessibility settings never "flash".
const prefsScript = `try{var p=JSON.parse(localStorage.getItem('bantu-a11y')||'{}'),h=document.documentElement;['text','theme','font','spacing','links','motion'].forEach(function(k){var v=p[k];if(v&&!(k==='text'&&v==='md')&&!(k==='theme'&&v==='light'))h.setAttribute('data-'+k,v)})}catch(e){}`;
// External links: open in new tab and tell screen-reader users.
const extScript = `document.querySelectorAll('main a[href^="http"]').forEach(function(a){if(a.host!==location.host){a.target='_blank';a.rel='noopener';if(!a.querySelector('.sr-only')){var s=document.createElement('span');s.className='sr-only';s.textContent=' ${t.newWindow}';a.appendChild(s)}}})`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={prefsScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {hreflangs.length > 1 && hreflangs.map((h) => <link rel="alternate" hreflang={h.l} href={h.url} />)}
    {hreflangs.length > 1 && alts.de && <link rel="alternate" hreflang="x-default" href={new URL(alts.de, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.shortName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14231c" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <slot name="head" />
    <script type="application/ld+json" set:html={jsonLdText} />
  </head>
  <body>
    <nav class="skip-links" aria-label={lang === 'de' ? 'Sprunglinks' : lang === 'fr' ? 'Liens d’accès rapide' : 'Skip links'}>
      <a href="#main">{t.skip}</a>
      <a href="#main-nav">{t.skipNav}</a>
      <a href="#footer">{t.skipFooter}</a>
    </nav>
    <AnnouncementBar lang={lang} />
    <Header lang={lang} switchLinks={switchLinks} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <A11yPanel lang={lang} />
    <script is:inline set:html={extScript} />
  </body>
</html>
