  <section class="section section--alt" id="formular" aria-labelledby="sform-h">
    <div class="wrap">
      <div class="sform panel" data-sform data-net-error={s.netError} data-sending={s.sending}>
        <form method="post" action={href('/mitmachen/patenschaft.php')} data-sform-form>
          <h2 id="sform-h">{s.formH}</h2>
          <p>{s.formP}</p>
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="dwell" value="" />
          <div class="sform__hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

          <fieldset class="sform__field">
            <legend>{s.amount} <span class="req">({s.req})</span></legend>
            <div class="sform__choices">
              {tiers.map((t, i) => <label class="choice"><input type="radio" name="amount" value={t.v} required checked={i === 0} /><span>{t.l}</span></label>)}
              <label class="choice"><input type="radio" name="amount" value="other" data-amount-other /><span>{s.other}</span></label>
            </div>
            <div class="sform__sub" data-other-wrap>
              <label for="sform-other">{s.otherLabel}</label>
              <input id="sform-other" name="amount_other" type="number" inputmode="decimal" min="5" max="10000" step="0.01" />
            </div>
          </fieldset>

          <fieldset class="sform__field">
            <legend>{s.freq} <span class="req">({s.req})</span></legend>
            <div class="sform__choices sform__choices--row">
              {frequencies.map((f, i) => <label class="choice"><input type="radio" name="frequency" value={f.v} required checked={i === 0} /><span>{f.l}</span></label>)}
            </div>
            <p class="sform__hint">{s.example}</p>
          </fieldset>

          <fieldset class="sform__field">
            <legend>{s.stage} <span class="req">({s.req})</span></legend>
            <p class="sform__hint" id="sform-stage-hint">{s.stageNote}</p>
            <div class="sform__choices" aria-describedby="sform-stage-hint">
              {formStages.map((st, i) => <label class="choice"><input type="radio" name="stage" value={st.v} required checked={i === 0} /><span>{st.l}</span></label>)}
            </div>
          </fieldset>

          <fieldset class="sform__field">
            <legend>{s.prio}</legend>
            <p class="sform__hint">{s.prioNote}</p>
            <div class="sform__choices">
              {formPriorities.map((p) => <label class="choice"><input type="checkbox" name={`priority_${p.v}`} value="1" /><span>{p.l}</span></label>)}
            </div>
          </fieldset>

          <fieldset class="sform__field">
            <legend>{s.contact}</legend>
            <div class="sform__grid">
              <div><label for="sform-name">{s.name} <span class="req">({s.req})</span></label><input id="sform-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" /></div>
              <div><label for="sform-org">{s.orgL}</label><input id="sform-org" name="organisation" type="text" autocomplete="organization" maxlength="120" /></div>
              <div><label for="sform-email">{s.email} <span class="req">({s.req})</span></label><input id="sform-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="sform-email-hint" /><p class="sform__hint" id="sform-email-hint">{s.emailHint}</p></div>
              <div><label for="sform-phone">{s.phone}</label><input id="sform-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
            </div>
            <div class="sform__check">
              <input id="sform-receipt" name="receipt" type="checkbox" value="1" data-receipt />
              <label for="sform-receipt">{s.receipt}</label>
