            <div class="sform__sub" data-address-wrap>
              <label for="sform-address">{s.address}</label>
              <textarea id="sform-address" name="address" rows="3" maxlength="500" autocomplete="street-address" aria-describedby="sform-address-hint"></textarea>
              <p class="sform__hint" id="sform-address-hint">{s.addressHint}</p>
            </div>
          </fieldset>

          <fieldset class="sform__field">
            <legend>{s.method} <span class="req">({s.req})</span></legend>
            <div class="sform__choices sform__choices--row">
              {methods.map((m, i) => <label class="choice"><input type="radio" name="method" value={m.v} required checked={i === 0} /><span>{m.l}</span></label>)}
            </div>
            <p class="sform__hint">{s.methodNote}</p>
          </fieldset>

          <div class="sform__field">
            <label for="sform-message">{s.message}</label>
            <textarea id="sform-message" name="message" rows="3" maxlength="1500"></textarea>
          </div>

          <div class="sform__check">
            <input id="sform-updates" name="updates" type="checkbox" value="1" />
            <label for="sform-updates">{s.updates}</label>
          </div>
          <div class="sform__check">
            <input id="sform-consent" name="consent" type="checkbox" value="1" required />
            <label for="sform-consent">{s.consent} <span class="req">({s.req})</span> <a href={privacyHref}>{s.privacyLink}</a></label>
          </div>

          <p class="sform__error" role="alert" data-sform-error hidden></p>
          <button type="submit" class="btn btn--gold" data-sform-submit>{s.submit}</button>
        </form>

        <div class="sform__done" data-sform-done hidden>
          <h2 tabindex="-1" data-sform-done-h>{s.doneTitle}</h2>
          <p>{s.doneIntro} <strong data-f="reference"></strong></p>
          <h3>{s.doneSummary}</h3>
          <ul data-f="summary"></ul>
          <div class="sform__next" data-f="next"></div>
          <p>{s.questions} <a href={`mailto:${org.email}`}>{org.email}</a> · {org.phone}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-sform]').forEach((box) => {
    const form = box.querySelector<HTMLFormElement>('[data-sform-form]')!;
    const done = box.querySelector<HTMLElement>('[data-sform-done]')!;
    const err = box.querySelector<HTMLElement>('[data-sform-error]')!;
    const submit = box.querySelector<HTMLButtonElement>('[data-sform-submit]')!;
    const loaded = Date.now();
    // "Other amount": the number field is only needed (and shown) when that option is chosen
    const otherWrap = form.querySelector<HTMLElement>('[data-other-wrap]')!;
    const otherInput = otherWrap.querySelector<HTMLInputElement>('input')!;
    const amountRadios = [...form.querySelectorAll<HTMLInputElement>('input[name="amount"]')];
    const syncOther = () => { const on = form.querySelector<HTMLInputElement>('input[name="amount"]:checked')?.value === 'other'; otherWrap.hidden = !on; otherInput.required = on; if (on) otherInput.focus(); };
    amountRadios.forEach((r) => r.addEventListener('change', syncOther));
    otherWrap.hidden = true;
    // Address only with a donation receipt
    const receipt = form.querySelector<HTMLInputElement>('[data-receipt]')!;
    const addressWrap = form.querySelector<HTMLElement>('[data-address-wrap]')!;
    const address = addressWrap.querySelector<HTMLTextAreaElement>('textarea')!;
    const syncAddress = () => { addressWrap.hidden = !receipt.checked; address.required = receipt.checked; };
    receipt.addEventListener('change', syncAddress);
    syncAddress();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      (form.elements.namedItem('dwell') as HTMLInputElement).value = String(Date.now() - loaded);
      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = box.dataset.sending ?? label;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => null);
        if (!data || !data.ok) throw new Error(data?.message || box.dataset.netError);
        done.querySelector<HTMLElement>('[data-f="reference"]')!.textContent = data.reference;
        const li = (t: string) => Object.assign(document.createElement('li'), { textContent: t });
        done.querySelector<HTMLElement>('[data-f="summary"]')!.replaceChildren(...(data.summary as string[]).map(li));
        done.querySelector<HTMLElement>('[data-f="next"]')!.replaceChildren(...(data.next as string[]).map((t) => Object.assign(document.createElement('p'), { textContent: t })));
        form.hidden = true;
        done.hidden = false;
        done.querySelector<HTMLElement>('[data-sform-done-h]')!.focus();
      } catch (ex) {
        err.textContent = ex instanceof Error && ex.message ? ex.message : (box.dataset.netError ?? '');
        err.hidden = false;
        err.focus?.();
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  });
</script>
