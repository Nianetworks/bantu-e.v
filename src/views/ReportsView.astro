---
// Annual/transparency reports + the 10 items of the Initiative Transparente Zivilgesellschaft (ITZ).
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { href, r, type Lang } from '../i18n';
import { org } from '../data/site';
import Icon from '../components/Icon.astro';
import { coverFor, downloads, withReportVersion, type Download } from '../data/downloads';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const T = (d: string, e: string, f: string) => (de ? d : fr ? f : e);
const reports = downloads.filter((d) => d.group === 'reports');
const projectReports = downloads.filter((d) => d.group === 'projectReports');
const years = [...new Set(reports.map((d) => d.year!))].sort((a, b) => b - a);
// Preferred language of a report pair: the page language, English for French readers (no French editions exist).
const prefLang = de ? 'DE' : 'EN';
const byKind = (kind: Download['kind']) => years.map((y) => {
  const pair = reports.filter((d) => d.kind === kind && d.year === y);
  return { year: y, main: pair.find((d) => d.lang === prefLang) ?? pair[0], other: pair.filter((d) => d.lang !== prefLang) };
}).filter((x) => x.main);
const annual = byKind('annual');
const transparency = byKind('transparency');
const featured = annual[0];
const langName = (l: Download['lang']) => (l === 'DE' ? 'Deutsch' : l === 'EN' ? 'English' : l === 'FR' ? 'Français' : l);
const meta = (d: Download) => `PDF · ${langName(d.lang)} · ${d.size}`;
const title = T('Berichte', 'Reports', 'Rapports');
const lead = de
  ? 'Wir legen offen, wer wir sind, was wir tun, woher unser Geld kommt und wofür wir es ausgeben.'
  : fr ? 'Nous rendons public qui nous sommes, ce que nous faisons, d’où vient notre argent et comment nous l’utilisons.' : 'We disclose who we are, what we do, where our money comes from and how we spend it.';
const boardText = org.board.map((b) => `${b.name}, ${b.role[lang]}`).join('; ');
const itz = [
  { n: 1, t: de ? 'Name, Sitz, Anschrift, Gründungsjahr' : fr ? 'Nom, siège, adresse, année de création' : 'Name, seat, address, year founded', v: `${org.legalName}, ${org.address.street}, ${org.address.zip} ${org.address.city} · ${de ? 'gegründet' : fr ? 'fondée' : 'founded'} ${org.founded}` },
  { n: 2, t: de ? 'Satzung und Ziele' : fr ? 'Statuts et objectifs' : 'Statutes and objectives', v: de ? 'Ziele: siehe „Über uns“. Die Satzung senden wir auf Anfrage zu; die geänderte Fassung veröffentlichen wir nach Eintragung im Vereinsregister.' : fr ? 'Objectifs : voir « À propos ». Nous envoyons les statuts sur demande ; la version modifiée sera publiée après son inscription au registre.' : 'Objectives: see “About us”. We send the statutes on request; the amended version will be published once registered.', link: r('about', lang, '#mission') },
  { n: 3, t: de ? 'Steuerbegünstigung' : fr ? 'Exonération fiscale' : 'Tax-exempt status', v: de ? `Gemeinnützig anerkannt durch das ${org.tax.office}, Freistellungsbescheid vom ${org.tax.exemptionNotice}, Steuernummer ${org.tax.number}.` : fr ? `Reconnue d’intérêt général par le centre des impôts des collectivités de Berlin, avis d’exonération du ${org.tax.exemptionNotice}, numéro fiscal ${org.tax.number}.` : `Recognised as non-profit by the Berlin tax office for corporations, exemption notice of ${org.tax.exemptionNotice}, tax number ${org.tax.number}.` },
  { n: 4, t: de ? 'Entscheidungsträger*innen' : fr ? 'Personnes décisionnaires' : 'Key decision-makers', v: boardText, link: r('people', lang) },
  { n: 5, t: de ? 'Tätigkeitsbericht' : fr ? 'Rapport d’activité' : 'Activity report', v: de ? 'Transparenz- und Finanzberichte folgen in Kürze.' : fr ? 'Les rapports de transparence et les rapports financiers arrivent bientôt.' : 'Transparency and finance reports coming soon.' },
  { n: 6, t: de ? 'Personalstruktur' : fr ? 'Structure du personnel' : 'Staff structure', v: de ? 'Ein hauptamtlicher Vorstand; projektbezogene Beschäftigte und Honorarkräfte; Ehrenamtliche (Stand Tätigkeitsbericht 2023–2025).' : fr ? 'Un membre du conseil d’administration salarié ; personnel et intervenants rémunérés par projet ; bénévoles (selon le rapport d’activité 2023–2025).' : 'One salaried board member; project-based staff and freelancers; volunteers (as of the 2023–2025 activity report).' },
  { n: 7, t: de ? 'Mittelherkunft' : fr ? 'Origine des fonds' : 'Sources of funds', v: de ? 'Öffentliche Zuwendungen und Stiftungsmittel, Mitgliedsbeiträge, Spenden. Transparenz- und Finanzberichte folgen in Kürze.' : fr ? 'Subventions publiques et fonds de fondations, cotisations, dons. Les rapports de transparence et les rapports financiers arrivent bientôt.' : 'Public grants and foundation funding, membership fees, donations. Transparency and finance reports coming soon.' },
  { n: 8, t: de ? 'Mittelverwendung' : fr ? 'Utilisation des fonds' : 'Use of funds', v: de ? 'Jedes Förderprojekt wird separat abgerechnet und mit Verwendungsnachweis belegt. Transparenz- und Finanzberichte folgen in Kürze.' : fr ? 'Chaque projet financé fait l’objet d’un décompte séparé avec justificatif d’utilisation. Les rapports de transparence et les rapports financiers arrivent bientôt.' : 'Each funded project is accounted for separately with a proof of use. Transparency and finance reports coming soon.' },
  { n: 9, t: de ? 'Gesellschaftsrechtliche Verbundenheit' : fr ? 'Liens avec des tiers' : 'Affiliations with third parties', v: de ? 'Bantu e.V. war Trägerverein der Initiative Tubman.Network, die seit Januar 2024 ein eigenständiger Verein ist (tubman.network e.V.); für die von ihrem Team umgesetzten historischen Projekte lag die Trägerschaft bis zum jeweiligen Projektende bei Bantu e.V. und ist seit 2022 Trägerverein von Kikili e.V. i.G. (Sandau). Darüber hinaus bestehen keine gesellschaftsrechtlichen Verbindungen zu Dritten.' : fr ? 'Bantu e.V. a été l’association porteuse de l’initiative Tubman.Network, devenue en janvier 2024 une association indépendante (tubman.network e.V.) ; pour les projets historiques mis en œuvre par son équipe, le portage juridique et administratif est resté chez Bantu e.V. jusqu’à la fin de chaque projet et porte Kikili e.V. i.G. (Sandau) depuis 2022. Il n’existe pas d’autres liens juridiques avec des tiers.' : 'Bantu e.V. was the fiscal sponsor of the Tubman.Network initiative, which became the independent association tubman.network e.V. in January 2024; for the historical projects its team implemented, Bantu e.V. provided the legal and administrative project sponsorship until each project ended and has been the fiscal sponsor of Kikili e.V. i.G. (Sandau) since 2022. There are no other corporate affiliations with third parties.' },
  { n: 10, t: de ? 'Zuwendungen über 10 % des Jahresbudgets' : fr ? 'Bailleurs au-delà de 10 % du budget annuel' : 'Funders above 10% of the annual budget', v: de ? 'Transparenz- und Finanzberichte folgen in Kürze.' : fr ? 'Les rapports de transparence et les rapports financiers arrivent bientôt.' : 'Transparency and finance reports coming soon.' },
];
---
<Base lang={lang} title={title} description={lead} altHref={r('reports', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead} crumbs={[{ label: de ? 'Wirkung' : fr ? 'Impact' : 'Impact', href: r('impact', lang) }]} />

  {featured && (
    <section class="section section--tight" aria-labelledby="h-featured">
      <div class="wrap">
        <div class="featured panel">
          <a class="featured__cover" href={withReportVersion(href(featured.main.file))} download aria-hidden="true" tabindex="-1">
            <img src={withReportVersion(href(coverFor(featured.main)))} width="560" height="792" alt="" loading="eager" />
          </a>
          <div class="featured__body">
            <div class="eyebrow">{T('Aktueller Bericht', 'Latest report', 'Dernier rapport')}</div>
            <h2 id="h-featured">{featured.main.title[lang]}</h2>
            <p>{T('Tätigkeit, Projekte und Finanzen des Jahres im Überblick: was wir in Berlin, Uganda und Burundi getan haben, mit wem, mit welchen Mitteln und mit welchem Ergebnis. Die ursprüngliche Fassung wurde im Mai 2026 vom Vorstand unterzeichnet; die korrigierte Ausgabe vom 12. November 2026 nennt ihre Änderungen in einem Korrekturhinweis.', 'Activities, projects and finances of the year at a glance: what we did in Berlin, Uganda and Burundi, with whom, with which funds and with what result. The original edition was signed by the board in May 2026; the corrected edition of 12 November 2026 lists its changes in a correction notice.', 'Activités, projets et finances de l’année en bref : ce que nous avons fait à Berlin, en Ouganda et au Burundi, avec qui, avec quels moyens et avec quel résultat. La version originale a été signée par le conseil d’administration en mai 2026 ; l’édition corrigée du 12 novembre 2026 indique ses modifications dans un avis de correction.')}</p>
            <p class="meta">{meta(featured.main)}</p>
            <div class="btn-row">
              <a class="btn btn--gold" href={withReportVersion(href(featured.main.file))} download><Icon name="download" /> {T('Jahresbericht herunterladen (PDF)', 'Download the annual report (PDF)', 'Télécharger le rapport annuel (PDF)')}</a>
              {featured.other.map((o) => <a class="btn btn--outline" href={withReportVersion(href(o.file))} download>{o.title[lang]} <span class="small">({o.size})</span></a>)}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight" id="jahresberichte" aria-labelledby="h-finance-soon">
    <div class="wrap">
      <div class="panel soon" id="transparenzberichte">
        <h2 id="h-finance-soon">{T('Transparenz- und Finanzberichte folgen in Kürze', 'Transparency and finance reports coming soon', 'Les rapports de transparence et les rapports financiers arrivent bientôt')}</h2>
        <p>{T('Wir überarbeiten derzeit unsere Jahres- und Transparenzberichte. Sie erscheinen hier wieder, sobald die Zahlen abgestimmt und vom Vorstand freigegeben sind. Fragen zu unseren Finanzen beantworten wir gern unter info@bantu-ev.org.', 'We are currently revising our annual and transparency reports. They will be available here again once the figures have been reconciled and approved by the board. We are happy to answer questions about our finances at info@bantu-ev.org.', 'Nous révisons actuellement nos rapports annuels et de transparence. Ils seront de nouveau disponibles ici dès que les chiffres auront été rapprochés et approuvés par le conseil d’administration. Nous répondons volontiers à vos questions sur nos finances à info@bantu-ev.org.')}</p>
      </div>
    </div>
  </section>

  {projectReports.length > 0 && (
    <section class="section section--tight" id="projektberichte" aria-labelledby="h-project-reports">
      <div class="wrap">
        <div class="section-head"><div><h2 id="h-project-reports">{T('Projektberichte', 'Project reports', 'Rapports de projet')}</h2><p>{T('Berichte unserer Partnerorganisationen zu einzelnen Projekten, aufbereitet für die Website. Gesichter von Kindern auf Fotos sind unkenntlich gemacht.', 'Reports by our partner organisations on individual projects, edited for the website. Children’s faces in photographs are blurred.', 'Rapports de nos organisations partenaires sur des projets précis, édités pour le site web. Les visages des enfants sur les photos sont floutés.')}</p></div></div>
        <ul class="reports" role="list">
          {projectReports.map((d) => (
            <li class="report">
              <a class="report__cover" href={withReportVersion(href(d.file))} download aria-hidden="true" tabindex="-1"><img src={withReportVersion(href(coverFor(d)))} width="560" height="792" alt="" loading="lazy" /></a>
              <div class="report__body">
                <h3><a href={withReportVersion(href(d.file))} download>{d.title[lang]}</a></h3>
                <p class="meta">{meta(d)}{d.year ? ` · ${d.year}` : ''}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="small"><a class="link-arrow" href={r('downloads', lang)}>{T('Formulare und Flyer: Downloads', 'Forms and flyers: downloads', 'Formulaires et dépliants : téléchargements')}</a></p>
      </div>
    </section>
  )}

  <section class="section section--alt" id={de ? 'transparenz' : 'transparency'}>
    <div class="wrap">
      <div class="eyebrow">{de ? 'Transparenz' : fr ? 'Transparence' : 'Transparency'}</div>
      <h2>{de ? 'Zehn Angaben, die jede gemeinnützige Organisation machen sollte' : fr ? 'Dix informations que toute organisation d’intérêt général devrait publier' : 'Ten disclosures every non-profit should make'}</h2>
      <p class="lead">{de ? 'Wir orientieren uns an den zehn Punkten der Initiative Transparente Zivilgesellschaft.' : fr ? 'Nous suivons les dix points de l’Initiative pour une société civile transparente (Initiative Transparente Zivilgesellschaft).' : 'We follow the ten points of the Transparent Civil Society Initiative (Initiative Transparente Zivilgesellschaft).'}</p>
      <ol class="itz">
        {itz.map((i) => (
          <li>
            <span class="itz__n">{i.n}</span>
            <div><h3>{i.t}</h3><p>{i.v}{i.link && <> <a href={i.link}>{de ? 'Mehr' : fr ? 'Plus' : 'More'}<span class="sr-only">: {i.t}</span></a></>}</p></div>
          </li>
        ))}
      </ol>
      <!-- OPEN: Punkte 6, 9, 10 mit dem Vorstand bestätigen; Freistellungsbescheid und Satzung als PDF verlinken, sobald freigegeben; ITZ-Logo erst nach bestätigter Teilnahme ergänzen. -->
    </div>
  </section>
</Base>
<style>
  .featured { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; border-top: 6px solid var(--gold); }
  .featured__cover img, .report__cover img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; box-shadow: var(--shadow); background: #fff; }
  .featured__body h2 { margin: .25rem 0 .5rem; }
  .featured__body p { max-width: 66ch; }
  .meta { font-size: .92rem; color: var(--muted); font-weight: 600; }
  .reports { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1.25rem; }
  .report { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 1rem; align-items: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; margin: 0; }
  .report__body { min-width: 0; }
  .report h3 { font-size: 1.1rem; margin: 0 0 .25rem; hyphens: auto; overflow-wrap: anywhere; }
  .report h3 a { color: var(--ink); text-decoration: none; }
  .report h3 a:hover { text-decoration: underline; }
  .report .small { margin: .35rem 0 0; }
  @media (max-width: 700px) { .featured { grid-template-columns: minmax(0, 140px) minmax(0, 1fr); align-items: start; } }
  @media (max-width: 480px) { .featured { grid-template-columns: 1fr; } .featured__cover { max-width: 180px; } }
  .itz { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr)); gap: .9rem; }
  .itz li { display: flex; gap: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.2rem; margin: 0; }
  .itz__n { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: var(--on-gold); display: grid; place-items: center; font-weight: 700; }
  .itz h3 { font-family: var(--font-sans); font-size: 1rem; margin: .2rem 0 .3rem; }
  .itz p { margin: 0; color: var(--ink-2); font-size: .95rem; }
</style>
