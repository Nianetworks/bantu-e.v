---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { programmes, programmePath, regions, regionPath } from '../data/programmes';
import { funders, orgLogo, partnersNorth, partnersSouth } from '../data/people';
import { href, r, projectPath, ui, type Lang } from '../i18n';
import { getEvents, getNews, getProjects } from '../lib/content';
import { impact } from '../data/impact';
import { org } from '../data/site';
import { heroSlides } from '../data/heroSlides';
import { eventNode } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const projects = await getProjects(lang);
// Success story: photo and alt text come from the project itself (Msingi School, P 24/200), so the homepage shows the
// same main photo as the project page. A -480.webp copy exists next to every project photo.
const storyProject = projects.find((p) => p.id.endsWith('p24-200-msingi-school'));
const storyImage = storyProject?.data.image;
const storyAlt = storyProject?.data.imageAlt ?? '';
const featured = projects.filter((p) => p.data.featured && p.data.status === 'active').slice(0, 4);
const { upcoming } = await getEvents(lang);
const news = (await getNews(lang)).filter((n) => n.data.type !== 'event').slice(0, 3);
const spotlight = [...upcoming.slice(0, 2), ...news].slice(0, 3);
const quick = [
  { icon: 'globe', label: de ? 'Projekte entdecken' : fr ? 'Découvrir les projets' : 'Explore projects', text: de ? `${projects.length} Projekte in Uganda, Burundi und Berlin` : fr ? `${projects.length} projets en Ouganda, au Burundi et à Berlin` : `${projects.length} projects in Uganda, Burundi and Berlin`, href: r('projects', lang) },
  { icon: 'calendar', label: de ? 'Termine' : fr ? 'Événements' : 'Events', text: upcoming[0] ? upcoming[0].data.title : (de ? 'Workshops und Begegnungen' : fr ? 'Ateliers et rencontres' : 'Workshops and encounters'), href: r('events', lang) },
  { icon: 'heart', label: t.donate, text: de ? 'Mit Zuwendungsbestätigung' : fr ? 'Avec reçu fiscal' : 'With donation receipt', href: r('donate', lang) },
  { icon: 'hand', label: de ? 'Mitmachen' : fr ? 'S’engager' : 'Get involved', text: de ? 'Mitglied, Ehrenamt, Kooperation' : fr ? 'Adhésion, bénévolat, partenariats' : 'Membership, volunteering, partnerships', href: r('join', lang) },
] as const;
// Structured data for upcoming events (they drop out automatically after the event; nightly rebuild).
const schema = upcoming.map((e) => eventNode(e, lang, Astro.site)).filter((x): x is Record<string, unknown> => !!x);
// First hero photo: preload with the same srcset/sizes as the <img>, so the browser fetches exactly one file.
const heroFile = (small = false) => href(`/images/hero/${heroSlides[0].file}${small ? '-800' : ''}.webp`);
---
<Base lang={lang} title={org.shortName} altHref={r('home', de ? 'en' : 'de')} schema={schema}>
  <link slot="head" rel="preload" as="image" type="image/webp" href={heroFile()} imagesrcset={`${heroFile(true)} 800w, ${heroFile()} 1600w`} imagesizes="100vw" fetchpriority="high" />
  <section class="hero hero--photo" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="hero__kicker">{de ? 'Gemeinnütziger Verein · Berlin · seit 2019' : fr ? 'Association d’intérêt général · Berlin · depuis 2019' : 'Non-profit association · Berlin · since 2019'}</p>
        <h1 id="hero-title">{de ? <><span class="hl">Gemeinsam</span> bauen wir nachhaltige und selbstbestimmte Gemeinschaften.</> : fr ? <><span class="hl">Ensemble</span>, nous bâtissons des communautés durables et autonomes.</> : <><span class="hl">Together</span>, We Build Sustainable and Empowered Communities.</>}</h1>
        <p class="hero__lead">
          {de
            ? 'Bantu e.V. verbindet Menschen in Berlin und in der Region der Großen Seen Ostafrikas. Mit Partnerorganisationen in Uganda und Burundi schaffen wir Zugang zu Bildung, Wasser und Teilhabe, und setzen uns in Deutschland für globale Gerechtigkeit und Dekolonisierung ein.'
            : fr ? 'Bantu e.V. relie des personnes à Berlin et dans la région des Grands Lacs d’Afrique de l’Est. Avec nos organisations partenaires en Ouganda et au Burundi, nous ouvrons l’accès à l’éducation, à l’eau et à la participation, et en Allemagne nous agissons pour la justice globale et la décolonisation.' : 'Bantu e.V. connects people in Berlin and the Great Lakes region of East Africa. With partner organisations in Uganda and Burundi we create access to education, water and participation, and in Germany we work for global justice and decolonisation.'}
        </p>
        <div class="btn-row">
          <a class="btn btn--gold" href={r('programmes', lang)}>{de ? 'Unsere Arbeit' : fr ? 'Notre travail' : 'Our work'} <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={r('donate', lang)}><Icon name="heart" /> {de ? 'Jetzt spenden' : fr ? 'Faire un don' : 'Donate now'}</a>
        </div>
      </div>
      <HeroSlideshow lang={lang} />
    </div>
  </section>

  <nav class="quick" aria-label={de ? 'Schnellzugriff' : fr ? 'Accès rapide' : 'Quick links'}>
    <div class="wrap quick__grid">
      {quick.map((q) => (
        <a class="quick__item" href={q.href}>
          <span class="icon-badge"><Icon name={q.icon} /></span>
          <span><strong>{q.label}</strong><span class="quick__text">{q.text}</span></span>
        </a>
      ))}
    </div>
  </nav>

  {spotlight.length > 0 && (
    <section class="section" aria-labelledby="h-news">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">{de ? 'Aktuell & demnächst' : fr ? 'Actualités et agenda' : 'News & upcoming'}</div>
            <h2 id="h-news">{de ? 'Was gerade passiert' : fr ? 'Ce qui se passe' : 'What’s happening'}</h2>
          </div>
          <div class="btn-row">
            <a class="link-arrow" href={r('events', lang)}>{t.allEvents}</a>
            <a class="link-arrow" href={r('news', lang)}>{t.allNews}</a>
          </div>
        </div>
        <div class="grid grid--3">
          {spotlight.map((n) => <NewsCard lang={lang} item={n} showImage />)}
        </div>
      </div>
    </section>
  )}

  <section class="section cv" aria-labelledby="h-regions">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Wo wir arbeiten' : fr ? 'Où nous travaillons' : 'Where we work'}</div>
          <h2 id="h-regions">{de ? 'Zwei Arbeitsbereiche, ein Netzwerk' : fr ? 'Deux domaines, un seul réseau' : 'Two areas of work, one network'}</h2>
        </div>
      </div>
      <div class="grid grid--2 regions">
        {regions.map((rg) => {
          const items = projects.filter((x) => x.data.programme === rg.key);
          const progCount = programmes.filter((p) => p.projects.some((s) => items.some((x) => x.id.split('/')[1] === s))).length;
          return (
            <article class="region">
              <img src={href(rg.image)} alt="" loading="lazy" width="800" height="533" />
              <div class="region__body">
                <p class="region__meta">{rg.places[lang]} · {progCount} {de ? 'Programme' : fr ? 'programmes' : 'programmes'} · {items.length} {de ? 'Projekte' : fr ? 'projets' : 'projects'}</p>
                <h3><a href={regionPath(lang, rg.key)}>{de && rg.key === 'international' ? 'Internationale Zusammenarbeit' : rg.title[lang]}</a></h3>
                <p>{rg.lead[lang]}</p>
                <span class="link-arrow" aria-hidden="true">{de ? 'Mehr erfahren' : fr ? 'En savoir plus' : 'Learn more'}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--alt cv" aria-labelledby="h-prog">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Programme' : fr ? 'Programmes' : 'Programmes'}</div>
          <h2 id="h-prog">{de ? 'Fünf Programme, ein Gedanke' : fr ? 'Cinq programmes, une idée' : 'Five programmes, one idea'}</h2>
          <p>{de ? 'Wir arbeiten dort, wo wir verwurzelt sind: mit Partnerorganisationen in Uganda und Burundi und mit Communities, Schulen und Initiativen in Deutschland.' : fr ? 'Nous travaillons là où nous avons des racines : avec des organisations partenaires en Ouganda et au Burundi, et avec des communautés, des écoles et des initiatives en Allemagne.' : 'We work where we have roots: with partner organisations in Uganda and Burundi and with communities, schools and initiatives in Germany.'}</p>
        </div>
        <a class="link-arrow" href={r('programmes', lang)}>{de ? 'Alle Programme' : fr ? 'Tous les programmes' : 'All programmes'}</a>
      </div>
      <ul class="prog-row">
        {programmes.map((p) => {
          const running = p.projects.filter((s) => projects.some((x) => x.id.split('/')[1] === s && x.data.status !== 'completed')).length;
          return (
            <li class={`prog prog--${p.accent}`}>
              <span class="icon-badge"><Icon name={p.icon} /></span>
              <p class="prog__count">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {p.no}{running > 0 && <> · {running} {de ? 'laufend' : fr ? 'en cours' : 'ongoing'}</>}</p>
              <h3><a href={programmePath(lang, p.key)}>{p.title[lang]}</a></h3>
              <p>{p.short[lang]}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--deep cv" aria-labelledby="h-impact">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Wirkung' : fr ? 'Impact' : 'Impact'}</div>
          <h2 id="h-impact">{de ? 'Was wir gemeinsam erreicht haben' : fr ? 'Ce que nous avons accompli ensemble' : 'What we have achieved together'}</h2>
        </div>
        <a class="link-arrow on-deep" href={r('impact', lang)}>{de ? 'Alle Erfolgsgeschichten' : fr ? 'Toutes les réussites' : 'All success stories'}</a>
      </div>
      <ul class="stat-grid impact-list">
        {impact.map((s) => (
          <li class="stat">
            <a href={projectPath(lang, s.project)}>
              <span class="stat__value">{s.value[lang]}</span>
              <span class="stat__label">{s.label[lang]}</span>
              <span class="stat__source">{s.source[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section cv" aria-labelledby="h-proj">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Laufende Projekte' : fr ? 'Projets en cours' : 'Current projects'}</div>
          <h2 id="h-proj">{de ? 'Woran wir gerade arbeiten' : fr ? 'Ce sur quoi nous travaillons' : 'What we are working on'}</h2>
        </div>
        <a class="link-arrow" href={r('projects', lang)}>{t.allProjects}</a>
      </div>
      <div class="grid grid--4">
        {featured.map((p) => <ProjectCard lang={lang} project={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt cv" aria-labelledby="h-story">
    <div class="wrap story">
      <div class="story__media">
        {storyImage
          ? <img class="story__img" src={href(storyImage)} srcset={`${href(storyImage.replace(/\.webp$/, '-480.webp'))} 480w, ${href(storyImage)} 1080w`} sizes="(max-width: 900px) calc(100vw - 2rem), 560px" alt={storyAlt} width="1080" height="810" loading="lazy" decoding="async" />
          : <Placeholder lang={lang} label={de ? 'Absolventinnen mit Zertifikaten, Ausbildung im Salon (mit Einverständnis)' : fr ? 'Diplômées avec leurs certificats, formation au salon (avec consentement)' : 'Graduates with certificates, training in the salon (with consent)'} ratio="4 / 3" tone="gold" icon="star" />}
      </div>
      <div>
        <div class="eyebrow">{de ? 'Erfolgsgeschichte' : fr ? 'Une réussite' : 'Success story'}</div>
        <h2 id="h-story">{de ? '18 Zertifikate, 7 Arbeitsplätze, viel Mut' : fr ? '18 certificats, 7 emplois, beaucoup de courage' : '18 certificates, 7 jobs, a lot of courage'}</h2>
        <p class="lead">{de ? 'An der Msingi School in Mbarara haben 18 junge Frauen ihre Ausbildung in Friseurhandwerk und Kosmetik abgeschlossen. Sieben wurden direkt von ihren Praktikumsbetrieben eingestellt.' : fr ? 'À la Msingi School de Mbarara, 18 jeunes femmes ont terminé leur formation en coiffure et esthétique. Sept ont été embauchées directement par les entreprises où elles avaient fait leur stage.' : 'At Msingi School in Mbarara, 18 young women completed their training in hairdressing and cosmetology. Seven were hired directly by their placement businesses.'}</p>
        <div class="btn-row">
          <a class="btn btn--dark" href={projectPath(lang, 'p24-200-msingi-school')}>{de ? 'Geschichte lesen' : fr ? 'Lire l’histoire' : 'Read the story'}</a>
          <a class="link-arrow" href={r('impact', lang)}>{de ? 'Weitere Erfolgsgeschichten' : fr ? 'Autres réussites' : 'More success stories'}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section cv" aria-labelledby="h-support">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Unterstützen' : fr ? 'Soutenir' : 'Support'}</div>
          <h2 id="h-support">{de ? 'Werden Sie Teil davon' : fr ? 'Rejoignez-nous' : 'Become part of it'}</h2>
        </div>
      </div>
      <div class="panel monthly">
        <div>
          <div class="eyebrow">{de ? 'Regelmäßig helfen' : fr ? 'Aider régulièrement' : 'Give regularly'}</div>
          <h3>{de ? 'Education into the Future: ab 25 EUR im Monat ein Platz in der Schule' : fr ? 'Education into the Future : dès 25 EUR par mois, une place à l’école' : 'Education into the Future: from 25 EUR a month, a place in school'}</h3>
          <p>{de ? 'Mit einer Bildungspatenschaft ermöglichen Sie Kindern und jungen Menschen in Uganda den Schulbesuch oder eine Ausbildung, gemeinsam mit unserem Partner ABI. Sie wählen Betrag, Rhythmus und Bildungsstufe; wir berichten mindestens einmal im Jahr.' : fr ? 'Avec un parrainage éducatif, vous permettez à des enfants et des jeunes en Ouganda d’aller à l’école ou de suivre une formation, avec notre partenaire ABI. Vous choisissez le montant, le rythme et l’étape éducative ; nous vous informons au moins une fois par an.' : 'With an education sponsorship you enable children and young people in Uganda to attend school or training, together with our partner ABI. You choose the amount, rhythm and education stage; we report at least once a year.'}</p>
        </div>
        <div class="btn-row monthly__btns">
          <a class="btn btn--gold" href={r('sponsorship', lang)}>{de ? 'Patenschaft übernehmen' : fr ? 'Devenir marraine ou parrain' : 'Become a sponsor'}</a>
          <a class="btn btn--outline" href={r('donate', lang)}>{de ? 'Dauerspende' : fr ? 'Don régulier' : 'Regular gift'}</a>
        </div>
      </div>
      <div class="grid grid--4">
        <article class="support">
          <span class="icon-badge"><Icon name="heart" /></span>
          <h3><a href={r('donate', lang)}>{t.donate}</a></h3>
          <p>{de ? 'Jeder Betrag hilft. Wir stellen Zuwendungsbestätigungen aus.' : fr ? 'Chaque montant aide. Nous délivrons des reçus fiscaux.' : 'Every amount helps. We issue donation receipts.'}</p>
        </article>
        <article class="support">
          <span class="icon-badge"><Icon name="people" /></span>
          <h3><a href={r('join', lang, '#membership')}>{de ? 'Mitglied werden' : fr ? 'Devenir membre' : 'Become a member'}</a></h3>
          <p>{de ? 'Ab 5 € im Monat (ermäßigt 2,50 €), mit Stimme im Verein.' : fr ? 'Dès 5 € par mois (tarif réduit 2,50 €), avec droit de vote dans l’association.' : 'From €5 a month (reduced €2.50), with a vote in the association.'}</p>
        </article>
        <article class="support">
          <span class="icon-badge"><Icon name="hand" /></span>
          <h3><a href={r('join', lang, '#volunteer')}>{de ? 'Ehrenamtlich mitmachen' : fr ? 'Bénévolat' : 'Volunteer'}</a></h3>
          <p>{de ? 'Bei Veranstaltungen, Übersetzungen, Social Media oder Fundraising, in Berlin oder online.' : fr ? 'Lors d’événements, pour des traductions, sur les réseaux sociaux ou pour la collecte de fonds, à Berlin ou en ligne.' : 'At events, with translation, social media or fundraising, in Berlin or online.'}</p>
        </article>
        <article class="support">
          <span class="icon-badge"><Icon name="bag" /></span>
          <h3><a href={r('shop', lang)}>Shop</a></h3>
          <p>{de ? 'Bald mit Abantu Coffee und Merchandise.' : fr ? 'Bientôt avec Abantu Coffee et des articles à notre image.' : 'Coming soon with Abantu Coffee and merchandise.'}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tight cv" aria-labelledby="h-access">
    <div class="wrap access-band">
      <span class="icon-badge icon-badge--lg"><Icon name="access" /></span>
      <div>
        <h2 id="h-access">{de ? 'Eine Website für alle' : fr ? 'Un site pour tout le monde' : 'A website for everyone'}</h2>
        <p>{de
          ? 'Schrift vergrößern, hoher Kontrast, dunkle Ansicht, gut lesbare Schrift oder Seite vorlesen lassen: Über „Barrierefreiheit“ (am Computer oben auf jeder Seite, auf Handy und Tablet im Menü) passen Sie die Darstellung an. Wichtige Informationen gibt es auch in Einfacher Sprache.'
          : fr ? 'Texte plus grand, contraste élevé, mode sombre, police facile à lire ou lecture à voix haute : utilisez « Accessibilité » (en haut de chaque page sur ordinateur, dans le menu sur téléphone et tablette) pour adapter l’affichage. Les informations essentielles existent aussi en langage facile.' : 'Bigger text, high contrast, dark mode, an easy-to-read font or having the page read aloud: use “Accessibility” (at the top of every page on a computer, in the menu on phones and tablets) to adjust the display. Key information is also available in easy read.'}</p>
        <div class="btn-row">
          <button type="button" class="btn btn--dark" data-a11y-toggle aria-haspopup="dialog" aria-controls="a11y-panel"><Icon name="access" /> {de ? 'Darstellung anpassen' : fr ? 'Adapter l’affichage' : 'Adjust display'}</button>
          <a class="btn btn--outline" href={r('easy', lang)}><Icon name="easy" /> {t.easy}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand section--tight cv" aria-labelledby="h-partners">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">{de ? 'Danke' : fr ? 'Merci' : 'Thank you'}</div>
          <h2 id="h-partners">{de ? 'Unsere Arbeit wird gefördert von' : fr ? 'Notre travail est soutenu par' : 'Our work is supported by'}</h2>
        </div>
        <a class="link-arrow" href={r('people', lang, de ? '#foerderer' : '#funders')}>{de ? 'Alle Partner und Förderer' : fr ? 'Tous les partenaires et bailleurs' : 'All partners and funders'}</a>
      </div>
      <ul class="logo-strip">
        {funders.filter((f) => f.logo).map((f) => (
          <li><a href={f.url} rel="noopener"><img src={href(f.logo!)} alt={f.name[lang]} loading="lazy" /></a></li>
        ))}
      </ul>
      <h3 class="logo-h">{de ? 'Wir arbeiten zusammen mit' : fr ? 'Nous travaillons avec' : 'We work together with'}</h3>
      <ul class="logo-strip logo-strip--partners">
        {[...partnersSouth, ...partnersNorth].filter((o) => o.logo && o.url).map((o) => (
          <li><a class={o.logoDark ? 'is-dark' : ''} href={o.url} rel="noopener"><img src={href(orgLogo(o, lang)!)} alt={o.name} loading="lazy" /></a></li>
        ))}
      </ul>
      <p class="partners-line">{de ? 'Außerdem: ' : fr ? 'Également : ' : 'Also: '}{[...partnersSouth, ...partnersNorth].filter((o) => !o.logo).map((o, i) => <>{i > 0 && ' · '}{o.url ? <a href={o.url} rel="noopener">{o.name}</a> : o.name}</>)}</p>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; background: radial-gradient(900px 480px at 85% 30%, rgba(254,191,0,.16), transparent 60%), var(--deep); color: var(--on-deep); padding-block: clamp(6.5rem, 11vw, 8.5rem) clamp(4.5rem, 7vw, 6rem); overflow: hidden; }
  .hero__text { position: relative; z-index: 1; }
  .hero--photo .hero__grid { min-height: clamp(340px, 46vh, 520px); }
  .hero__grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero__kicker { font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: .85rem; color: #ffd34d; margin-bottom: 1rem; }
  .hero h1 { color: #fff; font-size: clamp(2.2rem, 4.8vw, 3.9rem); max-width: 19ch; margin-bottom: .45em; line-height: 1.1; }
  .hl { color: #ffd34d; text-decoration: underline; text-decoration-color: rgba(254,191,0,.5); text-decoration-thickness: .08em; text-underline-offset: .12em; }
  .hero__lead { font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: #e8e3d6; max-width: 58ch; margin-bottom: 1.8rem; }
  .btn--ghost { border-color: rgba(255,255,255,.75); color: #fff; background: transparent; }
  .btn--ghost:hover { background: rgba(255,255,255,.1); color: #fff; }

  /* Layout/style containment only: paint containment would clip the cards' shadows and hover lift. */
  .quick { position: relative; margin-top: -2.5rem; z-index: 2; contain: layout style; }
  .quick__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .9rem; }
  .quick__item { min-width: 0; display: flex; gap: .9rem; align-items: center; background: var(--surface); color: var(--ink); text-decoration: none; border: 1px solid var(--line); border-radius: 18px; padding: 1rem 1.1rem; box-shadow: var(--shadow); min-height: 84px; transition: transform .15s, border-color .15s; }
  .quick__item:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .quick__item:hover strong { text-decoration: underline; }
  .quick__item strong { display: block; font-size: 1.05rem; }
  .quick__text { display: block; font-size: .9rem; color: var(--muted); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .region { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; overflow: hidden; min-width: 0; }
  .region img { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; }
  .region__body { display: flex; flex-direction: column; gap: .5rem; padding: 1.4rem 1.5rem 1.6rem; flex: 1; }
  .region__meta { margin: 0; font-size: .85rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .region h3 { margin: 0; font-size: clamp(1.5rem, 2.4vw, 1.9rem); }
  .region h3 a { color: var(--ink); text-decoration: none; }
  .region h3 a::after { content: ''; position: absolute; inset: 0; }
  .region:hover h3 a { text-decoration: underline; }
  .region:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .region a:focus-visible { outline: none; }
  .region p { margin: 0; color: var(--ink-2); }
  .region .link-arrow { margin-top: auto; padding-top: .5rem; }
