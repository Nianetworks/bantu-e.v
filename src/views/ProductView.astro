---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import { href, productPath, projectPath, r, ui, type Lang } from '../i18n';
import { categories, type Product } from '../data/shop';
import { features, org } from '../data/site';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const cat = categories.find((c) => c.id === p.category)!;
const canBuy = features.shopCheckoutOpen && p.status === 'available' && !!p.checkoutUrl;
const isGift = p.category === 'gifts';
const mail = `mailto:${org.email}?subject=${encodeURIComponent((de ? 'Vormerken: ' : fr ? 'Réserver : ' : 'Reserve: ') + p.name[lang])}`;
---
<Base lang={lang} title={p.name[lang]} description={p.short[lang]} altHref={productPath(de ? 'en' : 'de', p.slug)}>
  <PageHead lang={lang} title={p.name[lang]} lead={p.short[lang]} crumbs={[{ label: 'Shop', href: r('shop', lang) }, { label: cat.name[lang], href: r('shop', lang, `#${cat.id}`) }]} />
  <section class="section section--tight">
    <div class="wrap product">
      <div class="product__media">
        {p.image ? <img src={href(p.image)} alt={p.name[lang]} /> : <Placeholder lang={lang} ratio="1 / 1" label={p.photoBrief?.[lang]} tone={isGift ? 'gold' : 'sand'} />}
      </div>
      <div>
        <p class="price">{p.price ? `${p.price.toFixed(2).replace('.', de ? ',' : '.')} €` : (p.priceNote?.[lang] ?? t.priceTbd)}</p>
        <p>{p.description[lang]}</p>
        {p.details && (
          <dl class="kv">{p.details.map((d) => <><dt>{d.label[lang]}</dt><dd>{d.value[lang]}</dd></>)}</dl>
        )}
        <div class="btn-row" style="margin-top:1.5rem">
          {isGift && <a class="btn btn--gold" href={r('donate', lang, `?ref=${encodeURIComponent(p.donationReference ?? '')}`)}>{de ? 'Jetzt spenden' : fr ? 'Faire un don' : 'Donate now'}</a>}
          {!isGift && canBuy && <a class="btn btn--gold" href={p.checkoutUrl} rel="noopener">{t.buy}</a>}
          {!isGift && !canBuy && <a class="btn btn--dark" href={mail}>{t.notify}</a>}
          {p.project && <a class="btn btn--outline" href={projectPath(lang, p.project)}>{de ? 'Zum Projekt' : fr ? 'À propos du projet' : 'About the project'}</a>}
        </div>
        {isGift && p.donationReference && <p class="small muted" style="margin-top:1rem">{de ? 'Verwendungszweck' : fr ? 'Motif du paiement' : 'Payment reference'}: <strong>{p.donationReference}</strong></p>}
        {!isGift && !canBuy && <p class="notice" style="margin-top:1.25rem">{t.shopClosedNote}</p>}
      </div>
    </div>
  </section>
</Base>
<style>
  .product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .product__media { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); }
  .price { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; margin-bottom: .75rem; }
  @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
</style>
