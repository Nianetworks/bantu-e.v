---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import OrderForm from '../components/OrderForm.astro';
import ProductImage from '../components/ProductImage.astro';
import ProductGallery from '../components/ProductGallery.astro';
import { giftPath, productPath, projectPath, r, ui, type Lang } from '../i18n';
import { canOrder, categories, products, type Product } from '../data/shop';
import { features, org } from '../data/site';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const cat = categories.find((c) => c.id === p.category)!;
// Order form on our own server (gifts now, goods once switched on); an external checkout link stays possible for later.
const orderable = canOrder(p);
const canBuy = !orderable && features.shopCheckoutOpen && p.status === 'available' && !!p.checkoutUrl;
const isGift = p.category === 'gifts';
// ABANTU COFFEE planned editions: collection preview, no price and no reservation (chair, 08.11.2026)
const isPlanned = p.status === 'planned';
const story = p.story;
const collection = p.edition ? products.filter((x) => x.edition).sort((a, b) => (a.edition ?? 0) - (b.edition ?? 0)) : [];
const storyTitle = de ? `Die Geschichte von ${p.editionName}` : fr ? `L’histoire de ${p.editionName}` : `The story of ${p.editionName}`;
const mail = `mailto:${org.email}?subject=${encodeURIComponent((de ? 'Vormerken: ' : fr ? 'Réserver : ' : 'Reserve: ') + p.name[lang])}`;
---
<Base lang={lang} title={p.name[lang]} description={p.short[lang]} altHref={(isGift ? giftPath : productPath)(de ? 'en' : 'de', p.slug)}>
  <PageHead lang={lang} title={p.name[lang]} lead={p.short[lang]} crumbs={isGift
    ? [{ label: de ? 'Spenden' : fr ? 'Faire un don' : 'Donate', href: r('donate', lang) }, { label: cat.name[lang], href: r('donate', lang, '#geschenke') }]
    : [{ label: 'Shop', href: r('shop', lang) }, { label: cat.name[lang], href: r('shop', lang, `#${cat.id}`) }]} />
  <section class="section section--tight">
    <div class="wrap product">
      <div class="product__media">
        {p.image && p.labelImages && p.labelImages.length >= 2
          ? <ProductGallery product={p} lang={lang} />
          : p.image ? <ProductImage product={p} lang={lang} variant="detail" /> : <Placeholder lang={lang} ratio="1 / 1" label={p.photoBrief?.[lang]} tone={isGift ? 'gold' : 'sand'} />}
      </div>
      <div>
        {isPlanned
          ? <p class="price">{de ? 'Geplante Edition' : fr ? 'Édition prévue' : 'Planned edition'}</p>
          : <p class="price">{p.price ? `${p.price.toFixed(2).replace('.', de ? ',' : '.')} €` : (p.priceNote?.[lang] ?? t.priceTbd)}</p>}
        {p.tagline && <p class="tagline">{p.tagline}</p>}
        <p>{p.description[lang]}</p>
        {p.details && (
          <dl class="kv">{p.details.map((d) => <><dt>{d.label[lang]}</dt><dd>{d.value[lang]}</dd></>)}</dl>
        )}
        <div class="btn-row" style="margin-top:1.5rem">
          {orderable && <a class="btn btn--gold" href="#order-h">{isGift ? (de ? 'Spendengeschenk bestellen' : fr ? 'Commander le don-cadeau' : 'Order this gift') : t.buy}</a>}
          {isGift && <a class="btn btn--outline" href={r('donate', lang, `?ref=${encodeURIComponent(p.donationReference ?? '')}`)}>{de ? 'Lieber online spenden' : fr ? 'Préférer le don en ligne' : 'Donate online instead'}</a>}
          {!isGift && canBuy && <a class="btn btn--gold" href={p.checkoutUrl} rel="noopener">{t.buy}</a>}
          {!isGift && !isPlanned && !orderable && !canBuy && <a class="btn btn--dark" href={mail}>{t.notify}</a>}
          {story && <a class="btn btn--outline" href="#h-story">{de ? 'Zur Geschichte' : fr ? 'Lire l’histoire' : 'Read the story'}</a>}
          {isPlanned && <a class="btn btn--outline" href={r('shop', lang, '#uganda-collection')}>{de ? 'Alle Editionen' : fr ? 'Toutes les éditions' : 'All editions'}</a>}
          {p.project && <a class="btn btn--outline" href={projectPath(lang, p.project)}>{de ? 'Zum Projekt' : fr ? 'À propos du projet' : 'About the project'}</a>}
        </div>
        {isPlanned
          ? <p class="notice" style="margin-top:1.25rem">{de
            ? 'Diese Edition ist in Vorbereitung und noch nicht bestellbar. Röstung, Preis und Verfügbarkeit stehen noch nicht fest. Vormerken können Sie schon jetzt Roots & Routes und Kanungu Forest.'
            : fr ? 'Cette édition est en préparation et pas encore disponible. Torréfaction, prix et disponibilité ne sont pas encore fixés. Vous pouvez déjà réserver Roots & Routes et Kanungu Forest.'
            : 'This edition is in preparation and not yet available to order. Roast, price and availability are not yet fixed. You can already reserve Roots & Routes and Kanungu Forest.'}</p>
          : !isGift && !orderable && !canBuy && <p class="notice" style="margin-top:1.25rem">{t.shopClosedNote}</p>}
      </div>
    </div>
  </section>
  {story && (
    <section class="section section--tight section--alt story" aria-labelledby="h-story">
      <div class="wrap story__wrap">
        <h2 id="h-story">{storyTitle}</h2>
        {story.paragraphs.map((para, i) => <p class:list={{ lead: i === 0 }}>{para[lang]}</p>)}
        {story.sayings && story.sayings.length > 0 && (
          <figure class="sayings">
            <figcaption class="sayings__label">{story.sayings.length > 1 ? (de ? 'In den Sprachen der Region' : fr ? 'Dans les langues de la région' : 'In the languages of the region') : (de ? 'Leitspruch' : fr ? 'Devise' : 'Guiding words')}</figcaption>
            {story.sayings.map((s) => (
              <blockquote class="saying">
                <p class="saying__text">{de ? '„' : fr ? '« ' : '“'}<span lang={s.lang}>{s.text}</span>{de ? '“' : fr ? ' »' : '”'}</p>
                <p class="saying__meta">{s.language[lang]}{s.meaning && <>: {s.meaning[lang]}</>}</p>
              </blockquote>
            ))}
          </figure>
        )}
        {story.aims && story.aims.length > 0 && (
          <>
            <h3>{de ? 'Was diese Edition bewirken soll' : fr ? 'Ce que cette édition veut soutenir' : 'What this edition aims to support'}</h3>
            <ul class="aims">{story.aims.map((a) => <li>{a[lang]}</li>)}</ul>
          </>
        )}
      </div>
    </section>
  )}
  {collection.length > 1 && (
    <section class="section section--tight" aria-labelledby="h-collection">
      <div class="wrap">
        <h2 id="h-collection" class="collection-nav__title">{de ? 'Alle Editionen der Uganda Collection' : fr ? 'Toutes les éditions de la Uganda Collection' : 'All editions of the Uganda Collection'}</h2>
        <ol class="collection-nav" role="list">
          {collection.map((x) => (
            <li>
              {x.slug === p.slug
                ? <span class="collection-nav__item is-current" aria-current="page"><span class="collection-nav__no">{String(x.edition).padStart(2, '0')}</span> {x.editionName}</span>
                : <a class="collection-nav__item" href={productPath(lang, x.slug)}><span class="collection-nav__no">{String(x.edition).padStart(2, '0')}</span> {x.editionName}{x.status === 'planned' && <span class="sr-only">{de ? ' (geplant)' : fr ? ' (prévue)' : ' (planned)'}</span>}</a>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {orderable && (
    <section class="section section--tight section--alt">
      <div class="wrap order-wrap"><OrderForm lang={lang} product={p} /></div>
    </section>
  )}
</Base>
<style>
  .product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .product__media { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); }
  .price { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; margin-bottom: .75rem; }
  @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
  .order-wrap { max-width: 52rem; }
  .tagline { font-weight: 600; color: var(--muted); margin: -.4rem 0 .9rem; letter-spacing: .02em; }
  .story__wrap { max-width: 52rem; }
  .story h2 { margin-bottom: 1rem; }
  .story h3 { margin: 2rem 0 .75rem; font-size: 1.2rem; }
  .sayings { margin: 1.75rem 0 0; padding: 1.25rem 1.5rem; border-left: 4px solid var(--accent-text); background: var(--surface); border-radius: 0 14px 14px 0; }
  .sayings__label { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: .5rem; }
  .saying { margin: 0; padding: 0; border: 0; font-style: normal; background: none; }
  .saying + .saying { margin-top: .9rem; }
  .saying__text { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 700; margin: 0 0 .2rem; }
  .saying__meta { margin: 0; color: var(--muted); font-family: var(--font-sans); font-size: 1rem; }
  .aims { margin: 0; padding-left: 1.25rem; }
  .aims li + li { margin-top: .35rem; }
  .collection-nav__title { font-size: clamp(1.2rem, 2.2vw, 1.45rem); margin-bottom: 1rem; }
  .collection-nav { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .collection-nav__item { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; padding: .4rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); text-decoration: none; font-size: .95rem; }
  a.collection-nav__item:hover, a.collection-nav__item:focus-visible { border-color: var(--ink); }
  .collection-nav__item.is-current { background: var(--ink); color: var(--bg); border-color: var(--ink); font-weight: 700; }
  .collection-nav__no { font-variant-numeric: tabular-nums; font-size: .8rem; opacity: .75; }
  .order-wrap :global(.order) { margin-top: 0; }
</style>
