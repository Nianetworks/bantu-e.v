---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { href, r, type Lang } from '../i18n';
import { downloads, groups, withVersion } from '../data/downloads';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const title = 'Downloads';
const lead = de ? 'Berichte, Formulare, Flyer und Logos von Bantu e.V.' : fr ? 'Rapports, formulaires, dépliants et logos de Bantu e.V.' : 'Reports, forms, flyers and logos of Bantu e.V.';
---
<Base lang={lang} title={title} description={lead} altHref={r('downloads', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead} crumbs={[{ label: de ? 'Wirkung' : fr ? 'Impact' : 'Impact', href: r('impact', lang) }]} />
  <section class="section section--tight">
    <div class="wrap dl-groups">
      {groups.map((g) => (
        <section class="dl-group">
          <h2>{g.title[lang]}</h2>
          {g.intro && <p class="muted">{g.intro[lang]}{g.link && <> <a href={r(g.link.route, lang)}>{g.link.label[lang]}</a></>}</p>}
          <ul class="dl-list">
            {downloads.filter((d) => d.group === g.id).map((d) => (
              <li>
                <a href={withVersion(href(d.file), d.version)} download>
                  <span class="dl-ext">{d.file.split('.').pop()!.toUpperCase()}</span>
                  <span class="dl-title">{d.title[lang]}</span>
                  <span class="dl-meta">{d.lang} · {d.size}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="notice notice--info">{de ? 'Sie suchen ein Dokument, das hier fehlt (z. B. Satzung oder Freistellungsbescheid)? Schreiben Sie uns an info@bantu-ev.org.' : fr ? 'Vous cherchez un document qui ne figure pas ici (par exemple les statuts ou l’avis d’exonération) ? Écrivez à info@bantu-ev.org.' : 'Looking for a document that is not listed (e.g. statutes or tax exemption notice)? Write to info@bantu-ev.org.'}</div>
    </div>
  </section>
</Base>
<style>
  .dl-groups { display: grid; gap: 2.5rem; }
  .dl-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: .6rem; }
  .dl-list li { margin: 0; }
  .dl-list a { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: .9rem; align-items: center; padding: .85rem 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); }
  .dl-list a:hover { border-color: var(--gold); }
  .dl-ext { grid-row: 1 / 3; background: var(--ink); color: var(--bg); font-size: .7rem; font-weight: 700; border-radius: 6px; padding: .35rem .45rem; }
  .dl-title { font-weight: 600; }
  .dl-meta { font-size: .8rem; color: var(--muted); }
</style>
