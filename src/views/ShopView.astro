---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import ProductImage from '../components/ProductImage.astro';
import { href, productPath, r, ui, type Lang } from '../i18n';
import { categories, products } from '../data/shop';
import { features, org } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const title = 'Shop';
const lead = de
  ? 'Kaufen und schenken mit Sinn: Die Erlöse unseres kleinen Shops kommen den Projekten von Bantu e.V. zugute.'
  : fr ? 'Acheter et offrir avec du sens : les recettes de notre petite boutique soutiennent les projets de Bantu e.V.' : 'Shop and give with purpose: proceeds from our small shop support the projects of Bantu e.V.';
const tones = { gifts: 'gold', coffee: 'sand', merch: 'blue', crafts: 'green' } as const;
---
<Base lang={lang} title={title} description={lead} altHref={r('shop', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <nav class="cat-nav" aria-label={de ? 'Kategorien' : fr ? 'Catégories' : 'Categories'}>
      {categories.map((c) => <a class="tag" href={`#${c.id}`}>{c.name[lang]}</a>)}
    </nav>
  </PageHead>

  {!features.shopCheckoutOpen && (
    <div class="wrap" style="margin-top:1.5rem"><p class="notice">{t.shopClosedNote} {de ? 'Spendengeschenke können Sie schon jetzt bestellen: per Überweisung mit persönlichem Verwendungszweck und QR-Code für Ihre Banking-App.' : fr ? 'Vous pouvez déjà commander des dons-cadeaux : par virement, avec un motif personnel et un code QR pour votre application bancaire.' : 'You can already order gift donations: by bank transfer, with a personal payment reference and a QR code for your banking app.'}</p></div>
  )}

  {categories.map((c, i) => {
    const items = products.filter((p) => p.category === c.id);
    return (
      <section class={`section section--tight ${i % 2 ? 'section--alt' : ''}`} id={c.id}>
        <div class="wrap">
          <div class="section-head"><div><h2>{c.name[lang]}</h2><p>{c.intro[lang]}</p></div></div>
          {items.length > 0 ? (
            <div class={`grid ${c.id === 'coffee' ? 'grid--2' : 'grid--3'}`}>
              {items.map((p) => (
                <article class="card card--link">
                  {p.image ? <ProductImage product={p} lang={lang} /> : <Placeholder lang={lang} ratio="4 / 3" tone={tones[c.id]} label={p.photoBrief?.[lang]} compact={c.id === 'gifts'} />}
                  <div class="card__body">
                    <div class="card__meta">
                      <span class={`tag ${p.status === 'available' ? 'tag--active' : 'tag--planned'}`}>{p.status === 'available' ? (c.id === 'gifts' ? (de ? 'Jetzt möglich' : fr ? 'Disponible dès maintenant' : 'Available now') : (de ? 'Verfügbar' : fr ? 'Disponible' : 'Available')) : t.comingSoon}</span>
                    </div>
                    <h3><a class="stretched" href={productPath(lang, p.slug)}>{p.name[lang]}</a></h3>
                    <p>{p.short[lang]}</p>
                    <div class="card__foot price">{p.price ? `${p.price.toFixed(2).replace('.', de ? ',' : '.')} €` : (p.priceNote?.[lang] ?? t.priceTbd)}</div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="panel empty">
              <p>{de ? 'Handgemachte Produkte unserer Partner*innen folgen. Sie möchten informiert werden, sobald es losgeht?' : fr ? 'Les produits artisanaux de nos partenaires suivront. Souhaitez-vous être prévenu de leur disponibilité ?' : 'Handmade products by our partners will follow. Would you like to be notified when they are available?'}</p>
              <a class="btn btn--outline" href={`mailto:${org.email}?subject=${encodeURIComponent(de ? 'Shop: Handwerk vormerken' : fr ? 'Boutique : me prévenir pour l’artisanat' : 'Shop: notify me about crafts')}`}>{t.notify}</a>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <section class="section section--tight">
    <div class="wrap small muted shop-legal">
      <p>{de
        ? 'Spendengeschenke sind Spenden an Bantu e.V. und keine Käufe; auf Wunsch erhalten Sie eine Zuwendungsbestätigung. Für Waren gelten nach Eröffnung des Shops unsere AGB, die Widerrufsbelehrung und die Versandbedingungen.'
        : fr ? 'Les dons-cadeaux sont des dons à Bantu e.V., pas des achats ; nous délivrons un reçu fiscal sur demande. À l’ouverture de la boutique, nos conditions générales, notre politique de rétractation et nos conditions de livraison s’appliqueront aux marchandises.' : 'Gift donations are donations to Bantu e.V., not purchases; we issue a donation receipt on request. Once the shop opens, our terms and conditions, cancellation policy and shipping terms apply to goods.'}</p>
    </div>
  </section>
</Base>
<style>
  .cat-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
  .cat-nav .tag { text-decoration: none; font-size: .9rem; padding: .35rem .8rem; background: var(--surface); }
  .price { font-weight: 700; color: var(--ink); }
  .empty { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .empty p { margin: 0; max-width: 60ch; }
</style>
