---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import ProductImage from '../components/ProductImage.astro';
import ProductGallery from '../components/ProductGallery.astro';
import { href, newsPath, productPath, r, ui, type Lang } from '../i18n';
import { getEntry } from 'astro:content';
import { categories, products } from '../data/shop';
import { features, org } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const title = 'Shop';
const lead = de
  ? 'Kaufen und schenken mit Sinn: Die Erlöse unseres kleinen Shops kommen den Projekten von Bantu e.V. zugute.'
  : fr ? 'Acheter et offrir avec du sens : les recettes de notre petite boutique soutiennent les projets de Bantu e.V.' : 'Shop and give with purpose: proceeds from our small shop support the projects of Bantu e.V.';
const tones = { gifts: 'gold', coffee: 'sand', merch: 'blue', crafts: 'green' } as const;
// Symbolic gifts (donations) are not shown in the shop; they live on the donate page (chair, 08.11.2026).
const shopCategories = categories.filter((c) => c.id !== 'gifts');
// Coffee cupping with our partner Symple Coffee Roasters (28.09.2026): photos and link to the report in the coffee section (chair, 09.11.2026)
const cuppingSlug = 'kaffee-cupping-symple-coffee-roasters';
const cupping = await getEntry('news', `${lang}/${cuppingSlug}`);
const cuppingPhotos = cupping ? [
  { src: cupping.data.image!.replace(/\.jpg$/, ''), width: 1600, height: 900, alt: cupping.data.imageAlt ?? '', caption: undefined as string | undefined },
  ...cupping.data.photos.filter((ph) => ph.src.endsWith('vor-dem-cafe')),
] : [];
---
<Base lang={lang} title={title} description={lead} altHref={r('shop', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <nav class="cat-nav" aria-label={de ? 'Kategorien' : fr ? 'Catégories' : 'Categories'}>
      {shopCategories.map((c) => <a class="tag" href={`#${c.id}`}>{c.name[lang]}</a>)}
    </nav>
  </PageHead>

  {!features.shopCheckoutOpen && (
    <div class="wrap" style="margin-top:1.5rem"><p class="notice">{t.shopClosedNote}</p></div>
  )}

  {shopCategories.map((c, i) => {
    const items = products.filter((p) => p.category === c.id && p.status !== 'planned');
    // ABANTU COFFEE: further editions as a preview. Not used at present: the eight hidden editions stay off the website
    // (shop.ts → showPlannedEditions = false; chair, 09.11. and 10.11.2026).
    const planned = products.filter((p) => p.category === c.id && p.status === 'planned').sort((a, b) => (a.edition ?? 0) - (b.edition ?? 0));
    return (
      <section class={`section section--tight ${i % 2 ? 'section--alt' : ''}`} id={c.id}>
        <div class="wrap">
          <div class="section-head"><div><h2>{c.name[lang]}</h2><p>{c.intro[lang]}</p></div></div>
          {c.id === 'coffee' && items.some((p) => p.labels) && (
            <p class="flip-hint">{de
              ? 'Jede Edition hat ihren eigenen Beutel; zu sehen sind Verpackungsvorschauen. Der Pfeil rechts neben dem Beutel dreht die Packung um: So sehen Sie das Etikett der Rückseite.'
              : fr ? 'Chaque édition a son propre sachet ; vous voyez ici des aperçus de l’emballage. La flèche à droite du sachet le retourne : vous voyez ainsi l’étiquette du dos, rédigée en allemand.'
              : 'Every edition has its own bag; what you see are packaging previews. The arrow to the right of the bag turns the pack over, so you can see the back label, which is printed in German.'}</p>
          )}
          {items.length > 0 ? (
            <div class={`grid ${c.id === 'coffee' ? 'coffee-grid' : 'grid--3'}`}>
              {items.map((p) => (
                <article class="card card--link">
                  {p.labels ? <ProductGallery product={p} lang={lang} variant="card" /> : p.image ? <ProductImage product={p} lang={lang} /> : <Placeholder lang={lang} ratio="4 / 3" tone={tones[c.id]} label={p.photoBrief?.[lang]} compact={c.id === 'gifts'} />}
                  <div class="card__body">
                    <div class="card__meta">
                      <span class={`tag ${p.status === 'available' ? 'tag--active' : 'tag--planned'}`}>{p.sample ? (de ? 'Muster · in Vorbereitung' : fr ? 'Échantillon · en préparation' : 'Sample · in preparation') : p.status === 'available' ? (c.id === 'gifts' ? (de ? 'Jetzt möglich' : fr ? 'Disponible dès maintenant' : 'Available now') : (de ? 'Verfügbar' : fr ? 'Disponible' : 'Available')) : t.comingSoon}</span>
                    </div>
                    <h3><a class="stretched" href={productPath(lang, p.slug)}>{p.name[lang]}</a></h3>
                    <p>{p.short[lang]}</p>
                    <div class="card__foot price">{p.price ? `${p.price.toFixed(2).replace('.', de ? ',' : '.')} €` : (p.priceNote?.[lang] ?? t.priceTbd)}</div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="panel empty">
              <p>{de ? 'Handgemachte Produkte unserer Partner*innen folgen. Sie möchten informiert werden, sobald es losgeht?' : fr ? 'Les produits artisanaux de nos partenaires suivront. Souhaitez-vous être prévenu de leur disponibilité ?' : 'Handmade products by our partners will follow. Would you like to be notified when they are available?'}</p>
              <a class="btn btn--outline" href={`mailto:${org.email}?subject=${encodeURIComponent(de ? 'Shop: Handwerk vormerken' : fr ? 'Boutique : me prévenir pour l’artisanat' : 'Shop: notify me about crafts')}`}>{t.notify}</a>
            </div>
          )}
          {c.id === 'coffee' && cupping && !cupping.data.draft && (
            <div class="cupping">
              <div class="cupping__text">
                <h3>{cupping.data.title}</h3>
                <p>{cupping.data.summary}</p>
                <div class="cupping__links">
                  <a class="link-arrow" href={newsPath(lang, cuppingSlug)}>{de ? 'Zum Bericht' : fr ? 'Lire le compte rendu' : 'Read the report'}</a>
                  {cupping.data.poster && <a class="link-arrow" href={href(`${cupping.data.poster.src}.jpg`)}>{de ? 'Plakat ansehen' : fr ? 'Voir l’affiche' : 'View the poster'}</a>}
                </div>
              </div>
              <div class="cupping__photos">
                {cuppingPhotos.map((ph) => (
                  <figure class:list={['cupping__photo', { 'cupping__photo--wide': ph.width > ph.height }]}>
                    <picture>
                      <source type="image/webp" srcset={`${href(`${ph.src}-800.webp`)} 800w, ${href(`${ph.src}-${ph.width}.webp`)} ${ph.width}w`} sizes={ph.width > ph.height ? '(max-width: 900px) calc(100vw - 2rem), 640px' : '(max-width: 900px) 45vw, 300px'} />
                      <img src={href(`${ph.src}.jpg`)} alt={ph.alt} width={ph.width} height={ph.height} loading="lazy" decoding="async" />
                    </picture>
                    {ph.caption && <figcaption>{ph.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          )}
          {planned.length > 0 && (
            <div class="collection" id="uganda-collection">
              <h3 class="collection__title">{de ? 'Die Uganda Collection: weitere Editionen in Vorbereitung' : fr ? 'La Uganda Collection : d’autres éditions en préparation' : 'The Uganda Collection: more editions in preparation'}</h3>
              <p class="collection__intro">{de
                ? 'Die weiteren Editionen der Uganda Collection sind in Vorbereitung; Preis und Verfügbarkeit stehen noch nicht fest.'
                : fr ? 'Les autres éditions de la Uganda Collection sont en préparation ; prix et disponibilité ne sont pas encore fixés.'
                : 'The other editions of the Uganda Collection are in preparation; price and availability are not yet fixed.'}</p>
              <ul class="collection__list" role="list">
                {planned.map((p) => (
                  <li class="card card--link">
                    {p.labels && <ProductGallery product={p} lang={lang} variant="card" />}
                    <div class="card__body">
                      <div class="card__meta"><span class="tag tag--planned">{de ? 'Geplant · Nr.' : fr ? 'Prévue · n°' : 'Planned · No.'} {String(p.edition).padStart(2, '0')}</span></div>
                      <h4><a class="stretched" href={productPath(lang, p.slug)}>{p.editionName}</a></h4>
                      <p class="collection__tagline">{p.tagline}</p>
                      <p class="small muted">{((place) => place.charAt(0).toUpperCase() + place.slice(1))(p.short[lang].split(' · ').slice(1).join(' · '))}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <section class="section section--tight">
    <div class="wrap small muted shop-legal">
      <p>{de
        ? 'Für Waren gelten nach Eröffnung des Shops unsere AGB, die Widerrufsbelehrung und die Versandbedingungen.'
        : fr ? 'À l’ouverture de la boutique, nos conditions générales, notre politique de rétractation et nos conditions de livraison s’appliqueront aux marchandises.' : 'Once the shop opens, our terms and conditions, cancellation policy and shipping terms apply to goods.'}</p>
    </div>
  </section>
</Base>
<style>
  .cat-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
  .cat-nav .tag { text-decoration: none; font-size: .9rem; padding: .35rem .8rem; background: var(--surface); }
  .price { font-weight: 700; color: var(--ink); }
  /* ABANTU COFFEE: one card per edition with its front/back label viewer. Phones 1 column, tablets 2, wide screens 4. */
  .coffee-grid { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 560px) { .coffee-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .coffee-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .coffee-grid .card__body { padding: 1rem 1.1rem 1.25rem; }
  .flip-hint { margin: -.5rem 0 1.25rem; max-width: 70ch; color: var(--ink-2); }
  .empty { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .empty p { margin: 0; max-width: 60ch; }
  .cupping { margin-top: clamp(2rem, 5vw, 3rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(1.25rem, 3vw, 2rem); align-items: center; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .cupping__text h3 { font-size: clamp(1.2rem, 2.2vw, 1.45rem); margin: 0 0 .6rem; }
  .cupping__text p { margin: 0 0 1rem; }
  .cupping__links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  /* 16:9 next to 3:4 at the same height, nothing cropped */
  .cupping__photos { display: grid; grid-template-columns: minmax(0, 2.37fr) minmax(0, 1fr); gap: .75rem; align-items: start; }
  .cupping__photo { margin: 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--bg); }
  .cupping__photo picture, .cupping__photo img { display: block; width: 100%; height: auto; }
  .cupping__photo figcaption { padding: .5rem .75rem; font-size: .85rem; line-height: 1.4; color: var(--muted); }
  @media (max-width: 900px) { .cupping { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .cupping__photos { grid-template-columns: 1fr; } .cupping__photo:not(.cupping__photo--wide) { max-width: 22rem; } }
  .collection { margin-top: clamp(2.5rem, 6vw, 4rem); padding-top: clamp(1.5rem, 4vw, 2.5rem); border-top: 1px solid var(--line); }
  .collection__title { font-size: clamp(1.3rem, 2.4vw, 1.6rem); margin-bottom: .5rem; }
  .collection__intro { max-width: 70ch; margin-bottom: 1.5rem; }
  .collection__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 720px) { .collection__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }
  @media (min-width: 1000px) { .collection__list { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .collection__list .card__body { padding: .9rem 1rem 1.1rem; }
  .collection__list h4 { font-size: 1.1rem; margin: .35rem 0 .15rem; }
  .collection__tagline { font-weight: 600; margin: 0 0 .25rem; }
  .collection__list .small { margin: 0; }
</style>
