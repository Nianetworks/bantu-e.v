---
// Accessibility page = the formal statement (policy-content.ts, reviewed 10.11.2026) + the practical guide that was
// on this page before: button to open the display settings, the list of display functions and keyboard /
// screen-reader tips. Claims here stay within what the site actually does; the speech wording follows the
// reviewed statement (voices may work online), and the menu tips follow the compact header of 10.11.2026.
import PolicyView from './PolicyView.astro';
import Icon from '../components/Icon.astro';
import { r, ui, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const guideId = de ? 'anpassen' : fr ? 'adapter' : 'adjust';
const keysId = de ? 'tastatur' : fr ? 'clavier' : 'keyboard';
const guideTitle = de ? 'So passen Sie die Website an' : fr ? 'Comment adapter le site' : 'How to adjust the website';
const keysTitle = de ? 'Mit Tastatur und Screenreader' : fr ? 'Avec le clavier et un lecteur d’écran' : 'With keyboard and screen reader';
const features = de
  ? [
      ['text', 'Schrift vergrößern', 'In vier Stufen bis 150 %. Das Layout passt sich an. Zusätzlich funktioniert der Zoom Ihres Browsers (Strg/Cmd und +).'],
      ['contrast', 'Hoher Kontrast und dunkle Ansicht', 'Gelbe und weiße Schrift auf Schwarz oder eine augenschonende dunkle Ansicht.'],
      ['easy', 'Gut lesbare Schrift', 'Atkinson Hyperlegible, entwickelt vom Braille Institute für Menschen mit Sehbehinderung.'],
      ['spacing', 'Mehr Abstand', 'Größerer Zeilen-, Wort- und Buchstabenabstand erleichtert das Lesen, zum Beispiel bei Legasthenie.'],
      ['link', 'Links hervorheben', 'Alle Links werden unterstrichen und farbig hinterlegt.'],
      ['pause', 'Bewegung stoppen', 'Animationen werden abgeschaltet, auch die Foto-Diashow auf der Startseite. Sie lässt sich außerdem jederzeit mit „Pause“ anhalten und mit den Pfeil-Knöpfen Bild für Bild ansehen. Die Einstellung „Bewegung reduzieren“ Ihres Geräts wird berücksichtigt.'],
      ['speaker', 'Seite vorlesen', 'Ihr Browser liest den Inhalt der Seite vor. Je nach Browser und Stimme kann die Sprachausgabe einen Onlinedienst verwenden; Hinweise dazu stehen oben und in der Datenschutzerklärung.'],
    ]
  : fr
  ? [
      ['text', 'Agrandir le texte', 'En quatre niveaux jusqu’à 150 %. La mise en page s’adapte. Le zoom de votre navigateur (Ctrl/Cmd et +) fonctionne aussi.'],
      ['contrast', 'Contraste élevé et mode sombre', 'Texte jaune et blanc sur fond noir, ou un affichage sombre qui ménage les yeux.'],
      ['easy', 'Police facile à lire', 'Atkinson Hyperlegible, conçue par le Braille Institute pour les personnes malvoyantes.'],
      ['spacing', 'Plus d’espacement', 'Un interligne et des espaces plus grands facilitent la lecture, par exemple en cas de dyslexie.'],
      ['link', 'Mettre les liens en évidence', 'Tous les liens sont soulignés et surlignés.'],
      ['pause', 'Arrêter les animations', 'Les animations sont désactivées, y compris le diaporama de la page d’accueil. On peut aussi l’arrêter à tout moment avec « Pause » et le parcourir photo par photo avec les flèches. Le réglage « réduire les animations » de votre appareil est respecté.'],
      ['speaker', 'Lire la page à voix haute', 'Votre navigateur lit la page à voix haute. Selon le navigateur et la voix, la lecture peut utiliser un service en ligne ; voir plus haut et la politique de confidentialité.'],
    ]
  : [
      ['text', 'Bigger text', 'In four steps up to 150%. The layout adapts. Your browser’s zoom (Ctrl/Cmd and +) also works.'],
      ['contrast', 'High contrast and dark mode', 'Yellow and white text on black, or a gentle dark view.'],
      ['easy', 'Easy-to-read font', 'Atkinson Hyperlegible, designed by the Braille Institute for people with low vision.'],
      ['spacing', 'More spacing', 'Larger line, word and letter spacing makes reading easier, for example with dyslexia.'],
      ['link', 'Highlight links', 'All links are underlined and highlighted.'],
      ['pause', 'Stop motion', 'Animations are switched off, including the photo slideshow on the home page. It can also be stopped at any time with “Pause” and browsed photo by photo with the arrow buttons. Your device’s “reduce motion” setting is respected.'],
      ['speaker', 'Read page aloud', 'Your browser reads the page aloud. Depending on the browser and voice, speech may use an online service; see above and the privacy policy.'],
    ];
const keys = de
  ? [
      ['Sprunglinks:', `Mit der Tabulatortaste erscheinen zuerst die Links „${t.skip}“, „${t.skipNav}“ und „${t.skipFooter}“.`],
      ['Menüs', 'öffnen Sie mit Enter oder Leertaste und schließen sie mit Escape. Auf Handy und Tablet öffnet der Knopf „Menü“ die Navigation mit Suche, allen Bereichen, „Mehr“ (Neuigkeiten, Veranstaltungen, Shop, Kontakt) sowie Barrierefreiheit und Sprache; Escape schließt sie wieder.'],
      ['Darstellung anpassen:', 'Den Knopf „Barrierefreiheit“ finden Sie am Computer oben auf jeder Seite, auf Handy und Tablet im Menü.'],
      ['Überschriften und Bereiche', 'sind ausgezeichnet, damit Screenreader direkt dorthin springen können.'],
      ['Bilder', 'haben Alternativtexte; rein dekorative Grafiken werden für Screenreader ausgeblendet.'],
      ['Links in neuem Fenster', 'werden angesagt.'],
      ['Suche:', 'Das Suchfeld ist beschriftet. Die Suche läuft mit Dateien von unserem eigenen Server in Ihrem Browser.'],
      ['Formulare', '(Kontakt, Bestellung, Bildungspatenschaft) haben sichtbare Beschriftungen; Pflichtfelder sind markiert.'],
      ['Sprache:', 'Deutsche, englische und französische Seiten sind entsprechend gekennzeichnet, damit die Sprachausgabe richtig ausspricht.'],
    ]
  : fr
  ? [
      ['Liens d’accès rapide :', `avec la touche Tab apparaissent d’abord « ${t.skip} », « ${t.skipNav} » et « ${t.skipFooter} ».`],
      ['Les menus', 's’ouvrent avec Entrée ou Espace et se ferment avec Échap. Sur téléphone et tablette, le bouton « Menu » ouvre la navigation avec la recherche, toutes les rubriques, « Plus » (actualités, événements, boutique, contact) ainsi que l’accessibilité et la langue ; Échap la referme.'],
      ['Adapter l’affichage :', 'le bouton « Accessibilité » se trouve en haut de chaque page sur ordinateur, et dans le menu sur téléphone et tablette.'],
      ['Titres et zones', 'sont balisés pour que les lecteurs d’écran puissent y accéder directement.'],
      ['Les images', 'ont des alternatives textuelles ; les graphiques purement décoratifs sont masqués pour les lecteurs d’écran.'],
      ['Les liens qui ouvrent une nouvelle fenêtre', 'sont annoncés.'],
      ['Recherche :', 'le champ de recherche est étiqueté. La recherche s’exécute dans votre navigateur avec des fichiers de notre propre serveur.'],
      ['Formulaires', '(contact, commande, parrainage éducatif) : étiquettes visibles, champs obligatoires marqués.'],
      ['Langue :', 'les pages en allemand, en anglais et en français sont balisées pour que la synthèse vocale les prononce correctement.'],
    ]
  : [
      ['Skip links:', `press Tab to reveal “${t.skip}”, “${t.skipNav}” and “${t.skipFooter}”.`],
      ['Menus', 'open with Enter or Space and close with Escape. On phones and tablets the “Menu” button opens the navigation with search, all sections, “More” (news, events, shop, contact) and accessibility and language; Escape closes it.'],
      ['Adjust the display:', 'the “Accessibility” button is at the top of every page on a computer, and inside the menu on phones and tablets.'],
      ['Headings and regions', 'are marked up so screen readers can jump to them directly.'],
      ['Images', 'have text alternatives; purely decorative graphics are hidden from screen readers.'],
      ['Links that open a new window', 'are announced.'],
      ['Search:', 'the search box is labelled. Search runs in your browser using files from our own server.'],
      ['Forms', '(contact, order, education sponsorship) have visible labels; required fields are marked.'],
      ['Language:', 'German, English and French pages are marked so speech output pronounces them correctly.'],
    ];
---
<PolicyView lang={lang} page="accessibility" extraToc={[{ id: guideId, heading: guideTitle }, { id: keysId, heading: keysTitle }]}>
  <div slot="head" class="btn-row" style="margin-top:1.25rem">
    <button type="button" class="btn btn--gold" data-a11y-toggle aria-haspopup="dialog" aria-controls="a11y-panel"><Icon name="access" /> {de ? 'Darstellung jetzt anpassen' : fr ? 'Adapter l’affichage maintenant' : 'Adjust the display now'}</button>
    <a class="btn btn--outline" href={r('easy', lang)}><Icon name="easy" /> {t.easy}</a>
  </div>
  <Fragment slot="after">
    <section class="section section--alt" aria-labelledby={guideId}>
      <div class="wrap">
        <h2 id={guideId} class="guide-h">{guideTitle}</h2>
        <p class="lead">{de ? 'Ihre Einstellungen werden nur in Ihrem Browser gespeichert und gelten für alle Seiten, bis Sie sie zurücksetzen.' : fr ? 'Vos réglages sont enregistrés uniquement dans votre navigateur et s’appliquent à toutes les pages jusqu’à ce que vous les réinitialisiez.' : 'Your settings are stored only in your browser and apply to every page until you reset them.'}</p>
        <ul class="features">
          {features.map(([icon, h, p]) => (
            <li class="panel"><span class="icon-badge"><Icon name={icon as any} /></span><div><h3>{h}</h3><p>{p}</p></div></li>
          ))}
        </ul>
      </div>
    </section>
    <section class="section" aria-labelledby={keysId}>
      <div class="narrow prose">
        <h2 id={keysId} class="guide-h">{keysTitle}</h2>
        <ul class="keys">
          {keys.map(([b, rest]) => <li><strong>{b}</strong> {rest}</li>)}
        </ul>
      </div>
    </section>
  </Fragment>
</PolicyView>
<style>
  .features { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1rem; }
  .features li { display: flex; gap: 1rem; align-items: flex-start; margin: 0; }
  .features h3 { font-family: var(--font-sans); font-size: 1.1rem; margin: .2rem 0 .3rem; }
  .features p { margin: 0; color: var(--ink-2); }
  .keys li { margin-bottom: .6rem; }
  .guide-h { scroll-margin-top: 12rem; }
</style>
