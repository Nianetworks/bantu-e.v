---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { r, type Lang } from '../i18n';
import { org } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const title = de ? 'Barrierefreiheit' : 'Accessibility';
const lead = de
  ? 'Unsere Website soll für alle Menschen gut nutzbar sein – auch für blinde und sehbehinderte Menschen, für Menschen mit motorischen oder kognitiven Einschränkungen und für alle, die mit dem Smartphone unterwegs sind.'
  : 'Our website should work well for everyone – including blind and partially sighted people, people with motor or cognitive impairments, and everyone using a phone.';
const features = de
  ? [
      ['text', 'Schrift vergrößern', 'In vier Stufen bis 150 % – das Layout passt sich an. Zusätzlich funktioniert der Browser-Zoom (Strg/Cmd und +) bis 400 %.'],
      ['contrast', 'Hoher Kontrast und dunkle Ansicht', 'Gelbe und weiße Schrift auf Schwarz oder eine augenschonende dunkle Ansicht.'],
      ['easy', 'Gut lesbare Schrift', 'Atkinson Hyperlegible – entwickelt vom Braille Institute für Menschen mit Sehbehinderung.'],
      ['spacing', 'Mehr Abstand', 'Größerer Zeilen-, Wort- und Buchstabenabstand erleichtert das Lesen, z. B. bei Legasthenie.'],
      ['link', 'Links hervorheben', 'Alle Links werden unterstrichen und farbig hinterlegt.'],
      ['pause', 'Bewegung stoppen', 'Animationen werden abgeschaltet, auch die Foto-Diashow auf der Startseite (sie lässt sich außerdem jederzeit mit „Pause“ anhalten). Wir respektieren auch die Einstellung „Bewegung reduzieren“ Ihres Geräts.'],
      ['speaker', 'Seite vorlesen', 'Ihr Browser liest den Inhalt der Seite vor. Die Sprachausgabe läuft auf Ihrem Gerät; es werden keine Daten an uns oder Dritte übertragen.'],
    ]
  : [
      ['text', 'Bigger text', 'In four steps up to 150% – the layout adapts. Browser zoom (Ctrl/Cmd and +) also works up to 400%.'],
      ['contrast', 'High contrast and dark mode', 'Yellow and white text on black, or a gentle dark view.'],
      ['easy', 'Easy-to-read font', 'Atkinson Hyperlegible – designed by the Braille Institute for people with low vision.'],
      ['spacing', 'More spacing', 'Larger line, word and letter spacing makes reading easier, e.g. with dyslexia.'],
      ['link', 'Highlight links', 'All links are underlined and highlighted.'],
      ['pause', 'Stop motion', 'Animations are switched off, including the photo slideshow on the home page (which can also be stopped at any time with “Pause”). We also respect your device’s “reduce motion” setting.'],
      ['speaker', 'Read page aloud', 'Your browser reads the page aloud. Speech runs on your device; no data is sent to us or anyone else.'],
    ];
---
<Base lang={lang} title={title} description={lead} altHref={r('accessibility', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <div class="btn-row" style="margin-top:1.25rem">
      <button type="button" class="btn btn--gold" data-a11y-toggle aria-expanded="false" aria-controls="a11y-panel"><Icon name="access" /> {de ? 'Darstellung jetzt anpassen' : 'Adjust the display now'}</button>
      <a class="btn btn--outline" href={r('easy', lang)}><Icon name="easy" /> {de ? 'Einfache Sprache' : 'Easy read'}</a>
    </div>
  </PageHead>

  <section class="section section--tight">
    <div class="wrap">
      <h2>{de ? 'So passen Sie die Website an' : 'How to adjust the website'}</h2>
      <p class="lead">{de ? 'Oben auf jeder Seite finden Sie den Knopf „Barrierefreiheit“. Ihre Einstellungen werden nur in Ihrem Browser gespeichert.' : 'You will find the “Accessibility” button at the top of every page. Your settings are only stored in your browser.'}</p>
      <ul class="features">
        {features.map(([icon, h, p]) => (
          <li class="panel"><span class="icon-badge"><Icon name={icon as any} /></span><div><h3>{h}</h3><p>{p}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap two-col">
      <div>
        <h2>{de ? 'Mit Tastatur und Screenreader' : 'With keyboard and screen reader'}</h2>
        <ul>
          {de ? (
            <>
              <li><strong>Sprunglinks:</strong> Mit der Tabulatortaste erscheinen zuerst Links „Zum Inhalt“, „Zur Navigation“ und „Zum Kontakt“.</li>
              <li><strong>Menüs</strong> öffnen Sie mit Enter oder Leertaste und schließen sie mit Escape.</li>
              <li><strong>Überschriften und Bereiche</strong> sind sauber ausgezeichnet – Screenreader wie NVDA, JAWS, VoiceOver und TalkBack können direkt dorthin springen.</li>
              <li><strong>Bilder</strong> haben Alternativtexte; rein dekorative Grafiken werden ausgeblendet.</li>
              <li><strong>Links in neuem Fenster</strong> werden angesagt.</li>
              <li><strong>Sprache:</strong> Deutsche und englische Seiten sind entsprechend gekennzeichnet, damit die Sprachausgabe richtig betont.</li>
            </>
          ) : (
            <>
              <li><strong>Skip links:</strong> press Tab to reveal “Skip to content”, “Skip to navigation” and “Skip to contact”.</li>
              <li><strong>Menus</strong> open with Enter or Space and close with Escape.</li>
              <li><strong>Headings and regions</strong> are properly marked up – screen readers such as NVDA, JAWS, VoiceOver and TalkBack can jump to them directly.</li>
              <li><strong>Images</strong> have text alternatives; purely decorative graphics are hidden.</li>
              <li><strong>Links that open a new window</strong> are announced.</li>
              <li><strong>Language:</strong> German and English pages are marked so speech output pronounces them correctly.</li>
            </>
          )}
        </ul>
      </div>
      <div>
        <h2>{de ? 'Was wir außerdem beachten' : 'What else we take care of'}</h2>
        <ul>
          {de ? (
            <>
              <li>Ziel ist die Konformität mit den <strong>WCAG 2.2, Stufe AA</strong> (Orientierung an der BITV 2.0).</li>
              <li>Ausreichende Farbkontraste (mind. 4,5 : 1 für Text) und sichtbarer Tastaturfokus.</li>
              <li>Schaltflächen und Links sind mindestens 44 × 44 Pixel groß.</li>
              <li>Keine Zeitlimits, keine automatisch startenden Videos oder Töne, keine Pop-ups.</li>
              <li>Keine Cookies und kein Tracking – kein Cookie-Banner, der im Weg steht.</li>
              <li>Die Inhalte sind auch ohne JavaScript lesbar.</li>
            </>
          ) : (
            <>
              <li>Our goal is conformance with <strong>WCAG 2.2, level AA</strong> (following the German BITV 2.0).</li>
              <li>Sufficient colour contrast (at least 4.5:1 for text) and a visible keyboard focus.</li>
              <li>Buttons and links are at least 44 × 44 pixels.</li>
              <li>No time limits, no auto-playing video or sound, no pop-ups.</li>
              <li>No cookies and no tracking – so no cookie banner in the way.</li>
              <li>Content is readable without JavaScript.</li>
            </>
          )}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <h2>{de ? 'Erklärung zur Barrierefreiheit' : 'Accessibility statement'}</h2>
        <p>{de ? 'Stand: 07.11.2026. Grundlage ist eine Selbstbewertung mit automatisierten Tests (axe-core) und manueller Prüfung mit Tastatur.' : 'Status: 7 November 2026. Based on a self-assessment with automated tests (axe-core) and manual keyboard testing.'}</p>
        <h3>{de ? 'Bekannte Einschränkungen' : 'Known limitations'}</h3>
        <ul>
          {de ? (
            <>
              <li>Einige PDF-Dokumente (Berichte, Formulare, Flyer) sind noch nicht vollständig barrierefrei. Auf Anfrage senden wir die Inhalte gern in einem zugänglichen Format.</li>
              <li>Flyer und Grafiken enthalten teilweise Text im Bild; die wichtigen Informationen stehen zusätzlich als Text auf der Seite.</li>
              <li>Viele Projektfotos fehlen noch; sie werden mit Alternativtexten ergänzt.</li>
              <li>Unsere Seite in Einfacher Sprache ist nicht von einer Prüfgruppe für Leichte Sprache geprüft.</li>
            </>
          ) : (
            <>
              <li>Some PDF documents (reports, forms, flyers) are not yet fully accessible. On request we will gladly send the content in an accessible format.</li>
              <li>Flyers and graphics partly contain text in images; the key information is also given as text on the page.</li>
              <li>Many project photos are still missing; they will be added with text alternatives.</li>
              <li>Our easy-read page has not been checked by an easy-language review group.</li>
            </>
          )}
        </ul>
      </div>
      <div class="panel feedback">
        <h2>{de ? 'Barriere gefunden?' : 'Found a barrier?'}</h2>
        <p>{de ? 'Wenn Ihnen etwas nicht zugänglich ist oder Sie Inhalte in einem anderen Format brauchen, melden Sie sich bitte – wir kümmern uns darum.' : 'If something is not accessible to you or you need content in another format, please get in touch – we will take care of it.'}</p>
        <p><a class="btn btn--dark" href={`mailto:${org.email}?subject=${encodeURIComponent(de ? 'Barriere auf der Website' : 'Accessibility barrier on the website')}`}><Icon name="mail" /> {org.email}</a></p>
        <p><a href={`tel:${org.phoneHref}`}><Icon name="phone" class="ic" /> {org.phone}</a></p>
      </div>
    </div>
  </section>
</Base>
<style>
  .features { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1rem; }
  .features li { display: flex; gap: 1rem; align-items: flex-start; margin: 0; }
  .features h3 { font-family: var(--font-sans); font-size: 1.1rem; margin: .2rem 0 .3rem; }
  .features p { margin: 0; color: var(--ink-2); }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .two-col li { margin-bottom: .6rem; }
  .feedback { border: 2px solid var(--ink); }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }
</style>
