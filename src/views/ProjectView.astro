---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import FundingNote from '../components/FundingNote.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { render } from 'astro:content';
import { href, projectPath, r, ui, type Lang } from '../i18n';
import { getNews, getProjects, slugOf, type Project } from '../lib/content';
import { programmeOfProject, programmePath, regions, regionPath } from '../data/programmes';

interface Props { lang: Lang; project: Project; hasAlt: boolean }
const { lang, project, hasAlt } = Astro.props;
const de = lang === 'de';
const t = ui[lang];
const d = project.data;
const slug = slugOf(project.id);
const { Content } = await render(project);
const prog = programmeOfProject(slug);
const related = prog
  ? (await getProjects(lang)).filter((p) => prog.projects.includes(slugOf(p.id)) && p.id !== project.id).slice(0, 3)
  : (await getProjects(lang)).filter((p) => p.data.programme === d.programme && p.id !== project.id).slice(0, 3);
const news = (await getNews(lang)).filter((n) => n.data.project === slug).slice(0, 3);
const otherLang: Lang = de ? 'en' : 'de';
const donateRef = slug.includes('pearl') ? 'Pearl Kita' : slug.includes('ruziba') ? 'Wasser Ruziba' : null;
---
<Base lang={lang} title={d.title} description={d.summary} altHref={hasAlt ? projectPath(otherLang, slug) : undefined} image={d.image}>
  <PageHead lang={lang} title={d.title} lead={d.subtitle} eyebrow={prog ? prog.title[lang] : t.programme[d.programme]}
    crumbs={[{ label: de ? 'Programme' : 'Programmes', href: r('programmes', lang) }, ...(prog ? [{ label: prog.title[lang], href: programmePath(lang, prog.key) }] : [])]}>
    <div class="head-tags">
      <span class={`tag tag--${d.status}`}><span class="dot" aria-hidden="true"></span>{t.projectStatus[d.status]}</span>
      <span class="tag">{d.country}</span>
      {d.code && <span class="tag">{d.code}</span>}
    </div>
  </PageHead>

  <section class="section section--tight">
    <div class="wrap project">
      <div class="project__main">
        <figure class="project__figure">
          {d.image
            ? <img src={href(d.image)} alt={d.imageAlt ?? ''} width="1200" height="750" />
            : <Placeholder lang={lang} label={d.photoBrief} tone={d.programme === 'international' ? 'gold' : 'blue'} />}
        </figure>
        <p class="lead">{d.summary}</p>
        {d.stats.length > 0 && (
          <div class="stat-grid project__stats">
            {d.stats.map((s) => <div class="stat"><div class="stat__value">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
          </div>
        )}
        <div class="prose"><Content /></div>
        <FundingNote lang={lang} note={d.fundingNote} logos={d.fundingLogos} disclaimer={d.disclaimer} funders={d.funders} />
      </div>
      <aside class="project__side">
        <div class="panel">
          <h2 class="side-title">{de ? 'Auf einen Blick' : 'At a glance'}</h2>
          <dl class="facts">
            <dt>{de ? 'Arbeitsbereich' : 'Area of work'}</dt><dd><a href={regionPath(lang, d.programme)}>{regions.find((rg) => rg.key === d.programme)!.title[lang]}</a></dd>
            {prog && <><dt>{de ? 'Programm' : 'Programme'}</dt><dd><a href={programmePath(lang, prog.key)}>{prog.title[lang]}</a></dd></>}
            <dt>{t.period}</dt><dd>{d.period}</dd>
            {d.implementer && <><dt>{de ? 'Umsetzung' : 'Implemented by'}</dt><dd>{d.implementer}{d.fiscalSponsorship && <> ({de ? 'Bantu e.V. als Trägerverein' : 'Bantu e.V. as fiscal sponsor'})</>}</dd></>}
            {d.location && <><dt>{t.location}</dt><dd>{d.location}</dd></>}
            <dt>{t.country}</dt><dd>{d.country}</dd>
            {d.code && <><dt>{t.code}</dt><dd>{d.code}</dd></>}
            {d.partners.length > 0 && <><dt>{t.partners}</dt><dd><ul>{d.partners.map((p) => <li>{p}</li>)}</ul></dd></>}
            {d.funders.length > 0 && <><dt>{t.funders}</dt><dd><ul>{d.funders.map((f) => <li>{f}</li>)}</ul></dd></>}
            {d.sdgs.length > 0 && <><dt>{t.sdgs}</dt><dd class="sdgs">{d.sdgs.map((n) => <span class="sdg">SDG {n}</span>)}</dd></>}
          </dl>
        </div>
        {d.status !== 'completed' && (
          <div class="panel side-cta">
            <h2 class="side-title">{de ? 'Projekt unterstützen' : 'Support this project'}</h2>
            <p>{donateRef
              ? (de ? `Spenden Sie mit dem Verwendungszweck „${donateRef}“.` : `Donate with the reference “${donateRef}”.`)
              : (de ? 'Ihre Spende hilft uns, Eigenanteile aufzubringen und Angebote kostenfrei zu halten.' : 'Your donation helps us raise our own contributions and keep our offers free of charge.')}</p>
            <a class="btn btn--gold" href={r('donate', lang)}>{t.donate}</a>
          </div>
        )}
        <div class="panel">
          <h2 class="side-title">{t.contact}</h2>
          <p class="small">Boaz Murinzi Murema<br /><a href="mailto:info@bantu-ev.org">info@bantu-ev.org</a></p>
        </div>
      </aside>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section section--tight">
      <div class="wrap">
        <h2>{de ? 'Neuigkeiten aus dem Projekt' : 'News from this project'}</h2>
        <div class="grid grid--3">{news.map((n) => <NewsCard lang={lang} item={n} />)}</div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <h2>{de ? 'Weitere Projekte im Programm' : 'More projects in this programme'}</h2>
        <div class="grid grid--3">{related.map((p) => <ProjectCard lang={lang} project={p} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .head-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
  .project { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .project__figure { margin: 0 0 1.5rem; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); }
  .project__figure img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .project__stats { margin: 1.5rem 0 2rem; }
  .project__side { position: sticky; top: 100px; display: grid; gap: 1rem; }
  .side-title { font-family: var(--font-sans); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .8rem; }
  .facts { margin: 0; display: grid; gap: .2rem; }
  .facts dt { font-weight: 600; font-size: .82rem; color: var(--muted); margin-top: .6rem; }
  .facts dd { margin: 0; font-size: .95rem; }
  .facts ul { margin: 0; padding-left: 1rem; }
  .sdgs { display: flex; flex-wrap: wrap; gap: .35rem; }
  .sdg { background: var(--ink); color: var(--bg); border-radius: 6px; padding: .1rem .45rem; font-size: .78rem; font-weight: 700; }
  .side-cta { background: var(--gold-soft); border-color: #e9cf72; }
  .side-cta p { font-size: .95rem; }
  @media (max-width: 960px) { .project { grid-template-columns: 1fr; } .project__side { position: static; } }
</style>
