---
import Base from '../layouts/Base.astro';
import DonationHelp from '../components/DonationHelp.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { giftPath, href, projectPath, r, ui, type Lang } from '../i18n';
import { org } from '../data/site';
import { categories, products } from '../data/shop';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const title = de ? 'Spenden' : fr ? 'Faire un don' : 'Donate';
const lead = de
  ? 'Jede Spende, ob groß oder klein, macht einen Unterschied. Bantu e.V. ist als gemeinnützig anerkannt; Spenden sind steuerlich absetzbar.'
  : fr ? 'Chaque don, petit ou grand, compte. Bantu e.V. est une association reconnue d’intérêt général ; les dons sont déductibles des impôts en Allemagne.' : 'Every donation, large or small, makes a difference. Bantu e.V. is a recognised non-profit; donations are tax-deductible in Germany.';
// Symbolic gifts live here, not in the shop (chair, 08.11.2026). Each opens its page with the bank-transfer order form.
// twingle's hosted form in the language of this page (chair, 10.11.2026: German, English and French are enabled in twingle).
const twinglePage = org.donation?.pageUrl ? `${org.donation.pageUrl}?tw_lang=${lang}` : undefined;
const giftCat = categories.find((c) => c.id === 'gifts')!;
const gifts = products.filter((p) => p.category === 'gifts');
const purposes = [
  { ref: 'Pearl Kita', slug: 'p26-230-pearl-kita-kampala', de: 'Pearl Kindertagesstätte Kampala: Eigenanteil 1.390 €', en: 'Pearl Kindergarten Kampala: our share €1,390' },
  { ref: 'Wasser Ruziba', slug: 'p26-186-wasser-fuer-ruziba', de: 'Wasser für Ruziba, Burundi', en: 'Water for Ruziba, Burundi' },
  { ref: 'Bildung Berlin', slug: 'p26-214-bildung-fuer-alle', de: 'Bildungsarbeit in Berlin (Schulungen, Workshops, Begegnungen)', en: 'Education work in Berlin (trainings, workshops, encounters)' },
  { ref: 'Spende', slug: '', de: 'Wo es am meisten gebraucht wird', en: 'Where it is needed most' },
];
---
<Base lang={lang} title={title} description={lead} altHref={r('donate', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <ul class="trust" role="list" aria-label={de ? 'Vertrauen und Sicherheit' : fr ? 'Confiance et sécurité' : 'Trust and security'}>
      <li><Icon name="star" class="trust__ic" /> {de ? `Gemeinnützig anerkannt (Freistellungsbescheid vom ${org.tax.exemptionNotice})` : fr ? `Reconnue d’intérêt général (avis d’exonération du ${org.tax.exemptionNotice})` : `Registered charity (tax exemption notice of ${org.tax.exemptionNotice})`}</li>
      <li><Icon name="report" class="trust__ic" /> {de ? 'Zuwendungsbestätigung auf Wunsch' : fr ? 'Reçu fiscal sur demande' : 'Tax donation receipt on request'}</li>
      <li><Icon name="chart" class="trust__ic" /> <a href={r('reports', lang)}>{de ? 'Jahres- und Transparenzberichte seit 2020' : fr ? 'Rapports annuels et de transparence depuis 2020' : 'Annual and transparency reports since 2020'}</a></li>
      <li><Icon name="people" class="trust__ic" /> {org.memberships[lang][0]}</li>
    </ul>
    <nav class="donation-quick" aria-label={de ? 'Spendenweg wählen' : fr ? 'Choisir un moyen de don' : 'Choose how to donate'}>
      {org.donation?.pageUrl && <a class="btn btn--gold" href={twinglePage} target="_blank" rel="noopener">{de ? 'Online spenden' : fr ? 'Donner en ligne' : 'Donate online'}<span class="sr-only"> {t.newWindow}</span></a>}
      {org.paypalUrl && <a class="btn btn--outline" href={org.paypalUrl} target="_blank" rel="noopener">PayPal<span class="sr-only"> {t.newWindow}</span></a>}
      <a class="btn btn--outline" href="#bank">{de ? 'Banküberweisung' : fr ? 'Virement bancaire' : 'Bank transfer'}</a>
    </nav>
  </PageHead>

  <section class="section section--tight" aria-labelledby="h-regular">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">{de ? 'Am meisten bewirkt' : fr ? 'Le plus efficace' : 'Makes the biggest difference'}</div><h2 id="h-regular">{de ? 'Regelmäßig helfen' : fr ? 'Aider régulièrement' : 'Give regularly'}</h2><p>{de ? 'Eine Spende, die jeden Monat kommt, lässt uns planen: Schulgebühren, Mahlzeiten und Lernmaterial müssen zu Beginn jedes Schulabschnitts da sein, nicht irgendwann.' : fr ? 'Un don qui arrive chaque mois nous permet de planifier : frais de scolarité, repas et matériel doivent être là au début de chaque trimestre, pas un jour.' : 'A gift that arrives every month lets us plan: school fees, meals and learning materials have to be there at the start of each term, not eventually.'}</p></div></div>
      <div class="regular">
        <div class="panel regular__card regular__card--gold">
          <h3>{de ? 'Bildungspatenschaft ab 25 EUR im Monat' : fr ? 'Parrainage éducatif dès 25 EUR par mois' : 'Education sponsorship from 25 EUR a month'}</h3>
          <p>{de ? 'Mit „Education into the Future“ ermöglichen Sie Kindern und jungen Menschen in Uganda den Schulbesuch oder eine Ausbildung: 25 EUR frühe Bildung oder Grundschule, 40 EUR weiterführende Schule, 70 EUR berufliche Ausbildung. Sie wählen Rhythmus und Bildungsstufe, wir berichten mindestens einmal im Jahr.' : fr ? 'Avec « Education into the Future », vous permettez à des enfants et des jeunes en Ouganda d’aller à l’école ou de suivre une formation : 25 EUR petite enfance ou primaire, 40 EUR secondaire, 70 EUR formation professionnelle. Vous choisissez le rythme et l’étape éducative, nous vous informons au moins une fois par an.' : 'With “Education into the Future” you enable children and young people in Uganda to attend school or training: 25 EUR early childhood or primary, 40 EUR secondary school, 70 EUR vocational training. You choose the rhythm and the education stage, we report at least once a year.'}</p>
          <div class="btn-row">
            <a class="btn btn--gold" href={r('sponsorship', lang, '#formular')}>{de ? 'Patenschaft anfragen' : fr ? 'Demander un parrainage' : 'Request a sponsorship'}</a>
            <a class="btn btn--outline" href={r('sponsorship', lang)}>{de ? 'Das Programm kennenlernen' : fr ? 'Découvrir le programme' : 'About the programme'}</a>
          </div>
        </div>
        <div class="panel regular__card">
          <h3>{de ? 'Dauerspende für unsere Arbeit' : fr ? 'Don régulier pour notre travail' : 'Regular gift for our work'}</h3>
          <p>{de ? 'Frei verwendbare monatliche Spenden tragen die Arbeit in Berlin, Uganda und Burundi dort, wo gerade keine Förderung greift: Eigenanteile der Projekte, Vorbereitung neuer Anträge, Begleitung der Partner.' : fr ? 'Les dons mensuels libres soutiennent notre travail à Berlin, en Ouganda et au Burundi là où aucun financement n’intervient : parts propres des projets, préparation de nouvelles demandes, accompagnement des partenaires.' : 'Unrestricted monthly gifts carry the work in Berlin, Uganda and Burundi where no grant reaches: the projects’ own contributions, preparing new applications, accompanying the partners.'}</p>
          {org.donation?.pageUrl
            ? <p>{de ? 'Wählen Sie im Online-Spendenformular den Rhythmus „monatlich“ und zahlen Sie per SEPA-Lastschrift, PayPal, Kreditkarte, Google Pay oder Apple Pay. Oder richten Sie einen Dauerauftrag auf unser GLS-Konto ein (Bankverbindung unten).' : fr ? 'Dans le formulaire de don en ligne, choisissez le rythme « mensuel » et payez par prélèvement SEPA, PayPal, carte bancaire, Google Pay ou Apple Pay. Vous pouvez aussi mettre en place un ordre permanent vers notre compte GLS (coordonnées ci-dessous).' : 'In the online donation form choose “monthly” and pay by SEPA direct debit, PayPal, credit card, Google Pay or Apple Pay. Or set up a standing order to our GLS account (bank details below).'}</p>
            : <p>{de ? 'Richten Sie einen Dauerauftrag auf unser GLS-Konto ein (Bankverbindung unten).' : fr ? 'Mettez en place un ordre permanent vers notre compte GLS (coordonnées ci-dessous).' : 'Set up a standing order to our GLS account (bank details below).'}</p>}
          <div class="btn-row">
            {org.donation?.pageUrl && <a class="btn btn--dark" href={twinglePage} target="_blank" rel="noopener">{de ? 'Online spenden: Rhythmus wählen' : fr ? 'Donner en ligne : choisir la fréquence' : 'Donate online: choose frequency'}</a>}
            <a class="btn btn--outline" href="#bank">{de ? 'Bankverbindung' : fr ? 'Coordonnées bancaires' : 'Bank details'}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {org.donation?.pageUrl && (
    <section class="section section--tight section--alt" aria-labelledby="h-online">
      <div class="wrap">
        <div class="panel online">
          <div class="online__text">
            <h2 id="h-online">{de ? 'Online spenden' : fr ? 'Faire un don en ligne' : 'Donate online'}</h2>
            <p>{de
              ? 'Mit unserem Online-Spendenformular spenden Sie einmalig oder regelmäßig (monatlich oder jährlich): per SEPA-Lastschrift, PayPal, Kreditkarte, Google Pay oder Apple Pay (die beiden Letzteren auf unterstützten Geräten), bei einmaligen Spenden auch per Überweisung. Eine Zuwendungsbestätigung können Sie mit Ihrer Anschrift anfordern und später im Spender-Service herunterladen.'
              : fr ? 'Avec notre formulaire de don en ligne, vous pouvez donner une fois ou régulièrement (chaque mois ou chaque année) : par prélèvement SEPA, PayPal, carte bancaire, Google Pay ou Apple Pay (ces deux derniers sur les appareils compatibles), et pour un don unique aussi par virement. Vous pouvez demander un reçu fiscal en indiquant votre adresse, puis le télécharger dans l’espace donateur.' : 'Use our online donation form to give once or regularly (monthly or yearly): by SEPA direct debit, PayPal, credit card, Google Pay or Apple Pay (the last two on supported devices), and for one-off gifts also by bank transfer. Request a tax donation receipt by providing your postal address, then download it in the donor self-service.'}</p>
            <div class="btn-row">
              <a class="btn btn--gold" href={twinglePage} target="_blank" rel="noopener">{de ? 'Zum Spendenformular' : fr ? 'Ouvrir le formulaire de don' : 'Open the donation form'}</a>
              <button class="btn btn--outline" type="button" id="load-form" aria-controls="donation-form" aria-expanded="false" data-widget={org.donation.widgetUrl} data-widget-lang={lang}>{de ? 'Formular hier anzeigen' : fr ? 'Afficher le formulaire sur cette page' : 'Show the form on this page'}</button>
            </div>
            {org.donation.selfServiceUrl && (
              <p class="selfservice"><Icon name="report" class="ic" /><span><strong>{de ? 'Schon gespendet?' : fr ? 'Vous avez déjà donné ?' : 'Already donated?'}</strong> <a href={org.donation.selfServiceUrl} target="_blank" rel="noopener">{de ? 'Spender-Service: Spende verwalten oder Zuwendungsbestätigung herunterladen' : fr ? 'Espace donateur : gérer votre don ou télécharger un justificatif' : 'Donor self-service: manage your donation or download a receipt'}<span class="sr-only"> {t.newWindow}</span></a><br /><span class="small muted">{de ? 'Anmeldung mit E-Mail-Adresse und Zahlungs-ID, für Spenden über das Online-Formular' : fr ? 'Connexion avec votre adresse e-mail et l’identifiant de paiement, pour les dons faits avec le formulaire en ligne' : 'Sign in with your e-mail address and payment ID, for donations made through the online form'}</span></span></p>
            )}
            {org.paypalUrl && (
              <div class="paypal">
                <h3 class="h4">{de ? 'Oder mit PayPal' : fr ? 'Ou avec PayPal' : 'Or with PayPal'}</h3>
                <p>{de ? 'Einmalig oder monatlich direkt über das Spendenkonto von Bantu e.V. bei PayPal (PayPal können Sie auch im Online-Spendenformular wählen). Für eine Zuwendungsbestätigung zu einer Spende über diesen Knopf schreiben Sie uns bitte kurz Ihre Anschrift.' : fr ? 'Une fois ou chaque mois directement via le compte de dons de Bantu e.V. chez PayPal (PayPal est aussi proposé dans le formulaire de don en ligne). Pour un reçu fiscal pour un don fait avec ce bouton, envoyez-nous simplement votre adresse.' : 'One-off or monthly directly through the Bantu e.V. donation account at PayPal (PayPal is also offered in the online donation form). For a receipt for a donation made with this button, just send us your postal address.'}</p>
                <a class="btn btn--dark" href={org.paypalUrl} rel="noopener" target="_blank"><Icon name="heart" /> {de ? 'Mit PayPal spenden' : fr ? 'Donner avec PayPal' : 'Donate with PayPal'}<span class="sr-only"> {t.newWindow}</span></a>
              </div>
            )}
            <p class="small muted">{de
              ? 'Das Formular wird von unserem Dienstleister twingle bereitgestellt. Erst wenn Sie einen der Knöpfe nutzen, werden Daten (z. B. Ihre IP-Adresse) an twingle übertragen; je nach Zahlungsart wickeln PayPal oder Stripe die Zahlung ab. Der PayPal-Knopf führt zur Spendenseite von PayPal, der Spender-Service zu twingle; auch dorthin werden Daten erst beim Klick übertragen.'
              : fr ? 'Le formulaire est fourni par notre prestataire twingle. Des données (par exemple votre adresse IP) ne sont transmises à twingle que lorsque vous utilisez l’un des boutons ; selon le moyen de paiement, PayPal ou Stripe traite le paiement. Le bouton PayPal mène à la page de dons de PayPal, l’espace donateur à twingle ; là aussi, des données ne sont transmises qu’au clic.' : 'The form is provided by our service provider twingle. Data (e.g. your IP address) is only transferred to twingle when you use one of the buttons; depending on the payment method, PayPal or Stripe processes the payment. The PayPal button leads to PayPal’s donation page and the donor self-service to twingle; data is transferred there only when you click.'} <a href={r('privacy', lang)}>{de ? 'Mehr zum Datenschutz' : fr ? 'En savoir plus sur la confidentialité' : 'More on privacy'}</a></p>
          </div>
          <div id="donation-form" class="online__form" role="region" hidden tabindex="-1" aria-label={de ? 'Online-Spendenformular' : fr ? 'Formulaire de don en ligne' : 'Online donation form'}></div>
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="wrap donate">
      <div class="panel bank" id="bank">
        <h2>{de ? 'Per Überweisung' : fr ? 'Par virement' : 'By bank transfer'}</h2>
        <dl class="kv bank__kv">
          <dt>{de ? 'Empfänger' : fr ? 'Titulaire du compte' : 'Account holder'}</dt><dd>{org.bank.holder}</dd>
          <dt>IBAN</dt><dd><code id="iban">{org.bank.iban}</code> <button class="copy" type="button" data-copy="iban" data-done={t.copied}>{t.copy}</button></dd>
          <dt>BIC</dt><dd><code>{org.bank.bic}</code></dd>
          <dt>Bank</dt><dd>{org.bank.bank}</dd>
          <dt>{de ? 'Verwendungszweck' : fr ? 'Motif du virement' : 'Reference'}</dt><dd><code id="ref">Spende</code> <button class="copy" type="button" data-copy="ref" data-done={t.copied}>{t.copy}</button></dd>
        </dl>
        <p class="small muted">{de ? 'Für eine Zuwendungsbestätigung schreiben Sie uns bitte Ihren Namen, Ihre Anschrift sowie Betrag und Datum der Spende per E-Mail.' : fr ? 'Pour un reçu fiscal, envoyez-nous par e-mail vos nom, adresse, montant et date du don.' : 'For a tax donation receipt, e-mail us your name, postal address, donation amount and date.'}</p>
      </div>
      <div>
        <h2>{de ? 'Wofür möchten Sie spenden?' : fr ? 'Que souhaitez-vous soutenir ?' : 'What would you like to support?'}</h2>
        <p class="muted">{de ? 'Wählen Sie einen Zweck. Der Verwendungszweck links passt sich an.' : fr ? 'Choisissez un objectif. Le motif à gauche s’adapte.' : 'Choose a purpose. The reference on the left updates.'}</p>
        <div class="purposes" role="radiogroup" aria-label={de ? 'Spendenzweck' : fr ? 'Objectif' : 'Purpose'}>
          {purposes.map((p, i) => (
            <label class="purpose">
              <input type="radio" name="purpose" value={p.ref} checked={i === purposes.length - 1} />
              <span><strong>{p[lang]}</strong><br /><span class="small muted">{de ? 'Verwendungszweck' : fr ? 'Motif du virement' : 'Reference'}: „{p.ref}“</span>{p.slug && <> · <a href={projectPath(lang, p.slug)}>{de ? 'Projekt' : fr ? 'Projet' : 'Project'}</a></>}</span>
            </label>
          ))}
        </div>
      </div>
    </div>
  </section>

  {gifts.length > 0 && (
    <section class="section section--tight section--alt" id="geschenke" aria-labelledby="h-gifts">
      <div class="wrap">
        <div class="section-head"><div><h2 id="h-gifts">{giftCat.name[lang]}</h2><p>{giftCat.intro[lang]}</p></div></div>
        <div class="grid grid--3">
          {gifts.map((p) => (
            <article class="card card--link">
              {p.image ? <img src={href(p.image)} alt="" class="gift-img" /> : <Placeholder lang={lang} ratio="4 / 3" tone="gold" label={p.photoBrief?.[lang]} compact />}
              <div class="card__body">
                <div class="card__meta"><span class={`tag ${p.status === 'available' ? 'tag--active' : 'tag--planned'}`}>{p.status === 'available' ? (de ? 'Jetzt möglich' : fr ? 'Disponible dès maintenant' : 'Available now') : t.comingSoon}</span></div>
                <h3><a class="stretched" href={giftPath(lang, p.slug)}>{(p.name as Record<string, string>)[lang] ?? p.name.en}</a></h3>
                <p>{(p.short as Record<string, string>)[lang] ?? p.short.en}</p>
                <div class="card__foot gift-price">{p.priceNote?.[lang]}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap grid grid--3">
      <div class="panel">
        <h3>{de ? 'Zuwendungsbestätigung' : fr ? 'Reçu fiscal' : 'Donation receipt'}</h3>
        <p>{de ? 'Wir stellen Zuwendungsbestätigungen für das Finanzamt aus. Für Spenden bis 300 € kann unter den gesetzlichen Voraussetzungen ein vereinfachter Nachweis genutzt werden. Die erforderlichen Unterlagen erläutern wir unten.' : fr ? 'Nous délivrons des reçus fiscaux officiels (Zuwendungsbestätigung) pour l’administration fiscale allemande. Pour les dons jusqu’à 300 €, un justificatif simplifié est possible sous conditions ; les pièces nécessaires sont expliquées ci-dessous.' : 'We issue official donation receipts (Zuwendungsbestätigung) for German tax purposes. For donations up to €300, simplified evidence is possible subject to conditions; the required documents are explained below.'}</p>
        {org.donation?.selfServiceUrl && <a class="link-arrow" href={org.donation.selfServiceUrl} target="_blank" rel="noopener">{de ? 'Bestätigung im Spender-Service herunterladen' : fr ? 'Télécharger le justificatif dans l’espace donateur' : 'Download a receipt in the donor self-service'}<span class="sr-only"> {t.newWindow}</span></a>}
      </div>
      <div class="panel">
        <h3>{de ? 'Regelmäßig helfen' : fr ? 'Donner régulièrement' : 'Give regularly'}</h3>
        <p>{de ? 'Als Mitglied oder Fördermitglied unterstützen Sie uns verlässlich, schon ab 5 € im Monat.' : fr ? 'En tant que membre ou membre bienfaiteur, vous nous soutenez durablement, dès 5 € par mois.' : 'As a member or supporting member you give us reliable support, from €5 a month.'}</p>
        <a class="link-arrow" href={r('join', lang, '#membership')}>{de ? 'Mitglied werden' : fr ? 'Devenir membre' : 'Become a member'}</a>
      </div>
      <div class="panel">
        <h3>{de ? 'Transparenz' : fr ? 'Transparence' : 'Transparency'}</h3>
        <p>{de ? 'Jedes Projekt wird getrennt abgerechnet. In unseren Transparenzberichten legen wir offen, woher unser Geld kommt und wofür wir es einsetzen.' : fr ? 'Chaque projet fait l’objet d’un décompte séparé. Nos rapports de transparence montrent d’où vient notre argent et comment nous l’utilisons.' : 'Every project is accounted for separately. Our transparency reports show where our money comes from and how we use it.'}</p>
        <a class="link-arrow" href={r('reports', lang)}>{de ? 'Zu den Berichten' : fr ? 'Voir les rapports' : 'View reports'}</a>
      </div>
    </div>
  </section>
  <DonationHelp lang={lang} />
</Base>
<script>
  const refEl = document.getElementById('ref');
  const fromUrl = new URLSearchParams(location.search).get('ref');
  if (fromUrl && refEl) refEl.textContent = fromUrl.slice(0, 60);
  document.querySelectorAll<HTMLInputElement>('input[name="purpose"]').forEach((input) => {
    if (fromUrl && input.value === fromUrl) input.checked = true;
    input.addEventListener('change', () => { if (refEl && input.checked) refEl.textContent = input.value; });
  });
  // Two-click: the twingle widget is only requested after the visitor asks for it.
  const loadBtn = document.getElementById('load-form') as HTMLButtonElement | null;
  const box = document.getElementById('donation-form');
  loadBtn?.addEventListener('click', () => {
    if (!box || box.dataset.loaded) { box?.focus(); return; }
    // Letters and digits only: twingle's embed script finds its container through the script id "tw-<id>". It cannot read
    // the id from the script address any more, because the address now ends in ?tw_lang=… (tested live 10.11.2026).
    const id = 'bantu' + Math.random().toString(36).slice(2, 11).replace(/[^a-z0-9]/g, '');
    const holder = document.createElement('div');
    holder.id = 'twingle-public-embed-' + id;
    box.appendChild(holder);
    const s = document.createElement('script');
    s.async = true;
    s.id = 'tw-' + id;
    // twingle shows the form in the language of this page (tw_lang; the embed script passes it on to the form).
    s.src = loadBtn.dataset.widget + '/' + id + '?tw_lang=' + encodeURIComponent(loadBtn.dataset.widgetLang || 'de');
    document.body.appendChild(s);
    box.dataset.loaded = '1';
    box.hidden = false;
    loadBtn.setAttribute('aria-expanded', 'true');
    loadBtn.disabled = true;
    box.focus();
  });
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.getElementById(btn.dataset.copy!);
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.textContent!.replace(/\s+/g, btn.dataset.copy === 'iban' ? '' : ' ').trim());
        const old = btn.textContent; btn.textContent = btn.dataset.done!; setTimeout(() => (btn.textContent = old), 1600);
      } catch { /* clipboard not available */ }
    });
  });
</script>
<style>
  .donation-quick { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.2rem; }
  .selfservice { display: flex; gap: .6rem; align-items: flex-start; margin: 1rem 0 0; }
  .selfservice .ic { width: 1.3em; height: 1.3em; flex: none; margin-top: .15em; color: var(--ink-2); }
  .selfservice a { font-weight: 700; }
  .trust { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: .95rem; font-weight: 600; }
  .trust li { display: inline-flex; align-items: center; gap: .45rem; margin: 0; }
  .trust__ic { width: 1.15em; height: 1.15em; color: var(--green-text); flex: none; }
  .regular { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(1rem, 3vw, 2rem); align-items: stretch; }
  .regular__card h3 { margin-top: 0; font-size: 1.3rem; }
  .regular__card--gold { border-top: 6px solid var(--gold); }
  .regular__card:not(.regular__card--gold) { border-top: 6px solid var(--green); }
  .regular__card .btn-row { margin-top: 1rem; }
  @media (max-width: 860px) { .regular { grid-template-columns: 1fr; } }
  .bank { scroll-margin-top: calc(var(--header-h, 90px) + 1rem); }
  .online { border-top: 6px solid var(--green); display: grid; gap: 1.25rem; }
  .online h2 { margin-top: 0; }
  .online__text p { max-width: 68ch; }
  .online__text .small { margin-top: 1rem; }
  .paypal { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .paypal .h4 { font-size: 1.05rem; margin: 0 0 .4rem; }
  .paypal p { margin: 0 0 .75rem; }
  .online__form { min-height: 200px; border-radius: 12px; }
  .online__form:focus { outline: 3px solid var(--focus); outline-offset: 4px; }
  .donate { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
