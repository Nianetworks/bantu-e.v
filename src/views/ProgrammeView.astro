---
// Renders: programme overview (mode "overview"), one programme (mode "programme" + programme key),
// or all projects grouped by programme (mode "all"). Programme data: src/data/programmes.ts
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import SdgIcons from '../components/SdgIcons.astro';
import { r, ui, projectPath, type Lang } from '../i18n';
import { getProjects, slugOf, type Project } from '../lib/content';
import { programmes, management, trusteeships, programmePath, regions, regionPath, regionProgrammePath, type ProgrammeKey } from '../data/programmes';

interface Props { lang: Lang; programme?: ProgrammeKey; mode?: 'overview' | 'programme' | 'all' }
const { lang, programme, mode = 'programme' } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const all = await getProjects(lang);
const bySlug = new Map(all.map((p) => [slugOf(p.id), p]));
const projectsOf = (key: ProgrammeKey): Project[] =>
  programmes.find((p) => p.key === key)!.projects.map((s) => bySlug.get(s)).filter((p): p is Project => !!p);
const assigned = new Set(programmes.flatMap((p) => p.projects));
const unassigned = all.filter((p) => !assigned.has(slugOf(p.id)));

const prog = programme ? programmes.find((p) => p.key === programme)! : null;
const list = prog ? projectsOf(prog.key) : [];
const active = list.filter((p) => p.data.status !== 'completed');
const done = list.filter((p) => p.data.status === 'completed');
const idx = prog ? programmes.indexOf(prog) : -1;
const prev = idx > 0 ? programmes[idx - 1] : null;
const next = idx >= 0 && idx < programmes.length - 1 ? programmes[idx + 1] : null;

const other: Lang = de ? 'en' : 'de';
const title = mode === 'all' ? t.allProjects : mode === 'overview' ? (de ? 'Programme & Projekte' : fr ? 'Programmes et projets' : 'Programmes & projects') : prog!.title[lang];
const altHref = mode === 'all' ? r('projects', other) : mode === 'overview' ? r('programmes', other) : programmePath(other, prog!.key);
const crumbs = mode === 'overview' ? [] : [{ label: de ? 'Programme' : fr ? 'Programmes' : 'Programmes', href: r('programmes', lang) }];
const lead = mode === 'all'
  ? (de ? 'Alle laufenden und abgeschlossenen Projekte von Bantu e.V., geordnet nach unseren Programmen, in Uganda, Burundi und Deutschland.' : fr ? 'Tous les projets en cours et terminés de Bantu e.V., classés par programme, en Ouganda, au Burundi et en Allemagne.' : 'All ongoing and completed projects of Bantu e.V., organised by programme, in Uganda, Burundi and Germany.')
  : mode === 'overview'
    ? (de ? 'Unsere Arbeit gliedert sich in fünf Programme, getragen von einem gemeinsamen Rahmen für Steuerung und Qualität. Alle folgen dem Ubuntu-Gedanken: Ich bin, weil wir sind.' : fr ? 'Notre travail est organisé en cinq programmes, reliés par un cadre commun de pilotage et de qualité. Tous suivent l’idée d’Ubuntu : je suis parce que nous sommes.' : 'Our work is organised in five programmes, held together by a shared framework for management and quality. All of them follow the idea of Ubuntu: I am because we are.')
    : prog!.lead[lang];
const sponsorId = de ? 'traegerschaften' : 'fiscal-sponsorship';
---
<Base lang={lang} title={title} description={lead} altHref={altHref}>
  <PageHead lang={lang} title={title} lead={lead} crumbs={crumbs} eyebrow={mode === 'programme' ? `${de ? 'Programm' : fr ? 'Programme' : 'Programme'} ${prog!.no}` : undefined} />

  {mode === 'overview' && (
    <>
      <section class="section section--tight" aria-labelledby="h-areas">
        <div class="wrap">
          <h2 id="h-areas" class="h3">{de ? 'Nach Arbeitsbereich' : fr ? 'Par domaine d’action' : 'By area of work'}</h2>
          <div class="grid grid--2">
            {regions.map((rg) => (
              <a class={`area-link area-link--${rg.key}`} href={regionPath(lang, rg.key)}>
                <span class="icon-badge"><Icon name={rg.icon} /></span>
                <span><strong>{de && rg.key === 'international' ? 'Internationale Zusammenarbeit (Auslandsarbeit)' : rg.title[lang]}</strong><span class="small muted">{rg.places[lang]}</span></span>
                <Icon name="arrow" />
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="section section--tight" aria-labelledby="h-progs">
        <div class="wrap">
          <h2 id="h-progs" class="h3">{de ? 'Unsere Programme' : fr ? 'Nos programmes' : 'Our programmes'}</h2>
          <ol class="prog-grid">
            {programmes.map((p) => {
              const items = projectsOf(p.key);
              const running = items.filter((x) => x.data.status !== 'completed').length;
              return (
                <li class={`prog-card accent--${p.accent}`}>
                  <div class="prog-card__top">
                    <span class="icon-badge"><Icon name={p.icon} /></span>
                    <span class="prog-card__no">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {p.no}</span>
                  </div>
                  <h3><a href={programmePath(lang, p.key)}>{p.title[lang]}</a></h3>
                  <p class="prog-card__short">{p.short[lang]}</p>
                  <p class="small muted">{running} {de ? 'laufend' : fr ? 'en cours' : 'ongoing'} · {items.length} {de ? 'Projekte' : fr ? 'projets' : 'projects'}</p>
                  <p class="prog-card__regions">{regions.filter((rg) => items.some((x) => x.data.programme === rg.key) || p.services?.some((sv) => sv.region === rg.key)).map((rg) => <a class="tag" href={regionProgrammePath(lang, rg.key, p.key)}>{rg.title[lang]}</a>)}</p>
                  <ul class="prog-card__list">
                    {items.map((x) => <li><a href={projectPath(lang, slugOf(x.id))}>{x.data.title}</a></li>)}
                    {p.services?.map((s) => <li class="muted">{s.title[lang]}</li>)}
                  </ul>
                  <a class="link-arrow prog-card__more" href={programmePath(lang, p.key)} aria-hidden="true" tabindex="-1">{de ? 'Zum Programm' : fr ? 'Voir le programme' : 'View programme'}</a>
                </li>
              );
            })}
            <li class="prog-card prog-card--mgmt">
              <div class="prog-card__top">
                <span class="icon-badge"><Icon name="chart" /></span>
                <span class="prog-card__no">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {management.no}</span>
              </div>
              <h3>{management.title[lang]}</h3>
              <p class="prog-card__short">{management.lead[lang]}</p>
              <ul class="prog-card__list prog-card__list--plain">{management.items[lang].map((i) => <li>{i}</li>)}</ul>
              <a class="link-arrow" href={r('reports', lang)}>{de ? 'Transparenz und Berichte' : fr ? 'Transparence et rapports' : 'Transparency and reports'}</a>
            </li>
          </ol>
        </div>
      </section>

      <section class="section section--alt" aria-labelledby={`${sponsorId}-h`} id={sponsorId}>
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="eyebrow">{de ? 'Trägerschaften' : fr ? 'Portage d’initiatives' : 'Fiscal sponsorship'}</div>
              <h2 id={`${sponsorId}-h`}>{de ? 'Wir ermöglichen Initiativen' : fr ? 'Nous rendons des initiatives possibles' : 'We enable initiatives'}</h2>
              <p>{de ? 'Als Trägerverein stellen wir jungen Initiativen unsere Gemeinnützigkeit, Verwaltung und Erfahrung zur Verfügung, von der Beantragung und Verwaltung der Fördermittel bis zur Abrechnung, bis sie eigenständig arbeiten können.' : fr ? 'En tant qu’association porteuse, nous mettons à la disposition de jeunes initiatives notre statut d’intérêt général, notre administration et notre expérience, de la demande et la gestion des subventions jusqu’au décompte final, jusqu’à ce qu’elles puissent travailler de façon autonome.' : 'As a fiscal sponsor we lend young initiatives our charitable status, administration and experience, from applying for and managing grants to financial reporting, until they can work independently.'}</p>
            </div>
          </div>
          <div class="grid grid--2">
            {trusteeships.map((ts) => (
              <article class="panel sponsor">
                <p class="small muted">{ts.place} · {ts.period[lang]}</p>
                <h3><a href={ts.url} rel="noopener">{ts.name}</a></h3>
                <p>{ts.text[lang]}</p>
                <h4 class="sponsor__h">{de ? 'Projekte unter unserer Trägerschaft' : fr ? 'Projets portés par nous' : 'Projects under our sponsorship'}</h4>
                <ul>{ts.projects[lang].map((x) => <li>{x}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--tight">
        <div class="wrap center-row">
          <a class="btn btn--dark" href={r('projects', lang)}>{t.allProjects}</a>
        </div>
      </section>
    </>
  )}

  {mode === 'programme' && prog && (
    <>
      <section class="section section--tight">
        <div class="wrap focus-row">
          <div class={`panel focus accent--${prog.accent}`}>
            <h2 class="h3">{de ? 'Schwerpunkte' : fr ? 'Axes principaux' : 'Focus areas'}</h2>
            <ul>{prog.focus[lang].map((f) => <li>{f}</li>)}</ul>
            <h3 class="sdg-h">{de ? 'Beitrag zu den Nachhaltigkeitszielen' : fr ? 'Contribution aux objectifs de développement durable' : 'Contribution to the Sustainable Development Goals'}</h3>
            <SdgIcons lang={lang} goals={prog.sdgs} size="sm" />
            <h3 class="sdg-h">{de ? 'Dieses Programm in unseren Arbeitsbereichen' : fr ? 'Ce programme dans nos domaines d’action' : 'This programme in our areas of work'}</h3>
            <p class="region-links">{regions.filter((rg) => list.some((x) => x.data.programme === rg.key) || prog.services?.some((sv) => sv.region === rg.key)).map((rg) => <a class="btn btn--outline" href={regionProgrammePath(lang, rg.key, prog.key)}>{rg.title[lang]}: {prog.title[lang]}</a>)}</p>
          </div>
          {prog.services?.map((s) => (
            <div class="panel service">
              <h2 class="h3">{s.title[lang]}</h2>
              <p>{s.text[lang]}</p>
              {s.cta && <a class="btn btn--outline" href={r(s.cta.route, lang)}>{s.cta.label[lang]}</a>}
            </div>
          ))}
        </div>
      </section>
      {active.length > 0 && (
        <section class="section section--tight">
          <div class="wrap">
            <h2>{de ? 'Laufende Projekte' : fr ? 'Projets en cours' : 'Current projects'}</h2>
            <div class="grid grid--3">{active.map((p) => <ProjectCard lang={lang} project={p} />)}</div>
          </div>
        </section>
      )}
      {done.length > 0 && (
        <section class="section section--alt">
          <div class="wrap">
            <h2>{de ? 'Abgeschlossene Projekte' : fr ? 'Projets terminés' : 'Completed projects'}</h2>
            <div class="grid grid--3">{done.map((p) => <ProjectCard lang={lang} project={p} />)}</div>
          </div>
        </section>
      )}
      <nav class="section section--tight" aria-label={de ? 'Weitere Programme' : fr ? 'Autres programmes' : 'More programmes'}>
        <div class="wrap pager">
          {prev ? <a class="pager__link" href={programmePath(lang, prev.key)}><span class="small muted">← {de ? 'Programm' : fr ? 'Programme' : 'Programme'} {prev.no}</span><strong>{prev.title[lang]}</strong></a> : <span></span>}
          <a class="pager__link pager__link--mid" href={r('programmes', lang)}><strong>{de ? 'Alle Programme' : fr ? 'Tous les programmes' : 'All programmes'}</strong></a>
          {next ? <a class="pager__link pager__link--end" href={programmePath(lang, next.key)}><span class="small muted">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {next.no} →</span><strong>{next.title[lang]}</strong></a> : <span></span>}
        </div>
      </nav>
    </>
  )}

  {mode === 'all' && (
    <>
      {programmes.map((p, i) => {
        const items = projectsOf(p.key);
        return items.length > 0 && (
          <section class={`section section--tight ${i % 2 ? 'section--alt' : ''}`} aria-labelledby={`h-${p.key}`}>
            <div class="wrap">
              <div class="section-head">
                <div>
                  <div class="eyebrow">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {p.no}</div>
                  <h2 id={`h-${p.key}`}>{p.title[lang]}</h2>
                </div>
                <a class="link-arrow" href={programmePath(lang, p.key)}>{de ? 'Zum Programm' : fr ? 'Voir le programme' : 'View programme'}</a>
              </div>
              <div class="grid grid--3">{items.map((x) => <ProjectCard lang={lang} project={x} />)}</div>
            </div>
          </section>
        );
      })}
      {unassigned.length > 0 && (
        <section class="section section--tight">
          <div class="wrap">
            <h2>{de ? 'Weitere Projekte' : fr ? 'Autres projets' : 'More projects'}</h2>
            <div class="grid grid--3">{unassigned.map((x) => <ProjectCard lang={lang} project={x} />)}</div>
          </div>
        </section>
      )}
    </>
  )}
</Base>
<style>
  .prog-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 1000px) { .prog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .prog-grid { grid-template-columns: 1fr; } }
  .prog-card { position: relative; display: flex; flex-direction: column; gap: .45rem; margin: 0; padding: 1.5rem; background: var(--surface); border: 1px solid var(--line); border-top: 8px solid var(--accent, var(--gold)); border-radius: 20px; min-width: 0; }
  .prog-card:has(h3 a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .prog-card__top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .prog-card__no { font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .prog-card h3 { margin: .35rem 0 0; font-size: clamp(1.3rem, 2vw, 1.55rem); }
  .prog-card h3 a { color: var(--ink); text-decoration: none; }
  .prog-card h3 a:hover { text-decoration: underline; }
  .prog-card__regions { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; }
  .prog-card__regions .tag { text-decoration: none; color: var(--ink); min-height: 32px; display: inline-flex; align-items: center; }
  .prog-card__regions .tag:hover { text-decoration: underline; }
  .area-link { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; padding: 1.1rem 1.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; color: var(--ink); text-decoration: none; min-height: 44px; }
  .area-link span:nth-child(2) { display: flex; flex-direction: column; }
  .area-link strong { font-size: 1.1rem; }
  .area-link:hover strong { text-decoration: underline; }
  .prog-card__short { margin: 0; color: var(--ink-2); font-weight: 600; }
  .prog-card__list { list-style: none; padding: 0; margin: .25rem 0 .75rem; border-top: 1px solid var(--line); }
  .prog-card__list li { margin: 0; border-bottom: 1px solid var(--line); padding: .45rem 0; font-size: .97rem; }
  .prog-card__list a { color: var(--ink); text-decoration-thickness: 1px; text-underline-offset: .18em; display: inline-block; min-height: 24px; }
  .prog-card__list--plain li { padding: .4rem 0; }
  .prog-card__more { margin-top: auto; }
  .prog-card--mgmt { background: var(--bg-2); border-top-color: var(--ink); }
  .accent--gold { --accent: var(--gold); }
  .accent--green { --accent: var(--green); }
  .accent--blue { --accent: var(--blue); }
  .accent--red { --accent: var(--c-coral); }
  .accent--purple { --accent: var(--c-mauve); }
  .sponsor h3 { margin: .2rem 0 .4rem; }
  .sponsor__h { font-size: 1.02rem; margin: 1rem 0 .4rem; }
  .sponsor ul { margin: 0; padding-left: 1.2rem; }
  .sponsor li { margin-bottom: .3rem; }
  .center-row { display: flex; justify-content: center; }
  .focus-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 1.25rem; align-items: start; }
  .focus { border-top: 8px solid var(--accent, var(--gold)); }
  .focus ul { margin: 0 0 .8rem; padding-left: 1.2rem; }
  .focus li { margin-bottom: .45rem; }
  .service { border-top: 8px solid var(--ink); display: flex; flex-direction: column; gap: .6rem; }
  .service .btn { align-self: flex-start; }
  .h3 { font-size: 1.4rem; margin-top: 0; }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: stretch; }
  .pager__link { display: flex; flex-direction: column; gap: .2rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--ink); text-decoration: none; min-height: 44px; justify-content: center; }
  .pager__link:hover strong { text-decoration: underline; }
  .pager__link--mid { align-items: center; }
  .pager__link--end { text-align: right; align-items: flex-end; }
  @media (max-width: 720px) { .pager { grid-template-columns: 1fr; } .pager__link--end { text-align: left; align-items: flex-start; } .pager > span:empty { display: none; } }
  .sdg-h { font-size: 1rem; margin: 1.25rem 0 .6rem; }
  .region-links { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; }
</style>
