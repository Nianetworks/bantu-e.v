---
// "Follow our news": explains the RSS feed in plain HTML so nobody lands on raw XML by accident
// (chair's instruction 09.11.2026). The feeds themselves (src/pages/**/rss.xml.js) stay unchanged.
// Works without JavaScript: the reading link and the selectable address field need none; the copy
// button is enabled by the script and reports failure instead of a false success.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { feedPath, href, r, type Lang } from '../i18n';
import { org } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const T = (d: string, e: string, f: string) => (de ? d : fr ? f : e);
const title = T('Neuigkeiten von Bantu e.V. verfolgen', 'Follow Bantu e.V. news', 'Suivre les actualités de Bantu e.V.');
const lead = T(
  'Verfolgen Sie unsere Neuigkeiten in einem RSS-Reader oder lesen Sie die neuesten Beiträge auf unserer Website.',
  'Follow our updates in an RSS reader, or read the latest articles on our website.',
  'Suivez nos actualités dans un lecteur RSS ou lisez les derniers articles sur notre site.',
);
const feedUrl = new URL(href(feedPath[lang]), Astro.site).toString();
const s = {
  read: T('Neueste Beiträge lesen', 'Read the latest news', 'Lire les actualités'),
  copy: T('RSS-Adresse kopieren', 'Copy RSS feed address', 'Copier l’adresse du flux RSS'),
  copied: T('RSS-Adresse kopiert.', 'RSS feed address copied.', 'Adresse du flux RSS copiée.'),
  failed: T(
    'Kopieren war nicht möglich. Bitte markieren Sie die Adresse im Feld und kopieren Sie sie mit Strg + C (Mac: Cmd + C).',
    'Copying was not possible. Please select the address in the field and copy it with Ctrl + C (Mac: Cmd + C).',
    'La copie n’a pas été possible. Veuillez sélectionner l’adresse dans le champ et la copier avec Ctrl + C (Mac : Cmd + C).',
  ),
  field: T('Adresse des RSS-Feeds', 'RSS feed address', 'Adresse du flux RSS'),
  manual: T(
    'Sie können die Adresse auch im Feld markieren und von Hand kopieren.',
    'You can also select the address in the field and copy it by hand.',
    'Vous pouvez aussi sélectionner l’adresse dans le champ et la copier à la main.',
  ),
  howH: T('So funktioniert es', 'How it works', 'Comment ça marche'),
  how: [
    T('RSS ist ein offenes Format, mit dem Sie neue Beiträge vieler Websites an einem Ort sammeln, ohne Konto und ohne Tracking.', 'RSS is an open format that lets you collect new posts from many websites in one place, with no account and no tracking.', 'Le RSS est un format ouvert qui permet de rassembler au même endroit les nouveaux articles de nombreux sites, sans compte et sans traçage.'),
    T('Fügen Sie die Adresse oben in einem RSS-Reader Ihrer Wahl hinzu (zum Beispiel als App auf dem Smartphone, als Programm auf dem Computer oder als Erweiterung im Browser). Neue Beiträge erscheinen dann dort automatisch.', 'Add the address above to an RSS reader of your choice (for example an app on your phone, a program on your computer or a browser extension). New posts then appear there automatically.', 'Ajoutez l’adresse ci-dessus dans le lecteur RSS de votre choix (par exemple une application sur votre téléphone, un programme sur votre ordinateur ou une extension de navigateur). Les nouveaux articles y apparaîtront automatiquement.'),
    T('Wenn Sie die Adresse direkt im Browser öffnen, sehen Sie nur den Quelltext des Feeds. Das ist normal: Der Feed ist für RSS-Reader gedacht, nicht zum Lesen im Browser.', 'If you open the address directly in your browser, you will only see the feed’s source code. That is normal: the feed is meant for RSS readers, not for reading in a browser.', 'Si vous ouvrez l’adresse directement dans votre navigateur, vous ne verrez que le code source du flux. C’est normal : le flux est destiné aux lecteurs RSS, pas à la lecture dans un navigateur.'),
  ],
  otherH: T('Weitere Wege', 'Other ways to follow us', 'D’autres façons de nous suivre'),
  other: T('Unsere Neuigkeiten erscheinen auch auf Instagram:', 'Our news also appears on Instagram:', 'Nos actualités paraissent aussi sur Instagram :'),
  langsH: T('Feeds in anderen Sprachen', 'Feeds in other languages', 'Flux dans d’autres langues'),
};
const otherFeeds = (['de', 'en', 'fr'] as Lang[]).filter((l) => l !== lang).map((l) => ({ l, name: { de: 'Deutsch', en: 'English', fr: 'Français' }[l], page: r('follow', l) }));
---
<Base lang={lang} title={title} description={lead} altHref={r('follow', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead} crumbs={[{ label: T('Aktuelles', 'News', 'Actualités'), href: r('news', lang) }]} />

  <section class="section section--tight">
    <div class="wrap follow">
      <div class="panel feed" data-follow data-copied={s.copied} data-failed={s.failed}>
        <h2 class="h3" id="h-feed"><Icon name="link" class="hic" />{T('Unser RSS-Feed', 'Our RSS feed', 'Notre flux RSS')}</h2>
        <label class="feed__label" for="feed-url">{s.field}</label>
        <input class="feed__url" id="feed-url" type="url" readonly value={feedUrl} spellcheck="false" aria-describedby="feed-manual" />
        <p class="small muted" id="feed-manual">{s.manual}</p>
        <div class="btn-row">
          <a class="btn btn--dark" href={r('news', lang)}>{s.read}</a>
          <button class="btn btn--outline" type="button" data-copy hidden>{s.copy}</button>
        </div>
        <p class="feed__msg small" data-copy-msg role="status" aria-live="polite" aria-atomic="true"></p>
      </div>

      <div class="prose">
        <h2>{s.howH}</h2>
        {s.how.map((p) => <p>{p}</p>)}
        <h2>{s.otherH}</h2>
        <p>{s.other} <a href={org.socials[0].url}>@bantu_ev</a></p>
        <h3>{s.langsH}</h3>
        <ul>
          {otherFeeds.map((f) => <li><a href={f.page} hreflang={f.l} lang={f.l}>{f.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
<script>
  // Progressive enhancement: the button only appears when the script runs; success is announced only after the
  // clipboard call resolved, otherwise the visitor gets manual-copy instructions.
  const box = document.querySelector<HTMLElement>('[data-follow]');
  const btn = box?.querySelector<HTMLButtonElement>('[data-copy]');
  const input = box?.querySelector<HTMLInputElement>('#feed-url');
  const msg = box?.querySelector<HTMLElement>('[data-copy-msg]');
  if (box && btn && input && msg) {
    btn.hidden = false;
    input.addEventListener('focus', () => input.select());
    input.addEventListener('click', () => input.select());
    const say = (text: string, ok: boolean) => {
      msg.textContent = '';
      msg.classList.toggle('feed__msg--ok', ok);
      msg.classList.toggle('feed__msg--err', !ok);
      // clear first so repeated clicks are announced again
      requestAnimationFrame(() => { msg.textContent = text; });
    };
    btn.addEventListener('click', async () => {
      const value = input.value;
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(value); ok = true; }
      } catch { ok = false; }
      if (!ok) {
        try { input.focus(); input.select(); ok = document.execCommand('copy'); } catch { ok = false; }
      }
      say(ok ? box.dataset.copied! : box.dataset.failed!, ok);
      if (!ok) { input.focus(); input.select(); }
    });
  }
</script>
<style>
  .follow { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .feed { border-top: 6px solid var(--gold); display: grid; gap: .8rem; }
  .feed h2 { margin: 0; display: flex; align-items: center; gap: .5rem; font-size: 1.35rem; }
  .hic { width: 1.1em; height: 1.1em; flex: none; }
  .feed__label { font-weight: 600; font-size: .92rem; }
  .feed__url { width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; font: 400 1rem ui-monospace, 'SF Mono', Menlo, monospace; padding: .75rem .85rem; border: 1px solid var(--line-strong); border-radius: 10px; background: var(--bg-2); color: var(--ink); overflow-wrap: anywhere; }
  .feed__url:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .feed .btn-row { margin-top: .3rem; }
  .feed__msg { margin: 0; min-height: 1.4em; }
  .feed__msg--ok { color: var(--green-text, var(--ink)); font-weight: 700; }
  .feed__msg--err { color: var(--ink); font-weight: 600; }
  .prose h2 { margin-top: 0; }
  .prose h2 + p, .prose h2 ~ h2 { margin-top: 1rem; }
  .prose h2 ~ h2 { margin-top: 2rem; }
  @media (max-width: 860px) { .follow { grid-template-columns: minmax(0, 1fr); } }
</style>
