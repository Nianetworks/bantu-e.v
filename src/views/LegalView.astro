---
// Impressum (§ 5 DDG, § 18 Abs. 2 MStV) and Datenschutzerklärung (Art. 13 DSGVO).
// German text is legally binding; the English page is a courtesy translation.
// Review before go-live: docs/03_Rechtliches_und_Shop-Checkliste.md
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { r, type Lang } from '../i18n';
import { org } from '../data/site';

interface Props { lang: Lang; page: 'imprint' | 'privacy' }
const { lang, page } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const chair = org.board[0].name;
const title = page === 'imprint' ? (de ? 'Impressum' : fr ? 'Mentions légales' : 'Imprint') : (de ? 'Datenschutzerklärung' : fr ? 'Politique de confidentialité' : 'Privacy policy');
const updated = '07.11.2026';
---
<Base lang={lang} title={title} altHref={r(page, de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} />
  <section class="section section--tight">
    <div class="narrow prose legal">
      {!de && <p class="notice notice--info">This is a courtesy translation. The German version is legally binding.</p>}

      {page === 'imprint' && (
        <>
          <h2>{de ? 'Angaben gemäß § 5 DDG' : fr ? 'Informations selon le § 5 DDG (loi allemande sur les services numériques)' : 'Information pursuant to § 5 DDG (German Digital Services Act)'}</h2>
          <p>{org.legalName}<br />{org.address.street}<br />{org.address.zip} {org.address.city}<br />{de ? 'Deutschland' : fr ? 'Allemagne' : 'Germany'}</p>
          <p>{de ? 'Postanschrift' : fr ? 'Adresse postale' : 'Postal address'}: {org.postbox.line}, {org.postbox.zip} {org.postbox.city}</p>
          <h3>{de ? 'Vertreten durch den Vorstand' : fr ? 'Représentée par le conseil d’administration' : 'Represented by the board'}</h3>
          <p>{chair} ({de ? 'Vorsitzender' : fr ? 'Président' : 'Chair'})<br /><span class="small muted">{de ? 'Jedes Vorstandsmitglied vertritt den Verein einzeln (§ 26 BGB).' : fr ? 'Chaque membre du conseil d’administration représente seul l’association (§ 26 BGB).' : 'Each board member represents the association individually (§ 26 BGB).'}</span></p>
          <h3>{de ? 'Kontakt' : fr ? 'Contact' : 'Contact'}</h3>
          <p>{de ? 'Telefon (Büro)' : fr ? 'Téléphone (bureau)' : 'Phone (office)'}: {org.officePhone}<br />{de ? 'Mobil' : fr ? 'Mobile' : 'Mobile'}: {org.phone} ({de ? '16 bis 20 Uhr' : fr ? 'de 16 h à 20 h' : '4 pm to 8 pm'})<br />E-Mail: <a href={`mailto:${org.email}`}>{org.email}</a></p>
          <h3>{de ? 'Registereintrag' : fr ? 'Inscription au registre' : 'Register entry'}</h3>
          <p>{de ? 'Eingetragen im Vereinsregister' : fr ? 'Inscrite au registre des associations' : 'Registered in the register of associations'}<br />{de ? 'Registergericht' : fr ? 'Tribunal d’enregistrement' : 'Court of registration'}: {org.register.court}<br />{de ? 'Registernummer' : fr ? 'Numéro d’enregistrement' : 'Register number'}: {org.register.number}</p>
          <h3>{de ? 'Gemeinnützigkeit' : fr ? 'Reconnaissance d’intérêt général' : 'Non-profit status'}</h3>
          <p>{de ? `Als gemeinnützig anerkannt durch das ${org.tax.office}, Steuernummer ${org.tax.number}.` : fr ? `Reconnue d’intérêt général par le Finanzamt für Körperschaften I de Berlin, numéro fiscal ${org.tax.number}.` : `Recognised as a non-profit by the Finanzamt für Körperschaften I, Berlin, tax number ${org.tax.number}.`}</p>
          <h3>{de ? 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV' : fr ? 'Responsable du contenu selon le § 18 al. 2 MStV' : 'Responsible for content pursuant to § 18 (2) MStV'}</h3>
          <p>{chair}, {org.address.street}, {org.address.zip} {org.address.city}</p>
          <h3>{de ? 'Verbraucherstreitbeilegung' : fr ? 'Règlement des litiges de consommation' : 'Consumer dispute resolution'}</h3>
          <p>{de ? 'Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.' : fr ? 'Nous ne sommes ni disposés ni tenus à participer à une procédure de règlement des litiges devant un organisme de médiation de la consommation.' : 'We are neither willing nor obliged to take part in dispute resolution proceedings before a consumer arbitration board.'}</p>
          <h3>{de ? 'Haftung für Inhalte und Links' : fr ? 'Responsabilité pour les contenus et les liens' : 'Liability for content and links'}</h3>
          <p>{de ? 'Wir erstellen die Inhalte dieser Website mit Sorgfalt, übernehmen aber keine Gewähr für Vollständigkeit und Aktualität. Für Inhalte externer Links sind ausschließlich deren Betreiber verantwortlich; zum Zeitpunkt der Verlinkung waren keine Rechtsverstöße erkennbar. Bei Bekanntwerden von Rechtsverletzungen entfernen wir entsprechende Links umgehend.' : fr ? 'Nous créons les contenus de ce site avec soin, mais ne pouvons garantir qu’ils soient complets et à jour. Les exploitants des sites externes liés sont seuls responsables de leurs contenus ; aucune infraction n’était visible au moment de la création du lien. Nous supprimerons rapidement de tels liens si nous apprenons une infraction.' : 'We create the content of this website with care but cannot guarantee that it is complete and up to date. The operators of linked external sites are solely responsible for their content; no legal violations were apparent at the time of linking. We will remove such links promptly if we become aware of any infringement.'}</p>
          <h3>{de ? 'Bildnachweise und Urheberrecht' : fr ? 'Crédits photo et droits d’auteur' : 'Image credits and copyright'}</h3>
          <p>{de ? 'Texte, Logos und Bilder dieser Website sind urheberrechtlich geschützt. Fotos werden nur mit Einwilligung der abgebildeten Personen veröffentlicht. Bildnachweise stehen am jeweiligen Bild.' : fr ? 'Les textes, logos et images de ce site sont protégés par le droit d’auteur. Les photos ne sont publiées qu’avec le consentement des personnes représentées. Les crédits figurent avec chaque image.' : 'Texts, logos and images on this website are protected by copyright. Photos are only published with the consent of the people shown. Credits are given with each image.'}</p>
        </>
      )}

      {page === 'privacy' && (
        <>
          <p class="small muted">{de ? 'Stand' : fr ? 'Dernière mise à jour' : 'Last updated'}: {updated}</p>
          <h2>1. {de ? 'Verantwortlicher' : fr ? 'Responsable du traitement' : 'Controller'}</h2>
          <p>{org.legalName}, {org.address.street}, {org.address.zip} {org.address.city}, E-Mail: <a href={`mailto:${org.email}`}>{org.email}</a>, {de ? 'Telefon' : fr ? 'téléphone' : 'phone'}: {org.officePhone}. {de ? 'Vertreten durch den Vorstand' : fr ? 'Représentée par le conseil d’administration' : 'Represented by the board'} ({chair}).</p>

          <h2>2. {de ? 'Das Wichtigste in Kürze' : fr ? 'En bref' : 'In brief'}</h2>
          <ul>
            <li>{de ? 'Diese Website setzt keine Cookies und verwendet keine Analyse- oder Tracking-Werkzeuge.' : fr ? 'Ce site ne dépose aucun cookie et n’utilise aucun outil d’analyse ou de suivi.' : 'This website sets no cookies and uses no analytics or tracking tools.'}</li>
            <li>{de ? 'Schriften und alle Dateien werden vom Server dieser Website geladen, nicht von Google oder anderen Drittanbietern.' : fr ? 'Les polices et tous les fichiers sont chargés depuis le serveur de ce site, et non depuis Google ou d’autres tiers.' : 'Fonts and all files are loaded from this website’s server, not from Google or other third parties.'}</li>
            <li>{de ? 'Karten, Videos oder Social-Media-Inhalte sind nicht eingebettet, sondern nur verlinkt.' : fr ? 'Les cartes, vidéos et contenus de réseaux sociaux ne sont pas intégrés, seulement liés.' : 'Maps, videos and social media content are not embedded, only linked.'}</li>
            <li>{de ? 'Das Online-Spendenformular (twingle) wird erst nach Ihrem Klick geladen.' : fr ? 'Le formulaire de don en ligne (twingle) n’est chargé qu’après votre clic.' : 'The online donation form (twingle) is only loaded after you click.'}</li>
            <li>{de ? 'Bestellungen im Shop verarbeiten wir auf unserem eigenen Server; bezahlt wird per Überweisung direkt an uns (Abschnitt 7).' : fr ? 'Les commandes de la boutique sont traitées sur notre propre serveur ; le paiement se fait par virement directement à notre association (section 7).' : 'Shop orders are processed on our own server; payment is by bank transfer straight to us (section 7).'}</li>
          </ul>

          <h2>3. {de ? 'Hosting und Server-Logfiles' : fr ? 'Hébergement et fichiers journaux du serveur' : 'Hosting and server log files'}</h2>
          {/* OPEN: name the hosting provider (data centre) and confirm the data processing agreement (AV-Vertrag) and log retention period. */}
          <p>{de
            ? 'Diese Website liegt auf einem Webserver, den wir bei einem Hosting-Dienstleister mit Rechenzentrum in der Europäischen Union betreiben. Beim Aufruf der Seiten verarbeitet der Server technisch notwendige Daten, insbesondere Ihre IP-Adresse, Datum und Uhrzeit des Zugriffs, die aufgerufene Seite, die zuvor besuchte Seite sowie Browser- und Systeminformationen. Diese Daten werden in Server-Logfiles gespeichert, um die Website auszuliefern, Fehler zu beheben und Angriffe abzuwehren, und nach kurzer Zeit automatisch gelöscht. Rechtsgrundlage ist unser berechtigtes Interesse an einer sicheren und zuverlässigen Bereitstellung der Website (Art. 6 Abs. 1 lit. f DSGVO). Mit dem Dienstleister besteht ein Vertrag zur Auftragsverarbeitung (Art. 28 DSGVO).'
            : fr ? 'Ce site fonctionne sur un serveur web que nous exploitons avec un hébergeur dont le centre de données se trouve dans l’Union européenne. Lors de votre visite, le serveur traite des données techniquement nécessaires : notamment votre adresse IP, la date et l’heure de l’accès, la page demandée, la page de provenance et des informations sur le navigateur et le système. Ces données sont enregistrées dans des fichiers journaux afin de fournir le site, de corriger des erreurs et de repousser des attaques, et elles sont supprimées automatiquement après une courte durée. La base légale est notre intérêt légitime à disposer d’un site sûr et fiable (art. 6, par. 1, point f, RGPD). Nous avons conclu un contrat de sous-traitance avec l’hébergeur (art. 28 RGPD).' : 'This website runs on a web server that we operate with a hosting provider whose data centre is in the European Union. When you visit the pages, the server processes technically necessary data: in particular your IP address, date and time of access, the page requested, the referring page and browser/system information. This data is stored in server log files to deliver the website, fix errors and fend off attacks, and is deleted automatically after a short time. The legal basis is our legitimate interest in a secure and reliable website (Art. 6(1)(f) GDPR). We have a data processing agreement with the provider (Art. 28 GDPR).'}</p>

          <h2>4. {de ? 'Kontakt per E-Mail, Telefon und Kontaktformular' : fr ? 'Contact par e-mail, téléphone et formulaire' : 'Contact by e-mail, phone and contact form'}</h2>
          <p>{de
            ? 'Wenn Sie uns kontaktieren, verarbeiten wir Ihre Angaben (z. B. Name, E-Mail-Adresse, Nachricht), um Ihre Anfrage zu beantworten (Art. 6 Abs. 1 lit. b bzw. f DSGVO). Das Kontaktformular übermittelt keine Daten an einen Server, sondern öffnet Ihr eigenes E-Mail-Programm. Wir löschen die Daten, wenn sie nicht mehr erforderlich sind und keine gesetzlichen Aufbewahrungspflichten bestehen.'
            : fr ? 'Lorsque vous nous contactez, nous traitons vos données (par exemple nom, adresse e-mail, message) pour répondre à votre demande (art. 6, par. 1, points b ou f, RGPD). Le formulaire de contact n’envoie aucune donnée à un serveur ; il ouvre votre propre application de messagerie. Nous supprimons les données lorsqu’elles ne sont plus nécessaires et qu’aucune obligation légale de conservation ne s’applique.' : 'When you contact us, we process your details (e.g. name, e-mail address, message) to answer your enquiry (Art. 6(1)(b) or (f) GDPR). The contact form does not send data to a server; it opens your own e-mail app. We delete the data when it is no longer needed and no statutory retention obligations apply.'}</p>

          <h2>5. {de ? 'Anmeldung zu Veranstaltungen' : fr ? 'Inscription aux événements' : 'Event registration'}</h2>
          <p>{de
            ? 'Für Veranstaltungen verarbeiten wir Ihre Anmeldedaten, um die Veranstaltung zu organisieren und, soweit Fördermittelgeber dies verlangen, die Teilnahme nachzuweisen (Art. 6 Abs. 1 lit. b, c und f DSGVO). Fotos, auf denen Sie erkennbar sind, veröffentlichen wir nur mit Ihrer Einwilligung (Art. 6 Abs. 1 lit. a DSGVO), die Sie jederzeit widerrufen können. Bei Kindern ist die Einwilligung der Erziehungsberechtigten erforderlich. Für die Anmeldung zu einzelnen Veranstaltungen (z. B. Ubuntu Talks) nutzen wir Google Forms der Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irland. Dabei werden Ihre Angaben im Formular sowie technische Daten an Google übertragen; eine Übermittlung in die USA ist möglich (Google ist nach dem EU-US Data Privacy Framework zertifiziert, Art. 45 DSGVO). Darauf weisen wir in der jeweiligen Einladung hin. Sie können sich stattdessen auch per E-Mail anmelden.'
            : fr ? 'Pour les événements, nous traitons vos données d’inscription afin d’organiser l’événement et, lorsque les bailleurs l’exigent, de justifier la participation (art. 6, par. 1, points b, c et f, RGPD). Nous ne publions des photos sur lesquelles vous êtes reconnaissable qu’avec votre consentement (art. 6, par. 1, point a, RGPD), que vous pouvez retirer à tout moment. Pour les enfants, le consentement d’un parent ou d’un tuteur est nécessaire. Pour l’inscription à certains événements (par exemple les Ubuntu Talks), nous utilisons Google Forms de Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irlande. Les données saisies et des données techniques sont transmises à Google ; un transfert vers les États-Unis est possible (Google est certifié selon le EU-US Data Privacy Framework, art. 45 RGPD). Nous le signalons dans chaque invitation. Vous pouvez aussi vous inscrire par e-mail.' : 'For events we process your registration data to organise the event and, where funders require it, to document attendance (Art. 6(1)(b), (c) and (f) GDPR). We only publish photos in which you are recognisable with your consent (Art. 6(1)(a) GDPR), which you can withdraw at any time. For children, the consent of a parent or guardian is required. For registration to some events (e.g. Ubuntu Talks) we use Google Forms by Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Ireland. The details you enter and technical data are transferred to Google; a transfer to the USA is possible (Google is certified under the EU-US Data Privacy Framework, Art. 45 GDPR). We point this out in the respective invitation. You can also register by e-mail instead.'}</p>

          <h2>6. {de ? 'Spenden und Mitgliedschaft' : fr ? 'Dons et adhésion' : 'Donations and membership'}</h2>
          <p>{de
            ? 'Bei Spenden und Mitgliedschaften verarbeiten wir die Daten, die für die Abwicklung, die Ausstellung von Zuwendungsbestätigungen und die Mitgliederverwaltung erforderlich sind (Art. 6 Abs. 1 lit. b und c DSGVO). Steuerrechtlich relevante Unterlagen bewahren wir entsprechend den gesetzlichen Fristen auf.'
            : fr ? 'Pour les dons et les adhésions, nous traitons les données nécessaires au traitement, à l’établissement des reçus fiscaux et à la gestion des membres (art. 6, par. 1, points b et c, RGPD). Nous conservons les documents fiscalement pertinents pendant les durées légales.' : 'For donations and memberships we process the data needed for processing, issuing donation receipts and membership administration (Art. 6(1)(b) and (c) GDPR). We keep documents relevant for tax purposes for the statutory periods.'}</p>

          <h2 id="bestellformular">7. {de ? 'Bestellformular im Shop' : fr ? 'Formulaire de commande de la boutique' : 'Order form in the shop'}</h2>
          {/* Added 08.11.2026 with the order form (public/shop/bestellung.php). ⚖️ Have it checked together with the rest of this policy. */}
          <p>{de
            ? 'Wenn Sie im Shop ein Spendengeschenk oder, sobald der Warenverkauf geöffnet ist, eine Ware bestellen, verarbeiten wir die Angaben aus dem Bestellformular (Name, E-Mail-Adresse, bei Bedarf Anschrift, gewähltes Angebot, Betrag oder Menge, Ihre Nachricht) und den Verwendungszweck, den wir Ihrer Bestellung geben. Wir nutzen sie, um die Bestellung oder Spende abzuwickeln, Ihnen die Zahlungsangaben zu schicken, Ihre Überweisung zuzuordnen und, wenn Sie das wünschen, eine Zuwendungsbestätigung auszustellen (Art. 6 Abs. 1 lit. b und c DSGVO).'
            : fr ? 'Lorsque vous commandez dans la boutique un don-cadeau ou, dès que la vente sera ouverte, un article, nous traitons les données du formulaire de commande (nom, adresse e-mail, adresse postale si nécessaire, offre choisie, montant ou quantité, votre message) ainsi que le motif de virement attribué à votre commande. Nous les utilisons pour traiter la commande ou le don, vous envoyer les informations de paiement, attribuer votre virement et, si vous le souhaitez, établir un reçu fiscal (art. 6, par. 1, points b et c, RGPD).'
            : 'When you order a gift donation or, once sales are open, goods in our shop, we process the details from the order form (name, e-mail address, postal address where needed, chosen item, amount or quantity, your message) and the payment reference we give your order. We use them to process the order or donation, send you the payment details, match your transfer and, if you wish, issue a donation receipt (Art. 6(1)(b) and (c) GDPR).'}</p>
          <p>{de
            ? 'Das Formular wird auf unserem eigenen Webserver verarbeitet, ohne externe Dienste. Die Bestellung geht per E-Mail an uns und als Bestätigung an Sie; eine Kopie speichern wir geschützt auf unserem Server außerhalb des öffentlich erreichbaren Bereichs. Zum Schutz vor Missbrauch speichern wir Ihre IP-Adresse höchstens eine Stunde lang nur als nicht lesbare Prüfsumme (Hash), um zu viele Bestellungen in kurzer Zeit zu verhindern (Art. 6 Abs. 1 lit. f DSGVO). Bezahlt wird per Überweisung direkt auf unser Konto bei der GLS Bank; ein Zahlungsdienstleister ist nicht beteiligt. Wir löschen die Angaben, wenn sie nicht mehr gebraucht werden; Unterlagen, die wir steuerrechtlich aufbewahren müssen, bewahren wir für die gesetzlichen Fristen auf.'
            : fr ? 'Le formulaire est traité sur notre propre serveur web, sans service externe. La commande nous est envoyée par e-mail et vous recevez une confirmation ; nous en conservons une copie protégée sur notre serveur, en dehors de la partie accessible au public. Pour éviter les abus, nous enregistrons votre adresse IP pendant une heure au maximum, uniquement sous forme d’empreinte illisible (hachage), afin d’empêcher un trop grand nombre de commandes en peu de temps (art. 6, par. 1, point f, RGPD). Le paiement se fait par virement directement sur notre compte à la GLS Bank ; aucun prestataire de paiement n’intervient. Nous supprimons les données lorsqu’elles ne sont plus nécessaires ; les documents que nous devons conserver pour des raisons fiscales sont gardés pendant les durées légales.'
            : 'The form is processed on our own web server, without external services. The order is e-mailed to us and a confirmation to you; we keep a protected copy on our server outside the publicly reachable area. To prevent misuse, we store your IP address for at most one hour, only as an unreadable checksum (hash), to stop too many orders in a short time (Art. 6(1)(f) GDPR). Payment is by bank transfer straight to our account at GLS Bank; no payment provider is involved. We delete the details when they are no longer needed; records we have to keep for tax reasons are kept for the statutory periods.'}</p>

          <h2>8. {de ? 'Online-Spendenformular (twingle)' : fr ? 'Formulaire de don en ligne (twingle)' : 'Online donation form (twingle)'}</h2>
          {/* OPEN: confirm the data processing agreement (AV-Vertrag) with twingle GmbH. */}
          <p>{de
            ? 'Für Online-Spenden nutzen wir das Spendenformular der twingle GmbH. Das Formular wird erst geladen, wenn Sie auf der Seite „Spenden“ ausdrücklich „Zum Spendenformular“ oder „Formular hier anzeigen“ wählen. Dann werden Ihre IP-Adresse und technische Daten an twingle übertragen; die Angaben, die Sie im Formular machen (z. B. Name, Anschrift, E-Mail-Adresse, Betrag, Bankverbindung), verarbeitet twingle in unserem Auftrag, um Ihre Spende abzuwickeln und Ihnen eine Zuwendungsbestätigung auszustellen (Art. 6 Abs. 1 lit. b und c DSGVO). Es gelten ergänzend die Datenschutzhinweise von twingle, die im Formular verlinkt sind.'
            : fr ? 'Pour les dons en ligne, nous utilisons le formulaire de twingle GmbH. Il n’est chargé que si vous choisissez expressément « Ouvrir le formulaire de don » ou « Afficher le formulaire sur cette page » sur la page des dons. Votre adresse IP et des données techniques sont alors transmises à twingle ; les données saisies dans le formulaire (par exemple nom, adresse, e-mail, montant, coordonnées bancaires) sont traitées par twingle pour notre compte afin de gérer votre don et d’établir un reçu fiscal (art. 6, par. 1, points b et c, RGPD). La politique de confidentialité de twingle, liée dans le formulaire, s’applique également.' : 'For online donations we use the donation form of twingle GmbH. The form is only loaded when you explicitly choose “Open the donation form” or “Show the form on this page” on the donate page. Your IP address and technical data are then transferred to twingle; the details you enter in the form (e.g. name, address, e-mail address, amount, bank details) are processed by twingle on our behalf to handle your donation and issue a donation receipt (Art. 6(1)(b) and (c) GDPR). twingle’s privacy notice, linked in the form, also applies.'}</p>

          <h2>9. {de ? 'Externe Links' : fr ? 'Liens externes' : 'External links'}</h2>
          <p>{de
            ? 'Unsere Seiten verlinken auf externe Angebote, z. B. Instagram, Facebook, X, OpenStreetMap oder später Zahlungsdienstleister im Shop. Erst wenn Sie einen Link anklicken, werden Daten an den jeweiligen Anbieter übertragen; dort gelten dessen Datenschutzbestimmungen.'
            : fr ? 'Nos pages renvoient à des services externes comme Instagram, Facebook, X, OpenStreetMap ou, plus tard, des prestataires de paiement dans la boutique. Des données ne sont transmises au prestataire concerné que lorsque vous cliquez sur un lien ; sa politique de confidentialité s’applique alors.' : 'Our pages link to external services such as Instagram, Facebook, X, OpenStreetMap or, later, payment providers in the shop. Data is only transferred to the respective provider when you click a link; their privacy policies apply there.'}</p>

          <h2>10. {de ? 'Ihre Rechte' : fr ? 'Vos droits' : 'Your rights'}</h2>
          <p>{de
            ? 'Sie haben das Recht auf Auskunft (Art. 15 DSGVO), Berichtigung (Art. 16), Löschung (Art. 17), Einschränkung der Verarbeitung (Art. 18), Datenübertragbarkeit (Art. 20) und Widerspruch (Art. 21) sowie das Recht, erteilte Einwilligungen jederzeit mit Wirkung für die Zukunft zu widerrufen (Art. 7 Abs. 3). Wenden Sie sich dazu an '
            : fr ? 'Vous disposez d’un droit d’accès (art. 15 RGPD), de rectification (art. 16), d’effacement (art. 17), de limitation du traitement (art. 18), de portabilité (art. 20) et d’opposition (art. 21), et vous pouvez retirer votre consentement à tout moment pour l’avenir (art. 7, par. 3). Veuillez contacter ' : 'You have the right of access (Art. 15 GDPR), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18), data portability (Art. 20) and objection (Art. 21), and you may withdraw consent at any time with effect for the future (Art. 7(3)). Please contact '}<a href={`mailto:${org.email}`}>{org.email}</a>.</p>
          <p>{de
            ? 'Sie können sich außerdem bei einer Datenschutz-Aufsichtsbehörde beschweren, z. B. bei der Berliner Beauftragten für Datenschutz und Informationsfreiheit, Alt-Moabit 59–61, 10555 Berlin.'
            : fr ? 'Vous pouvez aussi déposer une plainte auprès d’une autorité de contrôle de la protection des données, par exemple la Commissaire berlinoise à la protection des données et à la liberté d’information, Alt-Moabit 59–61, 10555 Berlin.' : 'You may also lodge a complaint with a data protection supervisory authority, e.g. the Berlin Commissioner for Data Protection and Freedom of Information, Alt-Moabit 59–61, 10555 Berlin.'}</p>
        </>
      )}
    </div>
  </section>
</Base>
<style>
  .legal h2 { font-size: 1.3rem; }
  .legal h3 { font-size: 1.05rem; font-family: var(--font-sans); margin-top: 1.4rem; }
</style>
