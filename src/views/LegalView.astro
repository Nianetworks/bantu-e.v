---
// Impressum (§ 5 DDG, § 18 Abs. 2 MStV) and Datenschutzerklärung (Art. 13 DSGVO).
// German text is legally binding; the English page is a courtesy translation.
// Review before go-live: docs/03_Rechtliches_und_Shop-Checkliste.md
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { r, type Lang } from '../i18n';
import { org } from '../data/site';

interface Props { lang: Lang; page: 'imprint' | 'privacy' }
const { lang, page } = Astro.props;
const de = lang === 'de';
const chair = org.board[0].name;
const title = page === 'imprint' ? (de ? 'Impressum' : 'Imprint') : (de ? 'Datenschutzerklärung' : 'Privacy policy');
const updated = '07.11.2026';
---
<Base lang={lang} title={title} altHref={r(page, de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} />
  <section class="section section--tight">
    <div class="narrow prose legal">
      {!de && <p class="notice notice--info">This is a courtesy translation. The German version is legally binding.</p>}

      {page === 'imprint' && (
        <>
          <h2>{de ? 'Angaben gemäß § 5 DDG' : 'Information pursuant to § 5 DDG (German Digital Services Act)'}</h2>
          <p>{org.legalName}<br />{org.address.street}<br />{org.address.zip} {org.address.city}<br />{de ? 'Deutschland' : 'Germany'}</p>
          <p>{de ? 'Postanschrift' : 'Postal address'}: {org.postbox.line}, {org.postbox.zip} {org.postbox.city}</p>
          <h3>{de ? 'Vertreten durch den Vorstand' : 'Represented by the board'}</h3>
          <p>{chair} ({de ? 'Vorsitzender' : 'Chair'})<br /><span class="small muted">{de ? 'Jedes Vorstandsmitglied vertritt den Verein einzeln (§ 26 BGB).' : 'Each board member represents the association individually (§ 26 BGB).'}</span></p>
          <h3>{de ? 'Kontakt' : 'Contact'}</h3>
          <p>{de ? 'Telefon' : 'Phone'}: {org.phone}<br />E-Mail: <a href={`mailto:${org.email}`}>{org.email}</a></p>
          <h3>{de ? 'Registereintrag' : 'Register entry'}</h3>
          <p>{de ? 'Eingetragen im Vereinsregister' : 'Registered in the register of associations'}<br />{de ? 'Registergericht' : 'Court of registration'}: {org.register.court}<br />{de ? 'Registernummer' : 'Register number'}: {org.register.number}</p>
          <h3>{de ? 'Gemeinnützigkeit' : 'Non-profit status'}</h3>
          <p>{de ? `Als gemeinnützig anerkannt durch das ${org.tax.office}, Steuernummer ${org.tax.number}.` : `Recognised as a non-profit by the Finanzamt für Körperschaften I, Berlin, tax number ${org.tax.number}.`}</p>
          <h3>{de ? 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV' : 'Responsible for content pursuant to § 18 (2) MStV'}</h3>
          <p>{chair}, {org.address.street}, {org.address.zip} {org.address.city}</p>
          <h3>{de ? 'Verbraucherstreitbeilegung' : 'Consumer dispute resolution'}</h3>
          <p>{de ? 'Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.' : 'We are neither willing nor obliged to take part in dispute resolution proceedings before a consumer arbitration board.'}</p>
          <h3>{de ? 'Haftung für Inhalte und Links' : 'Liability for content and links'}</h3>
          <p>{de ? 'Wir erstellen die Inhalte dieser Website mit Sorgfalt, übernehmen aber keine Gewähr für Vollständigkeit und Aktualität. Für Inhalte externer Links sind ausschließlich deren Betreiber verantwortlich; zum Zeitpunkt der Verlinkung waren keine Rechtsverstöße erkennbar. Bei Bekanntwerden von Rechtsverletzungen entfernen wir entsprechende Links umgehend.' : 'We create the content of this website with care but cannot guarantee that it is complete and up to date. The operators of linked external sites are solely responsible for their content; no legal violations were apparent at the time of linking. We will remove such links promptly if we become aware of any infringement.'}</p>
          <h3>{de ? 'Bildnachweise und Urheberrecht' : 'Image credits and copyright'}</h3>
          <p>{de ? 'Texte, Logos und Bilder dieser Website sind urheberrechtlich geschützt. Fotos werden nur mit Einwilligung der abgebildeten Personen veröffentlicht. Bildnachweise stehen am jeweiligen Bild.' : 'Texts, logos and images on this website are protected by copyright. Photos are only published with the consent of the people shown. Credits are given with each image.'}</p>
        </>
      )}

      {page === 'privacy' && (
        <>
          <p class="small muted">{de ? 'Stand' : 'Last updated'}: {updated}</p>
          <h2>1. {de ? 'Verantwortlicher' : 'Controller'}</h2>
          <p>{org.legalName}, {org.address.street}, {org.address.zip} {org.address.city}, E-Mail: <a href={`mailto:${org.email}`}>{org.email}</a>, {de ? 'Telefon' : 'phone'}: {org.phone}. {de ? 'Vertreten durch den Vorstand' : 'Represented by the board'} ({chair}).</p>

          <h2>2. {de ? 'Das Wichtigste in Kürze' : 'In brief'}</h2>
          <ul>
            <li>{de ? 'Diese Website setzt keine Cookies und verwendet keine Analyse- oder Tracking-Werkzeuge.' : 'This website sets no cookies and uses no analytics or tracking tools.'}</li>
            <li>{de ? 'Schriften und alle Dateien werden vom Server dieser Website geladen – nicht von Google oder anderen Drittanbietern.' : 'Fonts and all files are loaded from this website’s server – not from Google or other third parties.'}</li>
            <li>{de ? 'Karten, Videos oder Social-Media-Inhalte sind nicht eingebettet, sondern nur verlinkt.' : 'Maps, videos and social media content are not embedded, only linked.'}</li>
            <li>{de ? 'Das Online-Spendenformular (twingle) wird erst nach Ihrem Klick geladen.' : 'The online donation form (twingle) is only loaded after you click.'}</li>
          </ul>

          <h2>3. {de ? 'Hosting und Server-Logfiles' : 'Hosting and server log files'}</h2>
          {/* OPEN: name the hosting provider (data centre) and confirm the data processing agreement (AV-Vertrag) and log retention period. */}
          <p>{de
            ? 'Diese Website liegt auf einem Webserver, den wir bei einem Hosting-Dienstleister mit Rechenzentrum in der Europäischen Union betreiben. Beim Aufruf der Seiten verarbeitet der Server technisch notwendige Daten, insbesondere Ihre IP-Adresse, Datum und Uhrzeit des Zugriffs, die aufgerufene Seite, die zuvor besuchte Seite sowie Browser- und Systeminformationen. Diese Daten werden in Server-Logfiles gespeichert, um die Website auszuliefern, Fehler zu beheben und Angriffe abzuwehren, und nach kurzer Zeit automatisch gelöscht. Rechtsgrundlage ist unser berechtigtes Interesse an einer sicheren und zuverlässigen Bereitstellung der Website (Art. 6 Abs. 1 lit. f DSGVO). Mit dem Dienstleister besteht ein Vertrag zur Auftragsverarbeitung (Art. 28 DSGVO).'
            : 'This website runs on a web server that we operate with a hosting provider whose data centre is in the European Union. When you visit the pages, the server processes technically necessary data – in particular your IP address, date and time of access, the page requested, the referring page and browser/system information. This data is stored in server log files to deliver the website, fix errors and fend off attacks, and is deleted automatically after a short time. The legal basis is our legitimate interest in a secure and reliable website (Art. 6(1)(f) GDPR). We have a data processing agreement with the provider (Art. 28 GDPR).'}</p>

          <h2>4. {de ? 'Kontakt per E-Mail, Telefon und Kontaktformular' : 'Contact by e-mail, phone and contact form'}</h2>
          <p>{de
            ? 'Wenn Sie uns kontaktieren, verarbeiten wir Ihre Angaben (z. B. Name, E-Mail-Adresse, Nachricht), um Ihre Anfrage zu beantworten (Art. 6 Abs. 1 lit. b bzw. f DSGVO). Das Kontaktformular übermittelt keine Daten an einen Server, sondern öffnet Ihr eigenes E-Mail-Programm. Wir löschen die Daten, wenn sie nicht mehr erforderlich sind und keine gesetzlichen Aufbewahrungspflichten bestehen.'
            : 'When you contact us, we process your details (e.g. name, e-mail address, message) to answer your enquiry (Art. 6(1)(b) or (f) GDPR). The contact form does not send data to a server; it opens your own e-mail app. We delete the data when it is no longer needed and no statutory retention obligations apply.'}</p>

          <h2>5. {de ? 'Anmeldung zu Veranstaltungen' : 'Event registration'}</h2>
          <p>{de
            ? 'Für Veranstaltungen verarbeiten wir Ihre Anmeldedaten, um die Veranstaltung zu organisieren und – soweit Fördermittelgeber dies verlangen – die Teilnahme nachzuweisen (Art. 6 Abs. 1 lit. b, c und f DSGVO). Fotos, auf denen Sie erkennbar sind, veröffentlichen wir nur mit Ihrer Einwilligung (Art. 6 Abs. 1 lit. a DSGVO), die Sie jederzeit widerrufen können. Bei Kindern ist die Einwilligung der Erziehungsberechtigten erforderlich. Für einzelne Veranstaltungen nutzen wir Online-Anmeldeformulare externer Anbieter; darauf weisen wir in der jeweiligen Einladung hin.'
            : 'For events we process your registration data to organise the event and – where funders require it – to document attendance (Art. 6(1)(b), (c) and (f) GDPR). We only publish photos in which you are recognisable with your consent (Art. 6(1)(a) GDPR), which you can withdraw at any time. For children, the consent of a parent or guardian is required. For some events we use online registration forms by external providers; we point this out in the respective invitation.'}</p>

          <h2>6. {de ? 'Spenden und Mitgliedschaft' : 'Donations and membership'}</h2>
          <p>{de
            ? 'Bei Spenden und Mitgliedschaften verarbeiten wir die Daten, die für die Abwicklung, die Ausstellung von Zuwendungsbestätigungen und die Mitgliederverwaltung erforderlich sind (Art. 6 Abs. 1 lit. b und c DSGVO). Steuerrechtlich relevante Unterlagen bewahren wir entsprechend den gesetzlichen Fristen auf.'
            : 'For donations and memberships we process the data needed for processing, issuing donation receipts and membership administration (Art. 6(1)(b) and (c) GDPR). We keep documents relevant for tax purposes for the statutory periods.'}</p>

          <h2>7. {de ? 'Online-Spendenformular (twingle)' : 'Online donation form (twingle)'}</h2>
          {/* OPEN: confirm the data processing agreement (AV-Vertrag) with twingle GmbH. */}
          <p>{de
            ? 'Für Online-Spenden nutzen wir das Spendenformular der twingle GmbH. Das Formular wird erst geladen, wenn Sie auf der Seite „Spenden“ ausdrücklich „Zum Spendenformular“ oder „Formular hier anzeigen“ wählen. Dann werden Ihre IP-Adresse und technische Daten an twingle übertragen; die Angaben, die Sie im Formular machen (z. B. Name, Anschrift, E-Mail-Adresse, Betrag, Bankverbindung), verarbeitet twingle in unserem Auftrag, um Ihre Spende abzuwickeln und Ihnen eine Zuwendungsbestätigung auszustellen (Art. 6 Abs. 1 lit. b und c DSGVO). Es gelten ergänzend die Datenschutzhinweise von twingle, die im Formular verlinkt sind.'
            : 'For online donations we use the donation form of twingle GmbH. The form is only loaded when you explicitly choose “Open the donation form” or “Show the form on this page” on the donate page. Your IP address and technical data are then transferred to twingle; the details you enter in the form (e.g. name, address, e-mail address, amount, bank details) are processed by twingle on our behalf to handle your donation and issue a donation receipt (Art. 6(1)(b) and (c) GDPR). twingle’s privacy notice, linked in the form, also applies.'}</p>

          <h2>8. {de ? 'Externe Links' : 'External links'}</h2>
          <p>{de
            ? 'Unsere Seiten verlinken auf externe Angebote, z. B. Instagram, Facebook, X, OpenStreetMap oder später Zahlungsdienstleister im Shop. Erst wenn Sie einen Link anklicken, werden Daten an den jeweiligen Anbieter übertragen; dort gelten dessen Datenschutzbestimmungen.'
            : 'Our pages link to external services such as Instagram, Facebook, X, OpenStreetMap or, later, payment providers in the shop. Data is only transferred to the respective provider when you click a link; their privacy policies apply there.'}</p>

          <h2>9. {de ? 'Ihre Rechte' : 'Your rights'}</h2>
          <p>{de
            ? 'Sie haben das Recht auf Auskunft (Art. 15 DSGVO), Berichtigung (Art. 16), Löschung (Art. 17), Einschränkung der Verarbeitung (Art. 18), Datenübertragbarkeit (Art. 20) und Widerspruch (Art. 21) sowie das Recht, erteilte Einwilligungen jederzeit mit Wirkung für die Zukunft zu widerrufen (Art. 7 Abs. 3). Wenden Sie sich dazu an '
            : 'You have the right of access (Art. 15 GDPR), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18), data portability (Art. 20) and objection (Art. 21), and you may withdraw consent at any time with effect for the future (Art. 7(3)). Please contact '}<a href={`mailto:${org.email}`}>{org.email}</a>.</p>
          <p>{de
            ? 'Sie können sich außerdem bei einer Datenschutz-Aufsichtsbehörde beschweren, z. B. bei der Berliner Beauftragten für Datenschutz und Informationsfreiheit, Alt-Moabit 59–61, 10555 Berlin.'
            : 'You may also lodge a complaint with a data protection supervisory authority, e.g. the Berlin Commissioner for Data Protection and Freedom of Information, Alt-Moabit 59–61, 10555 Berlin.'}</p>
        </>
      )}
    </div>
  </section>
</Base>
<style>
  .legal h2 { font-size: 1.3rem; }
  .legal h3 { font-size: 1.05rem; font-family: var(--font-sans); margin-top: 1.4rem; }
</style>
