---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import NewsCard from '../components/NewsCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { r, ui, type Lang } from '../i18n';
import { getEvents, getNews } from '../lib/content';

// News page. The events page has its own view (EventsView.astro) since 09.11.2026.
interface Props { lang: Lang; mode?: 'news' }
const { lang } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';
const t = ui[lang];
const { upcoming } = await getEvents(lang);
const news = (await getNews(lang)).filter((n) => n.data.type !== 'event');
const title = de ? 'Aktuelles' : fr ? 'Actualités' : 'News';
const lead = de ? 'Neuigkeiten, Ankündigungen und Termine von Bantu e.V.' : fr ? 'Actualités, annonces et événements de Bantu e.V.' : 'News, announcements and events from Bantu e.V.';
---
<Base lang={lang} title={title} description={lead} altHref={r('news', de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <div class="btn-row tabs">
      <a class="btn btn--dark" href={r('news', lang)} aria-current="page">{de ? 'Neuigkeiten' : fr ? 'Actualités' : 'News'}</a>
      <a class="btn btn--outline" href={r('events', lang)}>{de ? 'Veranstaltungen' : fr ? 'Événements' : 'Events'}</a>
    </div>
  </PageHead>

  <section class="section section--tight">
    <div class="wrap">
      <h2>{t.upcoming}</h2>
      {upcoming.length > 0
        ? <div class="grid grid--3">{upcoming.map((n) => <NewsCard lang={lang} item={n} showImage />)}</div>
        : <p class="muted">{t.noUpcoming}</p>}
      <p class="more"><a class="link-arrow" href={r('events', lang)}>{de ? 'Alle Termine und Rückblick auf unsere Veranstaltungen' : fr ? 'Toutes les dates et rétrospective de nos événements' : 'All dates and a look back at our events'}</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>{de ? 'Neuigkeiten' : fr ? 'Dernières nouvelles' : 'Latest news'}</h2>
      <div class="grid grid--3">{news.map((n) => <NewsCard lang={lang} item={n} />)}</div>
      <div class="follow">
        <p class="follow__h">{de ? 'Folgen Sie uns in den sozialen Medien:' : fr ? 'Suivez-nous sur les réseaux sociaux :' : 'Follow us on social media:'}</p>
        <SocialLinks lang={lang} />
      </div>
    </div>
  </section>
</Base>
<style>
  .tabs { margin-top: 1.25rem; }
  .tabs .btn { padding: .55rem 1.1rem; }
  .follow { margin-top: 2.25rem; display: grid; gap: .6rem; }
  .follow__h { margin: 0; font-weight: 700; }
  .more { margin: 1.25rem 0 0; font-weight: 700; }
</style>
