---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import NewsCard from '../components/NewsCard.astro';
import { r, ui, type Lang } from '../i18n';
import { getEvents, getNews } from '../lib/content';
import { org } from '../data/site';

interface Props { lang: Lang; mode: 'news' | 'events' }
const { lang, mode } = Astro.props;
const de = lang === 'de';
const t = ui[lang];
const { upcoming, past } = await getEvents(lang);
const news = (await getNews(lang)).filter((n) => n.data.type !== 'event');
const title = mode === 'news' ? (de ? 'Aktuelles' : 'News') : (de ? 'Veranstaltungen' : 'Events');
const lead = mode === 'news'
  ? (de ? 'Neuigkeiten, Ankündigungen und Termine von Bantu e.V.' : 'News, announcements and events from Bantu e.V.')
  : (de ? 'Workshops, Begegnungen und Schulungen – meist kostenfrei und mit Kinderbetreuung.' : 'Workshops, encounters and trainings – mostly free of charge and with childcare.');
---
<Base lang={lang} title={title} description={lead} altHref={r(mode, de ? 'en' : 'de')}>
  <PageHead lang={lang} title={title} lead={lead}>
    <div class="btn-row tabs">
      <a class={`btn ${mode === 'news' ? 'btn--dark' : 'btn--outline'}`} href={r('news', lang)} aria-current={mode === 'news' ? 'page' : undefined}>{de ? 'Neuigkeiten' : 'News'}</a>
      <a class={`btn ${mode === 'events' ? 'btn--dark' : 'btn--outline'}`} href={r('events', lang)} aria-current={mode === 'events' ? 'page' : undefined}>{de ? 'Veranstaltungen' : 'Events'}</a>
    </div>
  </PageHead>

  <section class="section section--tight">
    <div class="wrap">
      <h2>{t.upcoming}</h2>
      {upcoming.length > 0
        ? <div class="grid grid--3">{upcoming.map((n) => <NewsCard lang={lang} item={n} showImage />)}</div>
        : <p class="muted">{t.noUpcoming}</p>}
    </div>
  </section>

  {mode === 'news' && (
    <section class="section section--alt">
      <div class="wrap">
        <h2>{de ? 'Neuigkeiten' : 'Latest news'}</h2>
        <div class="grid grid--3">{news.map((n) => <NewsCard lang={lang} item={n} />)}</div>
        <p class="small muted rss">RSS: <a href={r('news', lang).replace(/\/$/, '') + '/rss.xml'}>{de ? 'Neuigkeiten abonnieren' : 'Subscribe to news'}</a> · Instagram: <a href={org.socials[0].url}>@bantu_ev</a></p>
      </div>
    </section>
  )}

  {mode === 'events' && past.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <h2>{t.past}</h2>
        <div class="grid grid--3">{past.map((n) => <NewsCard lang={lang} item={n} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .tabs { margin-top: 1.25rem; }
  .tabs .btn { padding: .55rem 1.1rem; }
  .rss { margin-top: 2rem; }
</style>
