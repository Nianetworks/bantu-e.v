---
// Symbolic gifts (donations with the bank-transfer order form) live under the donate page (chair, 08.11.2026).
import ProductView from '../../../views/ProductView.astro';
import { products } from '../../../data/shop';
export function getStaticPaths() {
  return products.filter((product) => product.category === 'gifts').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---
<ProductView lang="fr" product={product} />
