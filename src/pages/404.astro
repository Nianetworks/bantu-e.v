---
import Base from '../layouts/Base.astro';
import { r } from '../i18n';
---
<Base lang="de" title="Seite nicht gefunden" noindex>
  <section class="section" style="padding-top:8rem">
    <div class="narrow">
      <div class="eyebrow">404</div>
      <h1>Seite nicht gefunden</h1>
      <p class="lead">Diese Seite gibt es nicht (mehr). Vielleicht hilft Ihnen einer dieser Links weiter. <span lang="en">– This page does not exist. Try one of these links.</span></p>
      <div class="btn-row">
        <a class="btn btn--dark" href={r('home', 'de')}>Startseite</a>
        <a class="btn btn--outline" href={r('projects', 'de')}>Projekte</a>
        <a class="btn btn--outline" href={r('home', 'en')}>English</a>
      </div>
    </div>
  </section>
</Base>
