---
import ProductView from '../../views/ProductView.astro';
import { products } from '../../data/shop';
export function getStaticPaths() {
  // Gifts (donations) are listed under the donate page instead (chair, 08.11.2026).
  return products.filter((product) => product.category !== 'gifts').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---
<ProductView lang="de" product={product} />
