---
import Icon from './Icon.astro';
import Phones from './Phones.astro';
import SocialLinks from './SocialLinks.astro';
import { href, r, ui, type Lang } from '../i18n';
import { org } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const de = lang === 'de';
const fr = lang === 'fr';
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Organisation',
    links: [
      [de ? 'Über uns' : fr ? 'À propos' : 'About us', r('about', lang)],
      [de ? 'Menschen' : fr ? 'Équipe' : 'People', r('people', lang)],
      [de ? 'Transparenz' : fr ? 'Transparence' : 'Transparency', r('reports', lang, de ? '#transparenz' : '#transparency')],
      ['Downloads', r('downloads', lang)],
    ],
  },
  {
    title: de ? 'Unsere Arbeit' : fr ? 'Notre travail' : 'Our work',
    links: [
      [de ? 'Inlandsarbeit' : fr ? 'Travail en Allemagne' : 'Work in Germany', r('inland', lang)],
      [de ? 'Internationale Zusammenarbeit' : fr ? 'Coopération internationale' : 'International cooperation', r('international', lang)],
      [de ? 'Programme' : fr ? 'Programmes' : 'Programmes', r('programmes', lang)],
      [de ? 'Wirkung' : fr ? 'Impact' : 'Impact', r('impact', lang)],
      [de ? 'Veranstaltungen' : fr ? 'Événements' : 'Events', r('events', lang)],
    ],
  },
  {
    title: de ? 'Unterstützen' : fr ? 'Soutenir' : 'Support',
    links: [
      [t.donate, r('donate', lang)],
      [de ? 'Mitglied werden' : fr ? 'Devenir membre' : 'Become a member', r('join', lang, '#membership')],
      ['Shop', r('shop', lang)],
      [t.contact, r('contact', lang)],
    ],
  },
];
---
<footer class="site-footer" id="footer" tabindex="-1">
  <div class="footer-rings deco" aria-hidden="true">
    {['#ff343d', '#ff8409', '#3cb04b', '#0071bc', '#ff6c71', '#c180a1', '#749bca', '#b9e245'].map((c) => <span style={`border-color:${c}`}></span>)}
  </div>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img class="keep-color" src={href('/brand/bantu-logo-on-dark.png')} width="120" height="142" alt="Bantu e.V." />
      <p class="footer-motto" lang={lang}>{org.motto[lang]}</p>
      <p>{t.footerAbout}</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2 class="footer-title">{c.title}</h2>
        <ul>{c.links.map(([label, url]) => <li><a href={url}>{label}</a></li>)}</ul>
      </nav>
    ))}
    <div class="footer-contact">
      <h2 class="footer-title footer-contact__h">{t.contact}</h2>
      <address class="footer-contact__grid">
        <span class="addr-block"><Icon name="pin" /><span><strong>{de ? 'Büro' : fr ? 'Bureau' : 'Office'}</strong><br />{org.address.street}<br />{org.address.zip} {org.address.city}</span></span>
        <span class="addr-block"><Icon name="mail" /><span><strong>{de ? 'Postanschrift (für Briefe)' : fr ? 'Adresse postale (courrier)' : 'Postal address (letters)'}</strong><br />{org.shortName}<br />{org.postbox.line}<br />{org.postbox.zip} {org.postbox.city}</span></span>
        <span class="footer-contact__reach">
          <a class="addr-line" href={`mailto:${org.email}`}><Icon name="mail" /> {org.email}</a>
          <Phones lang={lang} variant="footer" />
        </span>
        <span class="footer-social">
          <strong class="footer-social__h">{de ? 'Folgen Sie uns' : fr ? 'Suivez-nous' : 'Follow us'}</strong>
          <SocialLinks lang={lang} variant="dark" />
        </span>
      </address>
    </div>
  </div>
  <div class="wrap footer-a11y">
    <a href={r('accessibility', lang)}><Icon name="access" /> {t.a11y}</a>
    <a href={r('easy', lang)}><Icon name="easy" /> {t.easy}</a>
    <span class="muted-dark">{de ? 'Keine Cookies · kein Tracking' : fr ? 'Pas de cookies · pas de suivi' : 'No cookies · no tracking'}</span>
  </div>
  <div class="wrap footer-bottom">
    <p>© {year} {org.legalName} · {org.register.court}, {org.register.number}</p>
    <p class="footer-legal">
      <a href={r('imprint', lang)}>{de ? 'Impressum' : fr ? 'Mentions légales' : 'Imprint'}</a>
      <a href={r('privacy', lang)}>{de ? 'Datenschutz' : fr ? 'Confidentialité' : 'Privacy'}</a>
    </p>
  </div>
</footer>
<style>
  .site-footer { background: var(--deep); color: var(--on-deep); font-size: 1rem; position: relative; }
  .footer-rings { display: flex; justify-content: center; gap: 12px; padding-top: 2.5rem; }
  .footer-rings span { width: 16px; height: 16px; border-radius: 50%; border: 4px solid; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr)); gap: 2rem 2.25rem; padding-block: 2.5rem 2rem; align-items: start; }
  .footer-grid > * { min-width: 0; }
  .footer-contact { grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,.14); padding-top: 1.75rem; }
  .footer-contact__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem 2rem; align-items: start; }
  .footer-contact__reach { display: grid; gap: .5rem; }
  .footer-social { display: grid; gap: .6rem; }
  .footer-social__h { color: #ffd34d; font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; }
  .addr-block { display: flex; gap: .5rem; align-items: flex-start; line-height: 1.5; }
  .addr-block .icon { width: 1.1em; height: 1.1em; color: #ffd34d; flex-shrink: 0; margin-top: .25em; }
  .addr-block strong { color: #fff; font-weight: 700; }
  .footer-brand img { width: 120px; margin-bottom: 1rem; }
  .footer-brand p { max-width: 40ch; color: var(--on-deep-muted); }
  .footer-brand .footer-motto { font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; line-height: 1.4; color: #ffd34d; margin-bottom: .75rem; }
  address { font-style: normal; display: grid; gap: .35rem; }
  .addr-line { display: inline-flex; gap: .5rem; align-items: center; }
  .addr-line .icon { width: 1.1em; height: 1.1em; color: #ffd34d; }
  .site-footer a { color: var(--on-deep); text-decoration: none; }
  .site-footer a:hover { color: #ffd34d; text-decoration: underline; }
  .footer-title { font-family: var(--font-sans); font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; color: #ffd34d; margin-bottom: .9rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin: 0; }
  li a { display: inline-flex; align-items: center; min-height: 40px; }
  .footer-a11y { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: center; padding-block: 1rem; border-top: 1px solid rgba(255,255,255,.14); }
  .footer-a11y a { display: inline-flex; gap: .45rem; align-items: center; font-weight: 700; min-height: 40px; }
  .muted-dark { color: var(--on-deep-muted); font-size: .9rem; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.14); padding-block: 1.25rem 2.25rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; font-size: .9rem; color: var(--on-deep-muted); }
  .footer-bottom p { margin: 0; }
  .footer-legal { display: flex; flex-wrap: wrap; gap: 1.1rem; }
  @media (max-width: 1100px) { .footer-contact__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-contact__grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
