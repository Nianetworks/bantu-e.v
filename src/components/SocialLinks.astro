---
// Social media links with icons. Visible name for each channel (no icon-only links).
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n';
import { org } from '../data/site';
interface Props { lang: Lang; variant?: 'light' | 'dark' }
const { lang, variant = 'light' } = Astro.props;
---
<ul class={`socials socials--${variant}`} role="list">
  {org.socials.map((s) => (
    <li><a href={s.url} rel="noopener" target="_blank"><Icon name={s.icon as any} /><span>{s.name}</span><span class="sr-only"> {ui[lang].newWindow}</span></a></li>
  ))}
</ul>
<style>
  .socials { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .socials li { margin: 0; }
  .socials a { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; padding: .4rem .85rem .4rem .6rem; border-radius: 999px; border: 1.5px solid currentColor; font-weight: 700; text-decoration: none; }
  .socials a :global(svg) { width: 22px; height: 22px; }
  .socials--light a { color: var(--ink); }
  .socials--light a:hover { background: var(--bg-2); }
  .socials--dark a { color: var(--on-deep); border-color: rgba(255,255,255,.55); }
  .socials--dark a:hover { background: rgba(255,255,255,.12); color: #ffd34d; }
</style>
