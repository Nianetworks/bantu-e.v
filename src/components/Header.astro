---
// Accessible header: utility bar (easy read, accessibility settings, language, contact),
// logo, main navigation with disclosure menus (buttons with aria-expanded; Esc closes;
// works with keyboard, touch and screen readers – no hover-only menus).
import Icon from './Icon.astro';
import { archiveId, archiveLabel, href, langNames, mainNav, projectPath, r, ui, type Lang } from '../i18n';
import { org } from '../data/site';
import { getProjects, slugOf, type Project } from '../lib/content';
import { programmes, regions, regionPath, regionProgrammePath, type Region } from '../data/programmes';
interface Props { lang: Lang; switchLinks: { lang: Lang; href: string; exact: boolean }[] }
const { lang, switchLinks } = Astro.props;
const t = ui[lang];
const de = lang === 'de';
const fr = lang === 'fr';
const nav = mainNav(lang);
const logoAlt = de ? 'Bantu e.V., zur Startseite' : fr ? 'Bantu e.V., page d’accueil' : 'Bantu e.V., home page';
// Mega menus for the two work areas: programme -> CURRENT projects in that area.
// Completed projects are not listed here; one link leads to the archive on the all-projects page.
// A programme stays in the menu (as a category link) when the area has only completed projects in it.
const allProjects = await getProjects(lang);
const bySlug = new Map(allProjects.map((p) => [slugOf(p.id), p]));
const megaFor = (region: Region) => {
  const rg = regions.find((x) => x.key === region)!;
  const groups = programmes
    .map((p) => ({ p, inRegion: p.projects.map((s) => bySlug.get(s)).filter((x): x is Project => !!x && x.data.programme === region) }))
    .map(({ p, inRegion }) => ({
      prog: p,
      href: regionProgrammePath(lang, region, p.key),
      any: inRegion.length > 0,
      items: inRegion.filter((x) => x.data.status !== 'completed'),
      extra: region === 'inland' && p.key === 'education' ? [{ label: de ? 'Bildungsangebote: Workshops und Begleitung' : fr ? 'Ateliers, formations et accompagnement' : 'Workshops, training and support', href: r('offers', lang) }]
        : region === 'inland' && p.key === 'migration' ? [{ label: de ? 'Verfahrensberatung' : fr ? 'Conseil sur les procédures' : 'Procedural advice', href: regionProgrammePath(lang, region, p.key) + (de ? '#beratung' : '#advice') }] : [],
    }))
    .filter((g) => g.any || g.extra.length > 0);
  return { rg, groups };
};
const megas = { inland: megaFor('inland'), international: megaFor('international') };
const shortTitle = (p: Project) => p.data.title.replace(/\s+[–—]\s+/, ': ');
const current = Astro.url.pathname;
const isCurrent = (h: string) => h !== r('home', lang) && current.startsWith(h.split('#')[0]);

// Compact (burger) navigation: used on small screens and – because large text needs more room –
// at wider breakpoints when the visitor has enlarged the text in the accessibility settings.
const compactRules = ['.header-inner { min-height: 72px; }', '.logo-plate { padding: 8px 10px; margin-bottom: -66px; }', '.nav-toggle { display: inline-flex; align-items: center; gap: .55rem; min-height: var(--tap); background: var(--ink); color: var(--bg); border: 0; border-radius: 999px; padding: .55rem 1.1rem; font: 700 1rem var(--font-sans); cursor: pointer; }', '.nav-list { display: none; position: fixed; inset: var(--header-h, 112px) 0 0 0; background: var(--bg); flex-direction: column; align-items: stretch; gap: 0; padding: 5rem var(--gutter) 2.5rem; overflow-y: auto; border-top: 1px solid var(--line); }', '.is-scrolled .nav-list { padding-top: 1rem; }', '.nav-list.is-open { display: flex; }', '.nav-list > li { border-bottom: 1px solid var(--line); }', '.nav-link { width: 100%; justify-content: space-between; font-size: 1.15rem; padding: .85rem .25rem; white-space: normal; }', '.sub { position: static; box-shadow: none; border: 0; padding: 0 0 .75rem .5rem; min-width: 0; background: transparent; }', '.nav-extra { border-bottom: 0 !important; margin: 1.5rem 0 0 !important; }', '.nav-disclosure[aria-expanded="true"] + .mega { display: block; }', '.mega__intro { border-right: 0; padding: 0 0 .75rem; }', '.mega__lead, .mega__places { display: none; }', '.mega__cols { grid-template-columns: 1fr; gap: .75rem; }', '.nav-donate { width: 100%; white-space: normal; }'];
// With enlarged text the eight top-level items (incl. Shop) never fit the 1200 px header, so those levels always use the compact menu.
const levels: [string, number][] = [['', 1279], ['html[data-text="lg"] ', 99999], ['html[data-text="xl"] ', 99999], ['html[data-text="xxl"] ', 99999]];
const compactCss = levels.map(([pre, w]) => `@media (max-width: ${w}px) { ${compactRules.map((rule) => rule.split('{')[0].split(',').map((sel) => pre + sel.trim()).join(', ') + ' {' + rule.split('{').slice(1).join('{')).join(' ')} }`).join('\n');
---
<header class="site-header">
  <div class="utility">
    <div class="wrap utility__inner">
      <a class="util-link" href={r('easy', lang)}><Icon name="easy" /> {t.easy}</a>
      <div class="utility__right">
        <button type="button" class="util-link util-btn" data-a11y-toggle aria-haspopup="dialog" aria-controls="a11y-panel">
          <Icon name="access" /> {t.a11y}
        </button>
        <a class="util-link" href={`mailto:${org.email}`}><Icon name="mail" /> <span class="hide-sm">{org.email}</span><span class="sr-only show-sm">E-Mail</span></a>
        <nav class="langs" aria-label={t.language}>
          <ul>
            {switchLinks.map((s) => (
              <li><a class="lang-link" href={s.href} hreflang={s.lang} lang={s.lang} aria-current={s.lang === lang ? 'true' : undefined}><span aria-hidden="true">{s.lang.toUpperCase()}</span><span class="sr-only">{langNames[s.lang]}</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <div class="wrap header-inner">
    {/* The link gets its name from the visible image's alt text. Only one of the two images is displayed at a time
        (full logo at the top, emblem once the page is scrolled), so both carry the same alt and it is never read twice. */}
    <a class="logo-plate" href={r('home', lang)}>
      <img class="logo-full keep-color" src={href('/brand/bantu-logo.png')} width="120" height="142" alt={logoAlt} />
      <img class="logo-emblem keep-color" src={href('/brand/bantu-emblem.png')} width="52" height="52" alt={logoAlt} />
    </a>
    <nav id="main-nav" class="main-nav" aria-label={de ? 'Hauptmenü' : fr ? 'Menu principal' : 'Main menu'}>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">
        <Icon name="menu" /><span>{t.menu}</span>
      </button>
      <ul id="nav-list" class="nav-list">
        {nav.map((item, i) => (
          <li class={item.mega ? 'has-sub has-mega' : item.children ? 'has-sub' : ''}>
            {item.mega ? (
              <>
                <button type="button" class="nav-link nav-disclosure" aria-expanded="false" aria-controls={`sub-${i}`} data-current={isCurrent(item.href) ? 'true' : undefined}>
                  {item.short ? <><span aria-hidden="true">{item.short}</span><span class="sr-only">{item.label}</span></> : item.label}<Icon name="chevron" class="chev" />
                </button>
                <div class="sub mega" id={`sub-${i}`}>
                  <div class="mega__intro">
                    <a class="mega__overview" href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                      <span class="mega__eyebrow">{de ? 'Überblick' : fr ? 'Vue d’ensemble' : 'Overview'}</span>
                      <strong>{item.label}</strong>
                      <span class="mega__places">{megas[item.mega].rg.places[lang]}</span>
                    </a>
                    <p class="mega__lead">{megas[item.mega].rg.navLead[lang]}</p>
                    <a class="mega__more" href={r('projects', lang)}>{t.allProjects} <Icon name="arrow" /></a>
                    <a class="mega__more mega__archive" href={r('projects', lang, `#${archiveId[lang]}`)}>{archiveLabel[lang]} <Icon name="arrow" /></a>
                  </div>
                  <ul class="mega__cols">
                    {megas[item.mega].groups.map((g) => (
                      <li class={`mega__col accent--${g.prog.accent}`}>
                        <a class="mega__prog" href={g.href} aria-current={current === g.href ? 'page' : undefined}>
                          <span class="mega__no">{de ? 'Programm' : fr ? 'Programme' : 'Programme'} {g.prog.no}</span>
                          {g.prog.title[lang]}
                        </a>
                        {(g.items.length > 0 || g.extra.length > 0) && (
                          <ul>
                            {g.items.map((p) => <li><a href={projectPath(lang, slugOf(p.id))}>{shortTitle(p)}</a></li>)}
                            {g.extra.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : item.children ? (
              <>
                <button type="button" class="nav-link nav-disclosure" aria-expanded="false" aria-controls={`sub-${i}`} data-current={isCurrent(item.href) ? 'true' : undefined}>
                  {item.label}<Icon name="chevron" class="chev" />
                </button>
                <ul class="sub" id={`sub-${i}`}>
                  {item.children.map((c) => <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                </ul>
              </>
            ) : (
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
        <li class="nav-extra">
          <a class="btn btn--gold nav-donate" href={r('donate', lang)}><Icon name="heart" /> {t.donate}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const root = document.documentElement;
  const measure = () => {
    if (!header) return;
    root.style.setProperty('--header-h', `${Math.round(header.getBoundingClientRect().bottom)}px`);
    const util = header.querySelector('.utility');
    if (util) root.style.setProperty('--util-h', `${Math.round(util.getBoundingClientRect().bottom)}px`);
  };
  const onScroll = () => { header?.classList.toggle('is-scrolled', window.scrollY > 80); measure(); };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', measure);
  new MutationObserver(measure).observe(root, { attributes: true, attributeFilter: ['data-text', 'data-font', 'data-spacing'] });
  onScroll();

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const list = document.getElementById('nav-list');
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    list?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

  // Disclosure sub-menus
  const discs = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-disclosure'));
  const closeAll = (except?: HTMLButtonElement) => discs.forEach((d) => { if (d !== except) d.setAttribute('aria-expanded', 'false'); });
  discs.forEach((d) => {
    d.addEventListener('click', () => {
      const open = d.getAttribute('aria-expanded') === 'true';
      closeAll(d);
      d.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.has-sub')) closeAll(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = discs.find((d) => d.getAttribute('aria-expanded') === 'true');
    if (open) { closeAll(); open.focus(); return; }
    if (toggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
  });
  // Close a desktop sub-menu when focus leaves it
  document.querySelectorAll<HTMLElement>('.has-sub').forEach((li) => {
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node) && window.matchMedia('(min-width: 1280px)').matches) {
        li.querySelector('.nav-disclosure')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: saturate(1.2) blur(10px); border-bottom: 1px solid var(--line); }
  .utility { background: var(--deep); color: var(--on-deep); font-size: .9rem; }
  .utility__inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .25rem 1rem; min-height: 40px; }
  .utility__right { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; }
  .util-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--on-deep); text-decoration: none; padding: .35rem .6rem; border-radius: 8px; min-height: 36px; font-weight: 600; }
  .util-link:hover { background: rgba(255,255,255,.12); text-decoration: underline; }
  .util-link .icon { width: 1.15em; height: 1.15em; }
  .util-btn { background: transparent; border: 0; font: 600 .9rem var(--font-sans); cursor: pointer; }
  .util-btn[aria-expanded='true'] { background: var(--gold); color: #000; }
  .langs ul { list-style: none; margin: 0 0 0 .35rem; padding: 0; display: flex; align-items: center; }
  .langs li { margin: 0; display: flex; align-items: center; }
  .langs li + li::before { content: ''; width: 1px; height: 1.1em; background: rgba(255,255,255,.45); }
  .lang-link { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 36px; padding: .3rem .55rem; color: var(--on-deep); font-weight: 700; letter-spacing: .06em; text-decoration: none; border-radius: 8px; }
  .lang-link:hover { background: rgba(255,255,255,.12); text-decoration: underline; }
  .lang-link[aria-current='true'] { color: #ffd34d; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .show-sm { display: none; }

  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 84px; gap: 1rem; position: relative; }
  .logo-plate { align-self: flex-start; background: #fff; padding: 12px 14px 10px; border-radius: 0 0 18px 18px; box-shadow: 0 8px 22px rgba(0,0,0,.10); border: 1px solid var(--line); border-top: 0; margin-bottom: -58px; position: relative; z-index: 3; flex: none; }
  .logo-plate img { width: 120px; height: auto; }
  .logo-emblem { display: none; }
  .is-scrolled .logo-plate { margin-bottom: 0; padding: 6px; border: 0; box-shadow: none; background: transparent; align-self: center; }
  .is-scrolled .logo-full { display: none; }
  .is-scrolled .logo-emblem { display: block; width: 52px; }

  .main-nav { display: flex; align-items: center; }
  .nav-list { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .1rem; }
  .nav-list > li { position: relative; margin: 0; }
  .nav-link { display: inline-flex; align-items: center; gap: .25rem; min-height: var(--tap); padding: .5rem .45rem; white-space: nowrap; text-decoration: none; color: var(--ink); font: 700 1rem var(--font-sans); border-radius: 10px; background: transparent; border: 0; cursor: pointer; }
  .nav-link:hover, .nav-disclosure[aria-expanded='true'] { background: var(--bg-2); }
  .nav-link[aria-current='page'], .nav-disclosure[data-current='true'] { box-shadow: inset 0 -3px 0 var(--gold); }
  .chev { width: 1em; height: 1em; transition: transform .15s; }
  .nav-disclosure[aria-expanded='true'] .chev { transform: rotate(180deg); }
  .sub { list-style: none; margin: 0; padding: .5rem; position: absolute; top: calc(100% + 6px); left: 0; min-width: 270px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); display: none; z-index: 10; }
  .nav-disclosure[aria-expanded='true'] + .sub { display: block; }
  .sub li { margin: 0; }
  .sub a { display: flex; align-items: center; min-height: var(--tap); padding: .5rem .8rem; border-radius: 10px; text-decoration: none; color: var(--ink); font-weight: 600; }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--bg-2); text-decoration: underline; }
  .nav-extra { margin-left: .35rem !important; }
  .nav-donate { white-space: nowrap; }
  .has-mega { position: static !important; }
  .mega { left: 0; right: 0; min-width: 0; padding: 1.25rem; grid-template-columns: minmax(220px, 1fr) 3fr; gap: 1.5rem; }
  .nav-disclosure[aria-expanded='true'] + .mega { display: grid; }
  .mega__intro { display: flex; flex-direction: column; gap: .6rem; padding: .25rem .5rem .25rem .25rem; border-right: 1px solid var(--line); }
  .mega .mega__overview, .mega .mega__prog { align-items: flex-start; text-align: left; text-decoration: none; }
  .mega .mega__prog { hyphens: manual; }
  .mega__overview { display: flex; flex-direction: column; gap: .15rem; padding: .75rem .85rem; border-radius: 12px; background: var(--bg-2); text-decoration: none; color: var(--ink); }
  .mega__overview strong { font: 700 1.25rem/1.2 var(--font-serif); }
  .mega__overview:hover strong { text-decoration: underline; }
  .mega__eyebrow, .mega__no { font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .mega__places { font-size: .9rem; color: var(--ink-2); }
  .mega__lead { margin: 0; font-size: .92rem; color: var(--ink-2); line-height: 1.5; }
  .mega__more { display: inline-flex; align-items: center; gap: .35rem; min-height: var(--tap); font-weight: 700; color: var(--ink); }
  .mega__more svg { width: 1em; height: 1em; }
  .mega__cols { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem 1.25rem; align-content: start; }
  .mega__col { margin: 0; border-top: 4px solid var(--accent, var(--gold)); padding-top: .5rem; }
  .mega__col ul { list-style: none; margin: 0; padding: 0; }
  .mega__col li { margin: 0; }
  .mega__prog { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); font: 700 1.05rem/1.25 var(--font-sans); padding: .35rem .5rem .5rem; border-radius: 8px; min-height: var(--tap); }
  .mega__prog:hover { background: var(--bg-2); text-decoration: underline; }
  .mega .mega__col a:not(.mega__prog) { display: block; min-height: 0; padding: .45rem .5rem; font-weight: 500; font-size: .95rem; line-height: 1.35; border-radius: 8px; color: var(--ink); text-decoration: none; }
  .mega .mega__col a:not(.mega__prog):hover { background: var(--bg-2); text-decoration: underline; }
  .mega__archive { font-weight: 600; color: var(--ink-2); }
  .accent--gold { --accent: var(--gold); } .accent--green { --accent: var(--green); } .accent--blue { --accent: var(--blue); } .accent--red { --accent: var(--c-coral); } .accent--purple { --accent: var(--c-mauve); }
  .nav-toggle { display: none; }

  @media (max-width: 560px) {
    .hide-sm { display: none; }
    .show-sm { display: inline; }
    .util-link { padding: .35rem .45rem; }
  }
  body.nav-open { overflow: hidden; }
  html[data-theme='contrast'] .logo-plate { background: #fff; }
</style>
<style is:global set:html={compactCss}></style>
