---
// Films and photo gallery on a project page (front matter `video` and `gallery`, see src/content.config.ts).
// part="player":   standard film in the large media box at the top of the page (replaces the photo there).
// part="narrated": film with spoken photo descriptions (accessibility version), directly below the standard film;
//                   without a narrated film: the film's photo descriptions as text (from `video.transcript`, a VTT file).
// part="gallery":  photo gallery further down: even 3:2 tiles in themed groups (`section`), a click opens the whole photo in a
//                   modal viewer (prev/next, arrow keys, swipe, Esc; focus returns to the tile). Without JS the tile links to the photo.
// Accessibility: native <video> controls (keyboard operable, global focus outline), no autoplay, preload="none",
// an accessible name per player, caption tracks matching each film, visible link to the narration transcript.
// No download (chair's decision 08.11.2026): no download link, no Download item in the player menu, no right-click save on the film.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Icon from './Icon.astro';
import { href, type Lang } from '../i18n';

type Track = { src: string; srclang: string; label: string; default: boolean };
type Photo = { src: string; thumb: string; width: number; height: number; thumbWidth?: number; thumbHeight?: number; alt: string; caption?: string; section?: string; focus?: string };
type Narrated = { src: string; poster?: string; heading: string; label: string; text: string; link: string; tracks: Track[]; transcript?: string; transcriptLabel?: string };
type Video = { src: string; poster?: string; width: number; height: number; title: string; label: string; duration: string; intro?: string; tracks: Track[]; narrated?: Narrated; transcript?: string };
interface Props { lang: Lang; gallery: Photo[]; video?: Video; id: string; part: 'player' | 'narrated' | 'gallery'; galleryTitle?: string; galleryNote?: string }
const { lang, gallery, video, id, part, galleryTitle, galleryNote } = Astro.props;
const de = lang === 'de';
const fr = lang === 'fr';

// Media URLs get a version query so browsers do not keep an earlier film/poster/caption file that had the same name.
const MEDIA_VERSION = 'r5';
const media = (p: string) => `${href(p)}${p.includes('?') ? '&' : '?'}v=${MEDIA_VERSION}`;
const t = {
  unsupported: de ? 'Ihr Browser kann diesen Film leider nicht abspielen.' : fr ? 'Votre navigateur ne peut malheureusement pas lire ce film.' : 'Sorry, your browser cannot play this film.',
  minutes: de ? 'Min.' : 'min',
  photos: (n: number) => (de ? `${n} Fotos aus dem Austausch` : fr ? `${n} photos de l’échange` : `${n} photos from the exchange`),
  larger: de ? '(Foto groß öffnen)' : fr ? '(ouvrir la photo en grand)' : '(open larger photo)',
  viewer: de ? 'Fotoansicht' : fr ? 'Visionneuse de photos' : 'Photo viewer',
  close: de ? 'Fotoansicht schließen' : fr ? 'Fermer la visionneuse' : 'Close photo viewer',
  prev: de ? 'Vorheriges Foto' : fr ? 'Photo précédente' : 'Previous photo',
  next: de ? 'Nächstes Foto' : fr ? 'Photo suivante' : 'Next photo',
  count: de ? 'Foto {n} von {total}' : fr ? 'Photo {n} sur {total}' : 'Photo {n} of {total}',
};
const narratedId = `${id}-narrated`;
const textId = `${id}-film-text`;
// VTT -> [{ time: 'm:ss', seconds, text }]; cue settings and "[music]"-style notes are dropped.
const cues = (() => {
  if (part !== 'narrated' || !video?.transcript || video.narrated) return [];
  try {
    return readFileSync(join(process.cwd(), 'public', video.transcript), 'utf8').replace(/\r/g, '').split(/\n\n+/).flatMap((block) => {
      const lines = block.split('\n');
      const i = lines.findIndex((l) => l.includes('-->'));
      if (i < 0) return [];
      const [h, m, sec] = lines[i].split('-->')[0].trim().split(':').map(Number);
      const seconds = Math.floor(h * 3600 + m * 60 + sec);
      const text = lines.slice(i + 1).join(' ').replace(/\[[^\]]*\]\s*/g, '').trim();
      return text ? [{ time: `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`, seconds, text }] : [];
    });
  } catch { return []; }
})();
// Gallery: consecutive photos with the same `section` form one group with its own heading.
const groups = gallery.reduce<{ title: string; items: { p: Photo; i: number }[] }[]>((acc, p, i) => {
  const last = acc[acc.length - 1];
  if (last && last.title === (p.section ?? '')) last.items.push({ p, i });
  else acc.push({ title: p.section ?? '', items: [{ p, i }] });
  return acc;
}, []);
// Tiles are 3:2. Photos close to that are cropped slightly (or at `focus`); portraits and very wide group photos are shown whole.
const whole = (p: Photo) => !p.focus && Math.abs(p.width / p.height - 1.5) > 0.12;
const textLabel = de ? 'Bildbeschreibungen zum Film als Text' : fr ? 'Descriptions des photos du film en texte' : 'The film’s photo descriptions as text';
---
{part === 'player' && video && (
  <>
    <video controls controlslist="nodownload" data-nosave preload="none" playsinline width={video.width} height={video.height}
      poster={video.poster ? media(video.poster) : undefined} aria-label={video.label} aria-describedby={`${id}-film-cap`}>
      <source src={media(video.src)} type="video/mp4" />
      {video.tracks.map((tr) => <track kind="captions" src={media(tr.src)} srclang={tr.srclang} label={tr.label} default={tr.default} />)}
      {t.unsupported}
    </video>
    <figcaption id={`${id}-film-cap`} class="media__cap">
      <span class="media__title">{video.title} · {video.duration} {t.minutes}</span>
      {video.intro && <span class="media__intro">{video.intro}</span>}
      <span class="media__actions">
        {video.narrated && <a class="media__a11y" href={`#${narratedId}`}><Icon name="access" size={20} /> <span>{video.narrated.link}</span></a>}
        {!video.narrated && video.transcript && <a class="media__a11y" href={`#${textId}`}><Icon name="text" size={20} /> <span>{textLabel}</span></a>}
      </span>
    </figcaption>
  </>
)}
{part === 'narrated' && video?.narrated && (
  <section class="narrated" id={narratedId} aria-labelledby={`${narratedId}-h`}>
    <h2 id={`${narratedId}-h`}><Icon name="speaker" size={26} /> <span>{video.narrated.heading}</span></h2>
    <p>{video.narrated.text}</p>
    <video controls controlslist="nodownload" data-nosave preload="none" playsinline width={video.width} height={video.height}
      poster={video.narrated.poster ? media(video.narrated.poster) : video.poster ? media(video.poster) : undefined} aria-label={video.narrated.label}>
      <source src={media(video.narrated.src)} type="video/mp4" />
      {video.narrated.tracks.map((tr) => <track kind="captions" src={media(tr.src)} srclang={tr.srclang} label={tr.label} default={tr.default} />)}
      {t.unsupported}
    </video>
    <ul class="narrated__links">
      {video.narrated.transcript && <li><a href={href(video.narrated.transcript)}><Icon name="text" size={18} /> {video.narrated.transcriptLabel}</a></li>}
    </ul>
  </section>
)}
{part === 'narrated' && cues.length > 0 && (
  <details class="media__text" id={textId}>
    <summary>{textLabel} <span class="small muted">({cues.length})</span></summary>
    <ol>
      {cues.map((c) => <li><time datetime={`PT${c.seconds}S`}>{c.time}</time> {c.text}</li>)}
    </ol>
  </details>
)}
{part === 'gallery' && gallery.length > 0 && (
  <section class="media" aria-labelledby={`${id}-photos-h`} data-gallery>
    <h2 id={`${id}-photos-h`}>{galleryTitle ?? t.photos(gallery.length)}</h2>
    {galleryNote && <p class="media__note">{galleryNote}</p>}
    {groups.map((g, gi) => (
      <div class="media__group">
        {g.title && <h3 class="media__group-h" id={`${id}-photos-g${gi + 1}`}>{g.title}</h3>}
        <ul class="media__grid" aria-labelledby={g.title ? `${id}-photos-g${gi + 1}` : undefined}>
          {g.items.map(({ p, i }) => (
            <li>
              <figure>
                <a href={href(p.src)} class:list={['media__tile', { 'is-whole': whole(p) }]} data-index={i} data-w={p.width} data-h={p.height}>
                  {whole(p) && <img class="media__tile-bg" src={href(p.thumb)} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                  <img class="media__tile-img" src={href(p.thumb)} srcset={`${href(p.thumb)} ${p.thumbWidth ?? 480}w, ${href(p.src)} ${p.width}w`}
                    sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 33vw, 50vw" alt={p.alt}
                    width={p.thumbWidth ?? 480} height={p.thumbHeight ?? Math.round((480 * p.height) / p.width)} loading="lazy" decoding="async"
                    style={p.focus ? `object-position: ${p.focus}` : undefined} />
                  <span class="sr-only"> {t.larger}</span>
                </a>
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <dialog class="viewer" data-viewer aria-label={t.viewer} data-count={t.count}>
      <div class="viewer__bar">
        <p class="viewer__count" data-viewer-count></p>
        <button type="button" class="viewer__btn" data-viewer-close aria-label={t.close}><Icon name="close" size={22} /></button>
      </div>
      <figure class="viewer__fig">
        <img data-viewer-img alt="" />
        <figcaption class="viewer__cap" data-viewer-cap aria-live="polite"></figcaption>
      </figure>
      <div class="viewer__nav">
        <button type="button" class="viewer__btn" data-viewer-prev aria-label={t.prev}><Icon name="chevron" size={24} class="viewer__prev-ic" /></button>
        <button type="button" class="viewer__btn" data-viewer-next aria-label={t.next}><Icon name="chevron" size={24} class="viewer__next-ic" /></button>
      </div>
    </dialog>
  </section>
)}
<script>
  // Photo viewer: a native modal <dialog> (focus stays inside, Esc closes); the tile that opened it gets focus back.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gal) => {
    const dlg = gal.querySelector<HTMLDialogElement>('[data-viewer]');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    const tiles = [...gal.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = dlg.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-viewer-cap]')!;
    const count = dlg.querySelector<HTMLElement>('[data-viewer-count]')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const a = tiles[current];
      const thumb = a.querySelector<HTMLImageElement>('.media__tile-img');
      img.src = a.href;
      img.alt = thumb?.alt ?? '';
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      const group = a.closest('.media__group')?.querySelector('.media__group-h')?.textContent?.trim();
      const caption = a.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
      cap.textContent = [caption, group].filter(Boolean).join(' · ');
      count.textContent = (dlg.dataset.count ?? '{n} / {total}').replace('{n}', String(current + 1)).replace('{total}', String(tiles.length));
      new Image().src = tiles[(current + 1) % tiles.length].href; // next photo ready
    };
    tiles.forEach((a, i) => a.addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      opener = a;
      show(i);
      dlg.showModal();
      dlg.querySelector<HTMLButtonElement>('[data-viewer-next]')?.focus();
    }));
    dlg.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(current - 1));
    dlg.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(current + 1));
    dlg.querySelector('[data-viewer-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { opener?.focus(); });
    let startX = 0;
    img.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    img.addEventListener('pointerup', (e) => { const dx = e.clientX - startX; if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1)); });
  });
  // Films are not offered for download: no right-click "Save video as" on the player.
  document.querySelectorAll<HTMLVideoElement>('video[data-nosave]').forEach((v) => v.addEventListener('contextmenu', (e) => e.preventDefault()));
  // "Photo descriptions as text" link under the film: open the collapsed list before jumping to it.
  document.querySelectorAll<HTMLAnchorElement>('.media__cap a[href^="#"]').forEach((a) => {
    a.addEventListener('click', () => {
      const d = document.getElementById(a.hash.slice(1));
      if (d instanceof HTMLDetailsElement) d.open = true;
    });
  });
</script>
<style>
  .media__note { margin: -.25rem 0 1rem; max-width: 65ch; color: var(--muted); font-size: .95rem; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; }
  .media__cap { display: grid; gap: .35rem; padding: .7rem 1rem .5rem; border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: .95rem; }
  .media__title { color: var(--ink); font-weight: 600; }
  .media__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.25rem; }
  .media__actions a { display: inline-flex; align-items: center; gap: .4rem; min-height: var(--tap); }
  .media__actions a.media__a11y { display: inline-block; padding: .55rem 1rem; border: 2px solid currentColor; border-radius: 1.5rem; font-weight: 700; }
  .media__a11y :global(svg) { display: inline-block; vertical-align: -.25em; margin-right: .3rem; }
  /* Long German compounds ("Bildbeschreibungen") must wrap at large text sizes instead of widening the page. */
  .narrated, .media__cap { overflow-wrap: break-word; hyphens: auto; }
  .narrated { margin: 0 0 2rem; padding: 1.25rem 1.25rem 1rem; border: 2px solid var(--line-strong); border-radius: var(--radius); background: var(--gold-soft); scroll-margin-top: 6rem; }
  .narrated h2 { margin: 0 0 .5rem; font-size: clamp(1.25rem, 2.6vw, 1.6rem); }
  .narrated h2 :global(svg) { display: inline-block; vertical-align: -.2em; margin-right: .35rem; }
  .narrated p { margin: 0 0 1rem; }
  .narrated video { border-radius: var(--radius-sm); }
  .narrated__links { list-style: none; padding: 0; margin: .75rem 0 0; display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  .narrated__links a { display: inline-flex; align-items: center; gap: .4rem; min-height: var(--tap); font-weight: 600; }
  .media__text { margin: 0 0 2rem; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: .25rem 1rem; scroll-margin-top: 6rem; overflow-wrap: break-word; hyphens: auto; }
  .media__text summary { cursor: pointer; min-height: var(--tap); display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; font-weight: 600; }
  .media__text ol { margin: .5rem 0 1rem; padding-left: 1.6rem; }
  .media__text li { margin: .35rem 0; }
  .media__text time { font-variant-numeric: tabular-nums; font-weight: 600; margin-right: .35rem; }
  .media { margin: 2.5rem 0 0; }
  .media__group + .media__group { margin-top: 2rem; }
  .media__group-h { margin: 0 0 .75rem; font-size: 1.15rem; }
  .media__grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr)); }
  @media (max-width: 30rem) { .media__grid { gap: 1rem .75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr)); } }
  .media__grid li { margin: 0; }
  .media__grid figure { margin: 0; }
  /* Even tiles: every photo gets the same 3:2 frame. */
  .media__tile { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); }
  .media__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Portraits and very wide group photos: the whole photo, on a soft blurred copy of itself. */
  .media__tile.is-whole .media__tile-img { object-fit: contain; }
  .media__tile-bg { filter: blur(14px) brightness(.7); transform: scale(1.15); }
  .media__tile:hover .media__tile-img { opacity: .9; }
  .media__grid figcaption { margin-top: .45rem; font-size: .95rem; line-height: 1.35; color: var(--muted); }
  .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--deep); color: var(--on-deep); }
  .viewer[open] { display: flex; flex-direction: column; }
  .viewer::backdrop { background: rgb(0 0 0 / .6); }
  .viewer__bar, .viewer__nav { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 1rem; }
  .viewer__nav { justify-content: center; gap: 1.5rem; padding-bottom: 1rem; }
  .viewer__count { margin: 0; font-weight: 600; }
  .viewer__fig { flex: 1 1 auto; min-height: 0; margin: 0; padding: 0 1rem; display: flex; flex-direction: column; align-items: center; gap: .6rem; }
  .viewer__fig img { flex: 1 1 0; min-height: 0; width: 100%; height: auto; object-fit: contain; touch-action: pan-y; }
  .viewer__cap { flex: none; max-width: 60rem; text-align: center; overflow-wrap: break-word; }
  .viewer__btn { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; border: 2px solid currentColor; background: transparent; color: inherit; cursor: pointer; }
  .viewer__btn :global(.viewer__prev-ic) { transform: rotate(90deg); }
  .viewer__btn :global(.viewer__next-ic) { transform: rotate(-90deg); }
</style>
