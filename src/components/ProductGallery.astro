---
import ProductImage from './ProductImage.astro';
import { href, type Lang } from '../i18n';
import type { Product } from '../data/shop';

interface Props { product: Product; lang: Lang }
const { product: p, lang } = Astro.props;
const t = lang === 'de'
  ? { images: 'Produktansichten', bag: 'Verpackung', front: 'Vorderes Etikett', back: 'Hinteres Etikett', showFront: 'Vorderes Etikett zeigen', showBack: 'Hinteres Etikett zeigen', hint: 'Mit dem Pfeil das Etikett umdrehen.' }
  : lang === 'fr'
  ? { images: 'Vues du produit', bag: 'Emballage', front: 'Étiquette avant', back: 'Étiquette arrière', showFront: 'Afficher l’étiquette avant', showBack: 'Afficher l’étiquette arrière', hint: 'Utilisez la flèche pour retourner l’étiquette.' }
  : { images: 'Product images', bag: 'Packaging', front: 'Front label', back: 'Back label', showFront: 'Show front label', showBack: 'Show back label', hint: 'Use the arrow to turn the label.' };
const labels = p.labelImages!.slice(0, 2);
const panelId = `product-gallery-${p.slug}`;
---
<section
  class="product-gallery"
  id={`viewer-${p.slug}`}
  data-product-gallery
  aria-label={`${t.images}: ${p.name[lang]}`}
  data-show-front={t.showFront}
  data-show-back={t.showBack}
  data-bag-caption={p.imageCaption?.[lang] ?? t.bag}
  data-front-caption={t.front}
  data-back-caption={t.back}
>
  <div class="gallery-controls" role="group" aria-label={t.images} data-gallery-controls hidden>
    <button type="button" data-gallery-view="bag" aria-pressed="true" aria-controls={panelId}>{t.bag}</button>
    <button type="button" data-gallery-view="front" aria-pressed="false" aria-controls={panelId}>{t.front}</button>
    <button type="button" data-gallery-view="back" aria-pressed="false" aria-controls={panelId}>{t.back}</button>
  </div>
  <div class="gallery-stage" id={panelId}>
    <div class="gallery-viewport">
      <div class="gallery-bag" data-gallery-bag>
        <ProductImage product={p} lang={lang} variant="detail" />
      </div>
      <div class="gallery-labels" data-gallery-labels data-side="front" hidden>
        <div class="gallery-turn">
          {labels.map((label, index) => (
            <div class:list={['gallery-face', { 'gallery-face--back': index === 1 }]} data-gallery-face={index === 0 ? 'front' : 'back'} aria-hidden={index === 1 ? 'true' : 'false'}>
              <picture>
                <source type="image/webp" srcset={href(label.src.replace(/\.jpe?g$/i, '.webp'))} />
                <img src={href(label.src)} alt={`${p.name[lang]}: ${index === 0 ? t.front : t.back}`} width="1181" height="1654" loading="lazy" decoding="async" />
              </picture>
            </div>
          ))}
        </div>
      </div>
    </div>
    <button class="gallery-next" type="button" data-gallery-next aria-controls={panelId} aria-label={t.showFront} title={t.showFront} hidden>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
  <div class="gallery-footer">
    <p class="gallery-caption" data-gallery-caption aria-live="polite" aria-atomic="true">{p.imageCaption?.[lang] ?? t.bag}</p>
    <p class="gallery-hint" data-gallery-hint hidden>{t.hint}</p>
  </div>
  <noscript>
    {labels.map((label, index) => <figure class="gallery-fallback"><img src={href(label.src)} alt={`${p.name[lang]}: ${index === 0 ? t.front : t.back}`} width="1181" height="1654" loading="lazy" /><figcaption>{index === 0 ? t.front : t.back}</figcaption></figure>)}
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    if (gallery.dataset.ready) return;
    const bag = gallery.querySelector<HTMLElement>('[data-gallery-bag]')!;
    const labels = gallery.querySelector<HTMLElement>('[data-gallery-labels]')!;
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]')!;
    const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]')!;
    const hint = gallery.querySelector<HTMLElement>('[data-gallery-hint]')!;
    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-view]');
    let current: 'bag' | 'front' | 'back' = 'bag';

    const show = (view: typeof current) => {
      current = view;
      bag.hidden = view !== 'bag';
      labels.hidden = view === 'bag';
      if (view !== 'bag') labels.dataset.side = view;
      labels.querySelectorAll<HTMLElement>('[data-gallery-face]').forEach((face) => {
        face.setAttribute('aria-hidden', String(face.dataset.galleryFace !== view));
      });
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.galleryView === view)));
      caption.textContent = gallery.dataset[`${view}Caption`]!;
      const nextLabel = view === 'front' ? gallery.dataset.showBack! : gallery.dataset.showFront!;
      next.setAttribute('aria-label', nextLabel);
      next.title = nextLabel;
      hint.hidden = view === 'bag';
      gallery.dataset.view = view;
    };
    buttons.forEach((button) => button.addEventListener('click', () => show(button.dataset.galleryView as typeof current)));
    next.addEventListener('click', () => show(current === 'front' ? 'back' : 'front'));
    gallery.addEventListener('keydown', (event) => {
      if (!(event.target instanceof HTMLButtonElement)) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      show(current === 'bag' ? (event.key === 'ArrowLeft' ? 'back' : 'front') : current === 'front' ? 'back' : 'front');
    });
    controls.hidden = false;
    next.hidden = false;
    gallery.dataset.ready = 'true';
    show('bag');
  });
</script>

<style>
  .product-gallery { min-width: 0; background: var(--surface); scroll-margin-top: 10rem; }
  .gallery-stage { display: grid; grid-template-columns: minmax(0, 1fr) 3rem; gap: .5rem; height: clamp(24rem, 46vw, 36rem); padding: .75rem; align-items: center; }
  .gallery-viewport { position: relative; min-width: 0; width: 100%; height: 100%; perspective: 1200px; }
  .gallery-bag, .gallery-labels { position: absolute; inset: 0; }
  .gallery-bag :global(.product-image), .gallery-bag :global(picture) { height: 100%; }
  .gallery-bag :global(.product-image__img) { height: 100%; object-fit: contain; }
  .gallery-bag :global(figcaption) { display: none; }
  .gallery-turn { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform .36s ease-in-out; }
  .gallery-labels[data-side="back"] .gallery-turn { transform: rotateY(180deg); }
  .gallery-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .gallery-face--back { transform: rotateY(180deg); }
  .gallery-face picture, .gallery-face img { display: block; width: 100%; height: 100%; }
  .gallery-face img { object-fit: contain; }
  .gallery-next { display: inline-flex; justify-content: center; align-items: center; width: 3rem; min-height: 3rem; padding: .5rem; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--surface); color: var(--ink); cursor: pointer; }
  .gallery-next:hover { background: var(--bg-2); }
  .gallery-next[hidden], .gallery-controls[hidden] { display: none; }
  .gallery-footer { border-top: 1px solid var(--line); padding: .85rem 1rem 1rem; }
  .gallery-caption { margin: 0 0 .7rem; color: var(--muted); font-size: .9rem; }
  .gallery-controls { display: flex; flex-wrap: wrap; gap: .45rem; padding: .85rem 1rem; border-bottom: 1px solid var(--line); }
  .gallery-controls button { min-height: 44px; max-width: 100%; padding: .55rem .85rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink); font: inherit; font-size: .9rem; line-height: 1.4; cursor: pointer; }
  .gallery-controls button[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: var(--bg); }
  .gallery-hint { margin: .75rem 0 0; color: var(--muted); font-size: .85rem; }
  .gallery-fallback { margin: 1rem; }
  .gallery-fallback img { display: block; width: 100%; height: auto; }
  @media (max-width: 820px) { .gallery-stage { height: min(125vw, 36rem); } }
  @media (prefers-reduced-motion: reduce) { .gallery-turn { transition: none; } }
  :global(html[data-motion="reduce"]) .gallery-turn { transition: none; }
</style>
