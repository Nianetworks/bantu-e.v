RewriteRule ^projekte/zerebralparese-ediri-pilotprojekt/?$ /projekte/p23-91-ours-zerebralparese/ [R=301,L,NE]
RewriteRule ^fr/projets/paralysie-cerebrale-projet-pilote-ediri/?$ /fr/projets/p23-91-ours-zerebralparese/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-jahresbericht-2020-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparenzbericht-2020-de\.pdf/?$ /berichte/ [R=301,L,NE]
