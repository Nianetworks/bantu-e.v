RewriteRule ^en/programmes/work-in-germany/?$ /en/work-in-germany/ [R=301,L,NE]
RewriteRule ^programme/internationale-zusammenarbeit/?$ /auslandsarbeit/ [R=301,L,NE]
RewriteRule ^en/programmes/international-cooperation/?$ /en/international-cooperation/ [R=301,L,NE]
RewriteRule ^de/?$ / [R=301,L,NE]
RewriteRule ^de/home-de/?$ / [R=301,L,NE]
RewriteRule ^de/uber-bantu/?$ /ueber-uns/ [R=301,L,NE]
RewriteRule ^de/uber-bantu/unser-name/?$ /ueber-uns/\#name [R=301,L,NE]
RewriteRule ^de/uber-bantu/unsere-geschichte/?$ /ueber-uns/\#geschichte [R=301,L,NE]
RewriteRule ^de/uber-bantu/vision-mission-ziele-verte/?$ /ueber-uns/\#mission [R=301,L,NE]
RewriteRule ^de/uber-bantu/struktur-und-menschen/?$ /menschen/ [R=301,L,NE]
RewriteRule ^de/uber-bantu/partnerinnen/?$ /menschen/\#partner [R=301,L,NE]
