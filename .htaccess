RewriteRule ^de/spenden/?$ /spenden/ [R=301,L,NE]
RewriteRule ^aktuelles/ubuntu-talks-15-11-2026/?$ /aktuelles/ubuntu-talks-22-11-2026/ [R=301,L,NE]
RewriteRule ^en/news/ubuntu-talks-15-11-2026/?$ /en/news/ubuntu-talks-22-11-2026/ [R=301,L,NE]
RewriteRule ^fr/actualites/ubuntu-talks-15-11-2026/?$ /fr/actualites/ubuntu-talks-22-11-2026/ [R=301,L,NE]
RewriteRule ^shop/geschenk-pearl-kita/?$ /spenden/geschenk-pearl-kita/ [R=301,L,NE]
RewriteRule ^shop/geschenk-wasser-ruziba/?$ /spenden/geschenk-wasser-ruziba/ [R=301,L,NE]
RewriteRule ^shop/geschenk-bildung/?$ /spenden/geschenk-bildung/ [R=301,L,NE]
RewriteRule ^en/shop/geschenk-pearl-kita/?$ /en/donate/geschenk-pearl-kita/ [R=301,L,NE]
RewriteRule ^en/shop/geschenk-wasser-ruziba/?$ /en/donate/geschenk-wasser-ruziba/ [R=301,L,NE]
RewriteRule ^en/shop/geschenk-bildung/?$ /en/donate/geschenk-bildung/ [R=301,L,NE]
RewriteRule ^fr/boutique/geschenk-pearl-kita/?$ /fr/faire-un-don/geschenk-pearl-kita/ [R=301,L,NE]
RewriteRule ^fr/boutique/geschenk-wasser-ruziba/?$ /fr/faire-un-don/geschenk-wasser-ruziba/ [R=301,L,NE]
RewriteRule ^fr/boutique/geschenk-bildung/?$ /fr/faire-un-don/geschenk-bildung/ [R=301,L,NE]
RewriteRule ^downloads/flyer/ubuntu-talks-15-11-2026-flyer\.pdf/?$ /aktuelles/ubuntu-talks-22-11-2026/ [R=301,L,NE]
RewriteRule ^aktuelles/rss\.xml/?$ /aktuelles/ [R=301,L,NE]
RewriteRule ^en/news/rss\.xml/?$ /en/news/ [R=301,L,NE]
