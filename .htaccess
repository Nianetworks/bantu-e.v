# Generated by scripts/postbuild-base-path.mjs – do not edit on the server.
# Bantu e.V. static website (Astro). Source: https://github.com/Nianetworks/bantu-e.v
Options -Indexes -MultiViews
ServerSignature Off
FileETag None
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4
AddType text/vtt .vtt

<IfModule mod_rewrite.c>
RewriteEngine On
# Certificate validation (AutoSSL / Let's Encrypt) and security.txt must stay reachable
RewriteRule ^\.well-known/ - [L]
# The two exceptions (shop order form, chair 08.11.2026; sponsorship form, chair 09.11.2026): POST over HTTPS to exactly
# these files. Any other method on them falls through to the 405/404 rules below; no other script can run.
RewriteCond %{REQUEST_METHOD} =POST
RewriteCond %{HTTPS} =on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteRule ^shop/bestellung\.php$ - [END]
RewriteCond %{REQUEST_METHOD} =POST
RewriteCond %{HTTPS} =on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteRule ^mitmachen/patenschaft\.php$ - [END]
# Self-defence: otherwise this is a static site, so only reading is allowed (no uploads, no form posts to this server)
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
RewriteRule ^ - [R=405,L]
# Never serve hidden files, backups, sources or config files
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteRule \.(bak|old|orig|save|swp|sql|sqlite|db|env|ini|log|sh|py|php[0-9]?|phtml|cgi|pl|asp|aspx|jsp|ya?ml|toml|lock|git)(/|$) - [R=404,L,NC]
# Typical attack probes (admin panels, shells, path traversal)
RewriteRule (^|/)(phpmyadmin|pma|myadmin|adminer|cgi-bin|vendor|node_modules|\.git|\.svn|\.env|server-status|server-info)(/|$) - [R=404,L,NC]
RewriteCond %{QUERY_STRING} (\.\./|%2e%2e|<script|%3Cscript|union.*select|base64_encode|GLOBALS=|_REQUEST=|/etc/passwd) [NC]
RewriteRule ^ - [R=403,L]
# Canonical address: https://www.bantu-ev.org
RewriteCond %{HTTP_HOST} ^bantu-ev\.org$ [NC]
RewriteRule ^ https://www.bantu-ev.org%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^www\.bantu-ev\.org$ [NC]
RewriteRule ^ https://www.bantu-ev.org%{REQUEST_URI} [R=301,L,NE]
# Old WordPress addresses -> new pages
RewriteRule ^about-bantu/?$ /en/about/ [R=301,L,NE]
RewriteRule ^our-name/?$ /en/about/\#name [R=301,L,NE]
RewriteRule ^our-story/?$ /en/about/\#story [R=301,L,NE]
RewriteRule ^our-vision-mission-and-values/?$ /en/about/\#mission [R=301,L,NE]
RewriteRule ^structure-and-people/?$ /en/people/ [R=301,L,NE]
RewriteRule ^board/?$ /en/people/ [R=301,L,NE]
RewriteRule ^team/?$ /en/people/ [R=301,L,NE]
RewriteRule ^our-volunteers/?$ /en/people/ [R=301,L,NE]
RewriteRule ^allies-and-partners/?$ /en/people/\#partners [R=301,L,NE]
RewriteRule ^join-us/?$ /en/get-involved/ [R=301,L,NE]
RewriteRule ^membership/?$ /en/get-involved/\#membership [R=301,L,NE]
