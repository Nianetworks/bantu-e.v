RewriteRule ^downloads/berichte/bantu-ev-transparency-report-2020-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-jahresbericht-2021-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparenzbericht-2021-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-annual-report-2021-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparency-report-2021-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-jahresbericht-2022-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparenzbericht-2022-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-annual-report-2022-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparency-report-2022-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-jahresbericht-2023-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparenzbericht-2023-de\.pdf/?$ /berichte/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-annual-report-2023-en\.pdf/?$ /en/reports/ [R=301,L,NE]
RewriteRule ^downloads/berichte/bantu-ev-transparency-report-2023-en\.pdf/?$ /en/reports/ [R=301,L,NE]
